---
import type { CollectionEntry } from "astro:content";
import "../styles/journal.css";
import BlogCard from "./blog/BlogCard.astro";
import { blogCategories, categoryHref, type BlogCategory } from "../lib/blog";
interface Props {
  posts: CollectionEntry<"blog">[];
  currentPage: number;
  lastPage: number;
  category?: BlogCategory;
}
const { posts, currentPage, lastPage, category } = Astro.props;
const featured = !category && currentPage === 1 ? posts[0] : undefined;
const list = featured ? posts.slice(1) : posts;
---

<main class="journal-container journal-index">
  <header class="journal-masthead">
    <h1>
      The Compliance Journal<span class="sr-only"
        >{category ? `: ${category}` : ""}{
          currentPage > 1 ? `, page ${currentPage}` : ""
        }</span
      >
    </h1>
    <p>
      Practical guides and perspectives on compliance, security, and building
      trust.
    </p>
    <nav aria-label="Article categories" class="journal-filters">
      {
        [undefined, ...blogCategories].map((item) => (
          <a
            href={categoryHref(item)}
            aria-current={item === category ? "page" : undefined}
          >
            {item ?? "All"}
          </a>
        ))
      }
    </nav>
  </header>
  {featured && <BlogCard post={featured} featured />}
  <div
    class:list={["journal-catalogue", featured && "journal-catalogue-featured"]}
  >
    <div class="journal-grid">
      {list.map((post) => <BlogCard post={post} />)}
    </div>
    {
      lastPage > 1 && (
        <nav aria-label="Journal pagination" class="journal-pagination">
          {currentPage > 1 && (
            <a
              href={categoryHref(category, currentPage - 1)}
              rel="prev"
              aria-label="Previous page"
            >
              <img src="/blog/icons/back.svg" alt="" width="16" height="16" />
            </a>
          )}
          {Array.from({ length: lastPage }, (_, i) => i + 1).map((page) => (
            <a
              href={categoryHref(category, page)}
              aria-label={`Page ${page}`}
              aria-current={page === currentPage ? "page" : undefined}
            >
              {page}
            </a>
          ))}
          {currentPage < lastPage && (
            <a
              href={categoryHref(category, currentPage + 1)}
              rel="next"
              aria-label="Next page"
            >
              <img src="/blog/icons/right.svg" alt="" width="16" height="16" />
            </a>
          )}
        </nav>
      )
    }
  </div>
</main>
