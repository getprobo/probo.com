<script>
  const initMotionStudies = () => {
    const stages = Array.from(
      document.querySelectorAll<HTMLElement>("[data-motion-stage]"),
    );
    if (!stages.length || stages.every((stage) => stage.dataset.motionReady))
      return;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    const events = new AbortController();
    let paused = false;
    const visible = new Set<HTMLElement>();
    const update = () => {
      stages.forEach((stage) =>
        stage.toggleAttribute(
          "data-motion-playing",
          visible.has(stage) && !paused && !document.hidden && !reduced.matches,
        ),
      );
      document
        .querySelectorAll<HTMLButtonElement>("[data-motion-pause]")
        .forEach((button) => {
          button.disabled = reduced.matches;
          button.setAttribute("aria-pressed", String(paused));
          button.textContent = paused ? "Reprendre" : "Mettre en pause";
        });
      document
        .querySelectorAll<HTMLButtonElement>(
          "[data-motion-replay], [data-motion-replay-all]",
        )
        .forEach((button) => (button.disabled = reduced.matches));
      document
        .querySelectorAll<HTMLElement>("[data-motion-preference]")
        .forEach((label) => {
          label.textContent = reduced.matches
            ? "Mouvement réduit activé : les essais restent au repos."
            : "Une impulsion, puis une longue pause. Les essais s’arrêtent hors écran.";
        });
    };
    const replay = (targets: HTMLElement[], part = "all") => {
      paused = false;
      targets.forEach((stage) => {
        stage.dataset.motionPart = ["badge", "halo"].includes(part)
          ? part
          : "all";
        stage.getAnimations({ subtree: true }).forEach((animation) => {
          if (
            animation instanceof CSSAnimation &&
            animation.animationName.startsWith("pricing-study-")
          )
            animation.currentTime = 0;
        });
      });
      update();
    };
    const watched = new Map<Element, HTMLElement>();
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const stage = watched.get(entry.target);
          if (!stage) return;
          if (entry.isIntersecting) visible.add(stage);
          else visible.delete(stage);
        });
        update();
      },
      { threshold: 0.1 },
    );
    stages.forEach((stage) => {
      stage.dataset.motionReady = "true";
      const target = stage.querySelector("[data-motion-watch]") || stage;
      watched.set(target, stage);
      observer.observe(target);
    });
    document
      .querySelectorAll<HTMLButtonElement>("[data-motion-replay]")
      .forEach((button) => {
        button.addEventListener(
          "click",
          () => {
            const target = stages.find(
              (stage) => stage.id === button.dataset.motionReplay,
            );
            if (target) replay([target], button.dataset.motionReplayPart);
          },
          { signal: events.signal },
        );
      });
    document
      .querySelectorAll<HTMLButtonElement>("[data-motion-replay-all]")
      .forEach((button) =>
        button.addEventListener(
          "click",
          () => replay(stages, button.dataset.motionReplayPart),
          {
            signal: events.signal,
          },
        ),
      );
    document
      .querySelectorAll<HTMLButtonElement>("[data-motion-pause]")
      .forEach((button) =>
        button.addEventListener(
          "click",
          () => {
            paused = !paused;
            update();
          },
          { signal: events.signal },
        ),
      );
    reduced.addEventListener("change", update, { signal: events.signal });
    document.addEventListener("visibilitychange", update, {
      signal: events.signal,
    });
    document.addEventListener(
      "astro:before-swap",
      () => {
        observer.disconnect();
        events.abort();
      },
      { once: true },
    );
    update();
  };
  initMotionStudies();
  document.addEventListener("astro:page-load", initMotionStudies);
</script>

