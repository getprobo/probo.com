---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import AntoinePortrait from "../../assets/about/antoine-bourchardy.png";
import ArthurPortrait from "../../assets/about/arthur-mayoux.jpeg";
import BryanPortrait from "../../assets/about/bryan-frimin.png";
import EmilePortrait from "../../assets/about/emile-re.jpeg";

interface Props {
  author: string;
  size?: "small" | "medium" | "large";
  loading?: "eager" | "lazy";
}

const { author, size = "small", loading = "lazy" } = Astro.props;
const portraits: Record<string, ImageMetadata> = {
  "Antoine Bouchardy": AntoinePortrait,
  "Arthur Mayoux": ArthurPortrait,
  "Bryan Frimin": BryanPortrait,
  "Émile Ré": EmilePortrait,
};
const portrait = portraits[author];
const imageSize = author === "Bryan Frimin" ? 448 : 112;
---

{
  portrait && (
    <span
      aria-hidden="true"
      class:list={[
        "bg-highlight relative inline-flex shrink-0 overflow-hidden rounded-full",
        size === "small" && "size-7",
        size === "medium" && "size-8",
        size === "large" && "size-14",
      ]}
    >
      <Image
        src={portrait}
        alt=""
        width={imageSize}
        height={imageSize}
        densities={author === "Bryan Frimin" ? [1] : [1, 2]}
        loading={loading}
        decoding="async"
        class:list={[
          "portrait",
          author === "Bryan Frimin" && "portrait--bryan",
        ]}
      />
    </span>
  )
}

<style>
  .portrait {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .portrait--bryan {
    position: absolute;
    top: 0;
    left: -150%;
    width: 400%;
    height: 400%;
    max-width: none;
  }
</style>
