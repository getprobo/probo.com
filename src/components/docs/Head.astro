---
import { ClientRouter } from "astro:transitions";
import PostHog from "../posthog.astro";

const { head, entry, siteTitle, lastUpdated } = Astro.locals.starlightRoute;
const pathname = Astro.url.pathname.replace(/\.html$/, "").replace(/\/+$/, "");
const markdownAlternate = pathname ? `${pathname}.md` : "/index.md";
const seoTitle =
  head.find(({ tag }) => tag === "title")?.content ??
  `${entry.data.title} | ${siteTitle}`;
const description = entry.data.description;
const pageUrl = `https://www.probo.com${pathname || "/docs"}`;
const isDocsHome = pathname === "/docs";
const docsSchema = {
  "@context": "https://schema.org",
  "@type": isDocsHome ? "WebPage" : "TechArticle",
  ...(isDocsHome
    ? { name: "Probo Docs", alternateName: "Probo Documentation" }
    : { headline: entry.data.title }),
  ...(description && { description }),
  url: pageUrl,
  inLanguage: "en",
  ...(lastUpdated && { dateModified: lastUpdated.toISOString() }),
  isPartOf: {
    "@type": "WebSite",
    name: "Probo Docs",
    url: "https://www.probo.com/docs",
  },
  publisher: {
    "@type": "Organization",
    "@id": "https://www.probo.com/#organization",
    name: "Probo",
    url: "https://www.probo.com",
    logo: "https://www.probo.com/probo-logo.svg",
    sameAs: [
      "https://github.com/getprobo/probo",
      "https://www.linkedin.com/company/getprobo",
      "https://twitter.com/getprobo",
      "https://www.ycombinator.com/companies/probo",
    ],
  },
};
---

{
  head.map(({ tag: Tag, attrs, content }) => (
    <Tag {...attrs} set:html={content} />
  ))
}
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta property="og:image" content="https://www.probo.com/og.png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={entry.data.title} />
<meta name="twitter:site" content="@getprobo" />
<meta name="twitter:creator" content="@getprobo" />
<meta name="twitter:title" content={seoTitle} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content="https://www.probo.com/og.png" />
<link
  href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap"
  rel="stylesheet"
/>
<script type="application/ld+json" set:html={JSON.stringify(docsSchema)} />
<link rel="alternate" type="text/markdown" href={markdownAlternate} />
<link rel="alternate" type="text/plain" href="/llms.txt" title="LLMs index" />
<link
  rel="alternate"
  type="text/plain"
  href="/llms-docs.txt"
  title="Documentation LLMs index"
/>

<script>
  import { registerCookieBanner } from "@probo/cookie-banner";
  registerCookieBanner();
</script>
<ClientRouter />
<PostHog />
