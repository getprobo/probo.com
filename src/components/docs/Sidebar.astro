---
import MobileMenuFooter from "virtual:starlight/components/MobileMenuFooter";
import SidebarSublist from "@astrojs/starlight/components/SidebarSublist.astro";
import Icon from "../Icon.astro";
import {
  getDocsSection,
  getDocsSectionForPath,
  getSidebarGroupsForSection,
} from "../../lib/docs-navigation";

const sectionId = getDocsSectionForPath(Astro.url.pathname);
const section = getDocsSection(sectionId);
const sidebarGroups = getSidebarGroupsForSection(
  Astro.locals.starlightRoute.sidebar,
  sectionId,
);
type Entry = (typeof Astro.locals.starlightRoute.sidebar)[number];
const hasCurrent = (entries: Entry[]): boolean =>
  entries.some((entry) =>
    entry.type === "link" ? entry.isCurrent : hasCurrent(entry.entries),
  );
---

<div class="docs-sidebar-heading">{section.label}</div>
{
  sidebarGroups.map(({ group, showHeading }) =>
    showHeading ? (
      <details class="sidebar-section" open={hasCurrent(group.entries)}>
        <summary class="sidebar-section-title">
          <span>{group.label}</span>
          <Icon name="caret-right" size={14} />
        </summary>
        <div class="sidebar-section-links">
          <SidebarSublist sublist={group.entries} nested />
        </div>
      </details>
    ) : (
      <div class="sidebar-section sidebar-section--plain">
        <SidebarSublist sublist={group.entries} nested />
      </div>
    ),
  )
}
<div class="lg:hidden"><MobileMenuFooter /></div>

<script>
  const revealCurrentPage = () => {
    const sidebar = document.getElementById("starlight__sidebar");
    const active = sidebar?.querySelector<HTMLElement>('[aria-current="page"]');
    if (!sidebar || !active) return;
    let parent = active.parentElement;
    while (parent && parent !== sidebar) {
      if (parent instanceof HTMLDetailsElement) parent.open = true;
      parent = parent.parentElement;
    }
    requestAnimationFrame(() => {
      if (!sidebar.isConnected) return;
      const parentRect = sidebar.getBoundingClientRect();
      const linkRect = active.getBoundingClientRect();
      if (
        linkRect.top < parentRect.top ||
        linkRect.bottom > parentRect.bottom
      ) {
        sidebar.scrollTop +=
          linkRect.top - parentRect.top - parentRect.height / 3;
      }
    });
  };
  document.addEventListener("astro:page-load", revealCurrentPage);
  revealCurrentPage();
</script>

<style>
  .docs-sidebar-heading {
    padding: 0.3rem 0.625rem 0.85rem;
    color: var(--color-tertiary-foreground);
    font-size: 0.6875rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .sidebar-section + .sidebar-section {
    margin-top: 0.4rem;
  }
  .sidebar-section-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.65rem 0.625rem;
    border-radius: 0.375rem;
    color: var(--color-primary);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.35;
    list-style: none;
    cursor: pointer;
  }
  .sidebar-section-title::-webkit-details-marker {
    display: none;
  }
  .sidebar-section-title:hover {
    background: var(--color-subtle);
  }
  .sidebar-section-title :global(svg) {
    flex: 0 0 auto;
    color: var(--color-tertiary-foreground);
    transition: transform 160ms ease;
  }
  details[open] > .sidebar-section-title :global(svg) {
    transform: rotate(90deg);
  }
  .sidebar-section-title:focus-visible {
    outline: 2px solid var(--docs-focus);
    outline-offset: 2px;
  }
  .sidebar-section-links {
    padding-bottom: 0.5rem;
  }
  .sidebar-section-links :global(ul) {
    margin: 0;
  }
  .sidebar-section :global(a) {
    margin-block: 0.1rem;
    border-radius: 0.375rem;
    padding: 0.45rem 0.625rem;
    color: var(--color-muted-foreground);
    font-size: 0.8125rem;
    line-height: 1.45;
  }
  .sidebar-section :global(a:hover) {
    color: var(--color-primary);
    background: var(--color-subtle);
  }
  .sidebar-section :global(a[aria-current="page"]) {
    color: var(--color-primary);
    background: var(--docs-accent-soft);
    font-weight: 600;
  }
  .sidebar-section :global(a:focus-visible),
  .sidebar-section :global(summary:focus-visible) {
    outline: 2px solid var(--docs-focus);
    outline-offset: 1px;
  }
  .sidebar-section-links :global(summary) {
    padding: 0.5rem 0.625rem;
    color: var(--color-muted-foreground);
  }
  .sidebar-section-links :global(summary .large) {
    color: inherit;
    font-size: 0.8125rem;
    font-weight: 500;
  }
  @media (prefers-reduced-motion: reduce) {
    .sidebar-section-title :global(svg) {
      transition: none;
    }
  }
</style>
