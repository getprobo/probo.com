---
import MobileMenuFooter from "virtual:starlight/components/MobileMenuFooter";
import SidebarSublist from "./SidebarSublist.astro";
import Icon from "../Icon.astro";
import SectionNav from "./SectionNav.astro";
import {
  getDocsSectionForPath,
  getSidebarGroupsForSection,
} from "../../lib/docs-navigation";

const sectionId = getDocsSectionForPath(Astro.url.pathname);
const hasCookieBanner = Boolean(
  import.meta.env.PUBLIC_COOKIE_BANNER_ID &&
  import.meta.env.PUBLIC_COOKIE_BANNER_API_BASE_URL,
);
const sidebarGroups = getSidebarGroupsForSection(
  Astro.locals.starlightRoute.sidebar,
  sectionId,
);
type Entry = (typeof Astro.locals.starlightRoute.sidebar)[number];
const hasCurrent = (entries: Entry[]): boolean =>
  entries.some((entry) =>
    entry.type === "link" ? entry.isCurrent : hasCurrent(entry.entries),
  );
---

<div class="docs-sidebar-scroll">
  {
    sidebarGroups.map(({ group, definition, showHeading }) =>
      showHeading ? (
        <details class="sidebar-section" open={hasCurrent(group.entries)}>
          <summary class="sidebar-section-title">
            <span class="sidebar-section-label">
              <>
                <Icon
                  name={definition.icon ?? "article"}
                  size={16}
                  class="docs-nav-icon"
                />
                <span>{group.label}</span>
              </>
            </span>
            <Icon name="caret-right" size={14} class="caret" />
          </summary>
          <div class="sidebar-section-links">
            <SidebarSublist sublist={group.entries} items={definition.items} />
          </div>
        </details>
      ) : (
        <div class="sidebar-section sidebar-section--plain">
          <SidebarSublist sublist={group.entries} items={definition.items} />
        </div>
      ),
    )
  }
</div>
<div class="docs-sidebar-footer">
  <SectionNav placement="sidebar" />
  <div class="lg:hidden"><MobileMenuFooter /></div>
  {
    hasCookieBanner && (
      <probo-settings-link class="cookie-settings">
        <span>Cookie settings</span>
      </probo-settings-link>
    )
  }
</div>

<script>
  const revealCurrentPage = () => {
    const sidebar = document.querySelector<HTMLElement>(".docs-sidebar-scroll");
    const active = sidebar?.querySelector<HTMLElement>('[aria-current="page"]');
    if (!sidebar || !active) return;
    let parent = active.parentElement;
    while (parent && parent !== sidebar) {
      if (parent instanceof HTMLDetailsElement) parent.open = true;
      parent = parent.parentElement;
    }
    requestAnimationFrame(() => {
      if (!sidebar.isConnected) return;
      const parentRect = sidebar.getBoundingClientRect();
      const linkRect = active.getBoundingClientRect();
      if (
        linkRect.top < parentRect.top ||
        linkRect.bottom > parentRect.bottom
      ) {
        sidebar.scrollTop +=
          linkRect.top - parentRect.top - parentRect.height / 3;
      }
    });
  };
  document.addEventListener("astro:page-load", revealCurrentPage);
  revealCurrentPage();
</script>

<style>
  .cookie-settings {
    box-sizing: border-box;
    width: 100%;
    min-height: 2rem;
    margin-block-start: 0.375rem;
    padding-block: 0.375rem;
    flex-wrap: wrap;
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--color-muted-foreground);
    text-align: start;
  }
  .cookie-settings :global(> span) {
    flex-shrink: 0;
    overflow-wrap: normal;
  }
  .cookie-settings :global([data-probo-gpc]) {
    flex-basis: 100%;
    max-width: 100%;
    white-space: normal !important;
  }
  .cookie-settings:hover {
    color: var(--color-primary);
  }
  .cookie-settings:focus-visible {
    border-radius: 0.25rem;
    outline: 2px solid var(--docs-focus);
    outline-offset: 3px;
  }
  .sidebar-section-title::-webkit-details-marker {
    display: none;
  }
  .sidebar-section-title :global(.caret) {
    flex: 0 0 auto;
    color: var(--color-tertiary-foreground);
  }
  details[open] > .sidebar-section-title :global(.caret) {
    transform: rotate(90deg);
  }
  .sidebar-section-links :global(ul) {
    margin: 0;
  }
</style>
