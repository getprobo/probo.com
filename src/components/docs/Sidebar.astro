---
import MobileMenuFooter from "virtual:starlight/components/MobileMenuFooter";
import SidebarSublist from "./SidebarSublist.astro";
import Icon from "../Icon.astro";
import SectionNav from "./SectionNav.astro";
import {
  getDocsSectionForPath,
  getSidebarGroupsForSection,
} from "../../lib/docs-navigation";

const currentSection = getDocsSectionForPath(Astro.url.pathname);
const sectionId = currentSection === "overview" ? "product" : currentSection;
const sidebarGroups = getSidebarGroupsForSection(
  Astro.locals.starlightRoute.sidebar,
  sectionId,
);
type Entry = (typeof Astro.locals.starlightRoute.sidebar)[number];
const hasCurrent = (entries: Entry[]): boolean =>
  entries.some((entry) =>
    entry.type === "link" ? entry.isCurrent : hasCurrent(entry.entries),
  );
---

<div class="docs-sidebar-scroll" data-docs-section={sectionId}>
  {
    sidebarGroups.map(({ group, definition, showHeading }) =>
      showHeading ? (
        <details
          class="sidebar-section"
          data-sidebar-key={definition.id}
          open={hasCurrent(group.entries)}
        >
          <summary class="sidebar-section-title">
            <span class="sidebar-section-label">
              <>
                <Icon
                  name={definition.icon ?? "article"}
                  size={16}
                  class="docs-nav-icon"
                />
                <span>{group.label}</span>
              </>
            </span>
            <Icon name="caret-right" size={14} class="caret" />
          </summary>
          <div class="sidebar-section-links">
            <SidebarSublist
              sublist={group.entries}
              items={definition.items}
              statePath={definition.id}
            />
          </div>
        </details>
      ) : (
        <div class="sidebar-section sidebar-section--plain">
          <SidebarSublist
            sublist={group.entries}
            items={definition.items}
            statePath={definition.id}
          />
        </div>
      ),
    )
  }
</div>
<div class="docs-sidebar-footer">
  <SectionNav placement="sidebar" />
  <div class="lg:hidden"><MobileMenuFooter /></div>
</div>

<script>
  import type { TransitionBeforeSwapEvent } from "astro:transitions/client";

  const sidebarStates = new Map<
    string,
    { scroll: number; open: Map<string, boolean> }
  >();
  let restoredScroll: number | undefined;

  const revealCurrentPage = () => {
    const sidebar = document.querySelector<HTMLElement>(".docs-sidebar-scroll");
    if (!sidebar) return;
    if (restoredScroll !== undefined) {
      sidebar.scrollTop = restoredScroll;
      restoredScroll = undefined;
    }
    const active = sidebar.querySelector<HTMLElement>('[aria-current="page"]');
    if (!active) return;
    let parent = active.parentElement;
    while (parent && parent !== sidebar) {
      if (parent instanceof HTMLDetailsElement) parent.open = true;
      parent = parent.parentElement;
    }
    const parentRect = sidebar.getBoundingClientRect();
    const linkRect = active.getBoundingClientRect();
    if (linkRect.top < parentRect.top || linkRect.bottom > parentRect.bottom) {
      sidebar.scrollTop +=
        linkRect.top - parentRect.top - parentRect.height / 3;
    }
  };

  document.addEventListener("astro:before-swap", (event) => {
    const sidebar = document.querySelector<HTMLElement>(".docs-sidebar-scroll");
    const section = sidebar?.dataset.docsSection;
    if (sidebar && section) {
      sidebarStates.set(section, {
        scroll: sidebar.scrollTop,
        open: new Map(
          Array.from(
            sidebar.querySelectorAll<HTMLDetailsElement>(
              "details[data-sidebar-key]",
            ),
            (details) => [details.dataset.sidebarKey!, details.open] as const,
          ),
        ),
      });
    }
    const incoming = (event as TransitionBeforeSwapEvent).newDocument;
    const nextSidebar = incoming.querySelector<HTMLElement>(
      ".docs-sidebar-scroll",
    );
    const state = sidebarStates.get(nextSidebar?.dataset.docsSection ?? "");
    restoredScroll = state?.scroll;
    if (!nextSidebar) return;
    for (const details of nextSidebar.querySelectorAll<HTMLDetailsElement>(
      "details[data-sidebar-key]",
    )) {
      const open = state?.open.get(details.dataset.sidebarKey!);
      if (open !== undefined) details.open = open;
      if (details.querySelector('[aria-current="page"]')) details.open = true;
    }
  });
  document.addEventListener("astro:after-swap", revealCurrentPage);
  document.addEventListener("astro:page-load", revealCurrentPage);
  revealCurrentPage();
</script>

<style>
  .sidebar-section-title::-webkit-details-marker {
    display: none;
  }
  .sidebar-section-title :global(.caret) {
    flex: 0 0 auto;
    color: var(--color-tertiary-foreground);
  }
  details[open] > .sidebar-section-title :global(.caret) {
    transform: rotate(90deg);
  }
  .sidebar-section-links :global(ul) {
    margin: 0;
  }
</style>
