---
import Icon from "../Icon.astro";

const quickLinks = [
  {
    section: "Get started",
    links: [
      {
        label: "Core concepts",
        href: "/docs/product/getting-started/core-concepts",
      },
      {
        label: "Choose a deployment",
        href: "/docs/product/getting-started/choose-deployment",
      },
    ],
  },
  {
    section: "Product",
    links: [
      { label: "Access Review", href: "/docs/product/access-review/overview" },
      { label: "Compliance Portal", href: "/docs/product/compliance-portal" },
      { label: "Risk management", href: "/docs/product/risk-management" },
    ],
  },
  {
    section: "Deployment",
    links: [
      { label: "Probo Cloud", href: "/docs/deployment/cloud" },
      { label: "Self-hosting", href: "/docs/deployment/self-hosting" },
    ],
  },
  {
    section: "Developers",
    links: [
      { label: "API", href: "/docs/developers/api-overview" },
      { label: "CLI", href: "/docs/developers/cli/overview" },
      { label: "MCP", href: "/docs/developers/api/mcp/overview" },
    ],
  },
];

const exampleQueries = ["SSO", "SCIM", "Cookie banner", "Device agent"];
---

<site-search class={Astro.props.class}>
  <button
    type="button"
    data-open-modal
    aria-label="Search documentation"
    aria-keyshortcuts="Control+K"
    disabled
  >
    <Icon name="magnifying-glass" size={16} />
    <span>Search documentation</span>
    <kbd aria-hidden="true"><span data-shortcut-modifier>Ctrl</span> K</kbd>
  </button>

  <dialog aria-label="Search documentation">
    <div class="dialog-frame">
      <div class="docs-search-field">
        <Icon name="magnifying-glass" size={20} />
        <label class="sr-only" for="docs-search-input"
          >Search documentation</label
        >
        <input
          id="docs-search-input"
          type="search"
          placeholder="Search features, tasks, or error messages…"
          autocomplete="off"
          spellcheck="false"
          aria-controls="docs-search-results"
        />
        <button type="button" data-close-modal aria-label="Close search">
          <span class="docs-search-close-desktop" aria-hidden="true">Esc</span>
          <span class="docs-search-close-mobile" aria-hidden="true">Cancel</span
          >
        </button>
      </div>
      <div class="docs-search-feedback">
        <p data-search-status role="status" aria-live="polite">
          Search for a feature, task, or error message.
        </p>
        <button type="button" data-search-retry hidden>Try again</button>
      </div>
      <div class="docs-search-empty" data-search-empty>
        <div class="docs-search-empty-sections">
          {
            quickLinks.map(({ section, links }) => (
              <section aria-label={section}>
                <p class="docs-search-empty-heading">{section}</p>
                <ul>
                  {links.map(({ label, href }) => (
                    <li>
                      <a href={href}>{label}</a>
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </div>
        <div>
          <p class="docs-search-empty-heading">Try searching for</p>
          <div class="docs-search-empty-chips">
            {
              exampleQueries.map((query) => (
                <button type="button" data-search-query={query}>
                  {query}
                </button>
              ))
            }
          </div>
        </div>
      </div>
      <ol id="docs-search-results" aria-label="Search results"></ol>
      <button type="button" data-search-more hidden>Show more results</button>
      <p class="docs-search-hint">
        Search all documentation <span aria-hidden="true">·</span>
        <kbd>↑</kbd><kbd>↓</kbd> to navigate
        <span aria-hidden="true">·</span>
        <kbd>Enter</kbd> to open
        <span aria-hidden="true">·</span>
        <kbd>Esc</kbd> to close
      </p>
    </div>
  </dialog>
</site-search>

<script>
  import { customElementDefine } from "../../lib/dom";
  import {
    animateDocsPanel,
    animateDocsResults,
    cancelDocsPanel,
  } from "./docs-motion";

  interface SearchData {
    url: string;
    excerpt: string;
    meta: { title?: string };
    sub_results?: { url: string; title: string; excerpt: string }[];
  }
  interface SearchHit {
    data: () => Promise<SearchData>;
  }
  interface SearchEngine {
    options: (options: {
      excerptLength: number;
      ranking: { pageLength: number; metaWeights: { title: number } };
    }) => Promise<void>;
    search: (query: string) => Promise<{ results: SearchHit[] }>;
  }

  class SiteSearch extends HTMLElement {
    openBtn!: HTMLButtonElement;
    closeBtn!: HTMLButtonElement;
    dialog!: HTMLDialogElement;
    input!: HTMLInputElement;
    status!: HTMLElement;
    results!: HTMLOListElement;
    more!: HTMLButtonElement;
    retry!: HTMLButtonElement;
    empty!: HTMLElement;
    engine: Promise<SearchEngine> | null = null;
    hits: SearchHit[] = [];
    shown = 0;
    version = 0;
    timer: ReturnType<typeof setTimeout> | undefined;
    previousFocus: HTMLElement | null = null;
    restoreFocus = true;
    closing = false;

    connectedCallback() {
      this.openBtn = this.querySelector("[data-open-modal]")!;
      this.closeBtn = this.querySelector("[data-close-modal]")!;
      this.dialog = this.querySelector("dialog")!;
      this.input = this.querySelector("input")!;
      this.status = this.querySelector("[data-search-status]")!;
      this.results = this.querySelector("ol")!;
      this.more = this.querySelector("[data-search-more]")!;
      this.retry = this.querySelector("[data-search-retry]")!;
      this.empty = this.querySelector("[data-search-empty]")!;
      this.openBtn.disabled = false;
      if (/(Mac|iPhone|iPod|iPad)/i.test(navigator.platform)) {
        this.querySelector("[data-shortcut-modifier]")!.textContent = "⌘";
        this.openBtn.setAttribute("aria-keyshortcuts", "Meta+K");
      }
      this.openBtn.addEventListener("click", this.openModal);
      this.closeBtn.addEventListener("click", this.closeModal);
      this.dialog.addEventListener("close", this.onClose);
      this.dialog.addEventListener("cancel", this.onCancel);
      this.dialog.addEventListener("click", this.onDialogClick);
      this.input.addEventListener("input", this.onInput);
      this.more.addEventListener("click", this.showMore);
      this.retry.addEventListener("click", this.retrySearch);
      document.addEventListener("keydown", this.onKeyDown);
      document.addEventListener("astro:before-swap", this.beforeSwap);
    }

    disconnectedCallback() {
      clearTimeout(this.timer);
      this.version++;
      cancelDocsPanel(this.dialog);
      this.openBtn.removeEventListener("click", this.openModal);
      this.closeBtn.removeEventListener("click", this.closeModal);
      this.dialog.removeEventListener("close", this.onClose);
      this.dialog.removeEventListener("cancel", this.onCancel);
      this.dialog.removeEventListener("click", this.onDialogClick);
      this.input.removeEventListener("input", this.onInput);
      this.more.removeEventListener("click", this.showMore);
      this.retry.removeEventListener("click", this.retrySearch);
      document.removeEventListener("keydown", this.onKeyDown);
      document.removeEventListener("astro:before-swap", this.beforeSwap);
      document.body.removeAttribute("data-search-modal-open");
    }

    openModal = () => {
      if (this.dialog.open && !this.closing) return;
      const reopening = this.closing;
      this.closing = false;
      this.dialog.inert = false;
      if (!reopening)
        this.previousFocus =
          document.activeElement instanceof HTMLElement
            ? document.activeElement
            : this.openBtn;
      this.restoreFocus = true;
      if (!this.dialog.open) this.dialog.showModal();
      void animateDocsPanel(this.dialog, true, "search");
      document.body.setAttribute("data-search-modal-open", "");
      this.input.focus();
      if (!this.input.value.trim())
        void this.loadEngine()
          .then(() => {
            if (this.isConnected && !this.input.value.trim())
              this.status.textContent =
                "Search for a feature, task, or error message.";
          })
          .catch(() => this.showError());
    };

    closeModal = () => {
      if (!this.dialog.open || this.closing) return;
      this.closing = true;
      this.dialog.inert = true;
      void animateDocsPanel(this.dialog, false, "search").then((finished) => {
        if (finished && this.closing) this.dialog.close();
      });
    };
    onCancel = (event: Event) => {
      event.preventDefault();
      this.closeModal();
    };
    beforeSwap = () => {
      this.restoreFocus = false;
      cancelDocsPanel(this.dialog);
      this.dialog.close();
    };
    onClose = () => {
      cancelDocsPanel(this.dialog);
      this.closing = false;
      this.dialog.inert = false;
      document.body.removeAttribute("data-search-modal-open");
      if (this.restoreFocus && this.previousFocus?.isConnected)
        this.previousFocus.focus({ preventScroll: true });
    };
    onDialogClick = (event: MouseEvent) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const example = target.closest<HTMLButtonElement>("[data-search-query]");
      if (example) {
        this.input.value = example.dataset.searchQuery ?? "";
        this.onInput();
        this.input.focus();
      } else if (target.closest("a[href]")) {
        this.restoreFocus = false;
        this.closeModal();
      } else if (target === this.dialog) {
        const rect = this.dialog.getBoundingClientRect();
        if (
          event.clientX < rect.left ||
          event.clientX > rect.right ||
          event.clientY < rect.top ||
          event.clientY > rect.bottom
        )
          this.closeModal();
      }
    };
    onKeyDown = (event: KeyboardEvent) => {
      if (event.isComposing) return;
      if (event.key === "Escape" && this.dialog.open) {
        event.preventDefault();
        event.stopPropagation();
        this.closeModal();
        return;
      }
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
        event.preventDefault();
        this.dialog.open && !this.closing
          ? this.closeModal()
          : this.openModal();
        return;
      }
      if (
        !this.dialog.open ||
        this.closing ||
        event.altKey ||
        event.ctrlKey ||
        event.metaKey ||
        event.shiftKey
      )
        return;
      const links = Array.from(
        this.results.querySelectorAll<HTMLAnchorElement>("a[href]"),
      );
      const active = document.activeElement;
      const index = links.findIndex((link) => link === active);
      if (active !== this.input && index < 0) return;
      if (event.key === "ArrowDown" || event.key === "ArrowUp") {
        if (!links.length) return;
        event.preventDefault();
        const next =
          active === this.input
            ? event.key === "ArrowDown"
              ? 0
              : links.length - 1
            : index + (event.key === "ArrowDown" ? 1 : -1);
        if (next < 0 || next >= links.length) this.input.focus();
        else links[next].focus();
      } else if (
        event.key === "Enter" &&
        active === this.input &&
        links.length
      ) {
        event.preventDefault();
        links[0].click();
      }
    };

    loadEngine = () => {
      if (!this.engine) {
        this.status.textContent = "Loading search…";
        this.retry.hidden = true;
        this.engine = (async () => {
          const url =
            import.meta.env.BASE_URL.replace(/\/$/, "") +
            "/pagefind/pagefind.js";
          const engine = (await import(/* @vite-ignore */ url)) as SearchEngine;
          await engine.options({
            excerptLength: 24,
            ranking: { pageLength: 0.35, metaWeights: { title: 8 } },
          });
          return engine;
        })().catch((error) => {
          this.engine = null;
          throw error;
        });
      }
      return this.engine;
    };

    onInput = () => {
      this.empty.hidden = Boolean(this.input.value.trim());
      clearTimeout(this.timer);
      this.version++;
      if (!this.input.value.trim()) {
        void this.search();
        return;
      }
      this.timer = setTimeout(this.search, 180);
    };

    search = async () => {
      const query = this.input.value.trim();
      const version = ++this.version;
      this.results.replaceChildren();
      this.more.hidden = true;
      this.retry.hidden = true;
      this.hits = [];
      this.shown = 0;
      if (!query) {
        this.results.removeAttribute("aria-busy");
        this.status.textContent =
          "Search for a feature, task, or error message.";
        return;
      }
      this.status.textContent = "Searching…";
      this.results.setAttribute("aria-busy", "true");
      try {
        const engine = await this.loadEngine();
        const response = await engine.search(query);
        if (version !== this.version || !this.isConnected) return;
        const hits = await this.rankHits(response.results, query);
        if (version !== this.version || !this.isConnected) return;
        this.hits = hits;
        if (!this.hits.length) {
          this.status.textContent =
            "No results for “" +
            query +
            "”. Try a feature name or fewer words.";
        } else {
          await this.renderNext(version);
        }
      } catch {
        if (version === this.version) this.showError();
      } finally {
        if (version === this.version) this.results.removeAttribute("aria-busy");
      }
    };

    showError() {
      if (!this.isConnected) return;
      this.results.removeAttribute("aria-busy");
      this.status.textContent = import.meta.env.DEV
        ? "Search is available in the production preview after building the documentation."
        : "Search couldn't load. Check your connection and try again.";
      this.retry.hidden = import.meta.env.DEV;
      this.more.hidden = true;
    }

    retrySearch = () => {
      this.engine = null;
      if (this.input.value.trim()) void this.search();
      else
        void this.loadEngine()
          .then(() => {
            this.status.textContent =
              "Search for a feature, task, or error message.";
          })
          .catch(() => this.showError());
    };

    showMore = async () => {
      const version = this.version;
      const firstNewResult = this.shown;
      const moveFocus = document.activeElement === this.more;
      this.more.disabled = true;
      this.results.setAttribute("aria-busy", "true");
      try {
        await this.renderNext(version);
        if (moveFocus && version === this.version)
          this.results
            .querySelectorAll<HTMLAnchorElement>("a[href]")
            [firstNewResult]?.focus();
      } catch {
        if (version === this.version) this.showError();
      } finally {
        this.more.disabled = false;
        if (version === this.version) this.results.removeAttribute("aria-busy");
      }
    };

    async rankHits(hits: SearchHit[], query: string): Promise<SearchHit[]> {
      const normalize = (text: string) =>
        text
          .toLowerCase()
          .normalize("NFKD")
          .replace(/[\u0300-\u036f]/g, "")
          .replace(/[^a-z0-9]+/g, " ")
          .trim();
      const section = (path: string) =>
        path.startsWith("/docs/developers")
          ? "developers"
          : path.startsWith("/docs/deployment")
            ? "deployment"
            : path.replace(/\.html$/, "").replace(/\/$/, "") === "/docs"
              ? "overview"
              : "product";
      const words = normalize(query).split(" ").filter(Boolean);
      const phrase = normalize(query);
      const currentSection = section(location.pathname);
      const candidates = await Promise.all(
        hits.slice(0, 24).map(async (hit, index) => {
          const data = await hit.data();
          const title = normalize(data.meta.title || "");
          const matchesTitle =
            words.length > 0 &&
            words.every((word) => title.split(" ").includes(word));
          let score = matchesTitle ? 5 : 0;
          if (phrase && title.startsWith(phrase)) score += 3;
          if (title === phrase) score += 5;
          if (
            matchesTitle &&
            currentSection === "overview" &&
            section(new URL(data.url, location.origin).pathname) === "product"
          )
            score += 1;
          if (
            currentSection !== "overview" &&
            section(new URL(data.url, location.origin).pathname) ===
              currentSection
          )
            score += 1;
          return { data, index, score };
        }),
      );
      candidates.sort((a, b) => b.score - a.score || a.index - b.index);
      return [
        ...candidates.map(({ data }) => ({ data: async () => data })),
        ...hits.slice(24),
      ];
    }

    async renderNext(version: number) {
      const batch = await Promise.all(
        this.hits.slice(this.shown, this.shown + 8).map((hit) => hit.data()),
      );
      if (version !== this.version || !this.isConnected) return;
      const added: HTMLElement[] = [];
      for (const data of batch) {
        const item = document.createElement("li");
        const link = document.createElement("a");
        const match = data.sub_results?.find((entry) => entry.excerpt);
        const url = new URL(match?.url || data.url, location.origin);
        url.pathname = url.pathname.replace(/\.html$/, "").replace(/\/+$/, "");
        link.href = url.pathname + url.search + url.hash;
        const title = document.createElement("strong");
        title.textContent = data.meta.title || "Documentation";
        const section = document.createElement("span");
        section.className = "docs-search-result-section";
        section.textContent = url.pathname.startsWith("/docs/developers")
          ? "Developers"
          : url.pathname.startsWith("/docs/deployment")
            ? "Deployment"
            : url.pathname.startsWith("/docs/product/getting-started")
              ? "Docs · Get started"
              : url.pathname === "/docs"
                ? "Documentation"
                : "Docs";
        const excerpt = document.createElement("p");
        const parsed = new DOMParser().parseFromString(
          match?.excerpt || data.excerpt || "",
          "text/html",
        );
        for (const node of parsed.body.childNodes) {
          if (node instanceof HTMLElement && node.tagName === "MARK") {
            const mark = document.createElement("mark");
            mark.textContent = node.textContent;
            excerpt.append(mark);
          } else {
            excerpt.append(document.createTextNode(node.textContent || ""));
          }
        }
        link.append(section, title, excerpt);
        item.append(link);
        this.results.append(item);
        added.push(item);
      }
      if (this.dialog.open && !this.closing) animateDocsResults(added);
      this.shown += batch.length;
      this.status.textContent =
        this.hits.length + (this.hits.length === 1 ? " result" : " results");
      this.more.hidden = this.shown >= this.hits.length;
    }
  }

  customElementDefine("site-search", () => SiteSearch);
</script>

<style>
  site-search {
    display: block;
    min-width: 0;
  }
  [data-open-modal] {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    height: 2.375rem;
    width: 100%;
    border: 1px solid var(--color-border-low);
    border-radius: 0.5rem;
    padding: 0 0.625rem;
    background: var(--color-subtle);
    color: var(--color-muted-foreground);
    cursor: pointer;
    font: inherit;
    font-size: 0.8125rem;
    text-align: left;
  }
  [data-open-modal] > span {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  [data-open-modal] kbd {
    margin-inline-start: auto;
    white-space: nowrap;
    color: var(--color-tertiary-foreground);
    font-size: 0.6875rem;
  }
  [data-open-modal]:hover {
    border-color: var(--color-border-mid);
    color: var(--color-primary);
  }
  button:focus-visible,
  input:focus-visible {
    outline: 2px solid var(--docs-focus);
    outline-offset: 3px;
  }
  dialog {
    width: min(44rem, calc(100% - 2rem));
    max-height: min(46rem, calc(100dvh - 4rem));
    margin: 2rem auto auto;
    padding: 0;
    border: 0;
    border-radius: 0.875rem;
    background: var(--docs-surface-raised);
    color: var(--color-primary);
    box-shadow: 0 16px 48px rgb(0 0 0 / 0.16);
    overflow: hidden;
  }
  dialog::backdrop {
    background: rgb(0 0 0 / 0.18);
  }
  .dialog-frame {
    display: flex;
    flex-direction: column;
    max-height: min(46rem, calc(100dvh - 4rem));
  }
  .docs-search-field {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap: 0.75rem;
    min-height: 4rem;
    padding: 0.5rem 0.75rem 0.5rem 1rem;
    border-bottom: 1px solid var(--docs-rule);
    color: var(--color-muted-foreground);
  }
  .docs-search-field > :global(svg) {
    flex-shrink: 0;
  }
  [data-close-modal] {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    min-width: 2.25rem;
    height: 2rem;
    padding: 0.25rem 0.5rem;
    border: 0;
    border-radius: 0.375rem;
    background: var(--color-subtle);
    color: var(--color-muted-foreground);
    font: inherit;
    font-size: 0.6875rem;
    cursor: pointer;
  }
  [data-close-modal]:hover {
    background: var(--color-highlight);
    color: var(--color-primary);
  }
  .docs-search-close-mobile {
    display: none;
  }
  .docs-search-field input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: none;
    background: transparent;
    color: var(--color-primary);
    font: inherit;
    font-size: 1rem;
  }
  .docs-search-field input::placeholder {
    color: var(--color-muted-foreground);
    opacity: 1;
  }
  .docs-search-field input:focus-visible {
    outline: none;
  }
  .docs-search-feedback {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
    min-height: 2.75rem;
    padding: 0.625rem 1rem;
    font-size: 0.8125rem;
    color: var(--color-muted-foreground);
  }
  .docs-search-feedback p {
    flex: 1;
    min-width: 0;
    margin: 0;
    overflow-wrap: anywhere;
  }
  [data-search-retry],
  [data-search-more] {
    border: 1px solid var(--color-border-mid);
    border-radius: 0.375rem;
    padding: 0.5rem 0.75rem;
    font: inherit;
    font-size: 0.8125rem;
    background: var(--color-subtle);
    color: var(--color-primary);
    cursor: pointer;
  }
  .docs-search-empty {
    display: grid;
    gap: 1.25rem;
    min-height: 0;
    padding: 0.5rem 1rem 1.25rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    font-size: 0.8125rem;
  }
  .docs-search-empty[hidden] {
    display: none;
  }
  .docs-search-empty-sections {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .docs-search-empty-heading {
    margin: 0 0 0.375rem;
    font-weight: 600;
  }
  .docs-search-empty ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .docs-search-empty a {
    display: block;
    padding-block: 0.375rem;
    color: var(--color-muted-foreground);
    text-decoration: none;
  }
  .docs-search-empty a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }
  .docs-search-empty-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .docs-search-empty-chips button {
    min-height: 2.25rem;
    padding: 0.375rem 0.625rem;
    border: 0;
    border-radius: 0.375rem;
    background: var(--color-subtle);
    color: var(--color-muted-foreground);
    font: inherit;
    cursor: pointer;
  }
  .docs-search-empty-chips button:hover {
    color: var(--color-primary);
    background: var(--color-highlight);
  }
  .docs-search-empty :is(a, button):focus-visible {
    outline: 2px solid var(--docs-focus);
    outline-offset: 2px;
  }
  #docs-search-results {
