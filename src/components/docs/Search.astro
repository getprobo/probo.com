---
import Icon from "../Icon.astro";
---

<site-search class={Astro.props.class}>
  <button
    type="button"
    data-open-modal
    aria-label="Search documentation"
    aria-keyshortcuts="Control+K"
    disabled
  >
    <Icon name="magnifying-glass" size={16} />
    <span>Search documentation</span>
    <kbd aria-hidden="true"><span data-shortcut-modifier>Ctrl</span> K</kbd>
  </button>

  <dialog aria-label="Search documentation">
    <div class="dialog-frame">
      <div class="docs-search-heading">
        <span>Search documentation</span>
        <button type="button" data-close-modal aria-label="Close search">
          <Icon name="x" size={18} />
        </button>
      </div>
      <label class="docs-search-field">
        <Icon name="magnifying-glass" size={20} />
        <span class="sr-only">Search documentation</span>
        <input
          type="search"
          placeholder="Search features, tasks, or error messages…"
          autocomplete="off"
          spellcheck="false"
          aria-controls="docs-search-results"
        />
      </label>
      <div class="docs-search-feedback">
        <p data-search-status role="status" aria-live="polite">
          Search for a feature, task, or error message.
        </p>
        <button type="button" data-search-retry hidden>Try again</button>
      </div>
      <ol id="docs-search-results" aria-label="Search results"></ol>
      <button type="button" data-search-more hidden>Show more results</button>
      <p class="docs-search-hint">
        Search all documentation <span aria-hidden="true">·</span>
        <kbd>Esc</kbd> to close
      </p>
    </div>
  </dialog>
</site-search>

<script>
  import { customElementDefine } from "../../lib/dom";

  interface SearchData {
    url: string;
    excerpt: string;
    meta: { title?: string };
    sub_results?: { url: string; title: string; excerpt: string }[];
  }
  interface SearchHit {
    data: () => Promise<SearchData>;
  }
  interface SearchEngine {
    options: (options: {
      excerptLength: number;
      ranking: { pageLength: number; metaWeights: { title: number } };
    }) => Promise<void>;
    search: (query: string) => Promise<{ results: SearchHit[] }>;
  }

  class SiteSearch extends HTMLElement {
    openBtn!: HTMLButtonElement;
    closeBtn!: HTMLButtonElement;
    dialog!: HTMLDialogElement;
    input!: HTMLInputElement;
    status!: HTMLElement;
    results!: HTMLOListElement;
    more!: HTMLButtonElement;
    retry!: HTMLButtonElement;
    engine: Promise<SearchEngine> | null = null;
    hits: SearchHit[] = [];
    shown = 0;
    version = 0;
    timer: ReturnType<typeof setTimeout> | undefined;
    previousFocus: HTMLElement | null = null;
    restoreFocus = true;

    connectedCallback() {
      this.openBtn = this.querySelector("[data-open-modal]")!;
      this.closeBtn = this.querySelector("[data-close-modal]")!;
      this.dialog = this.querySelector("dialog")!;
      this.input = this.querySelector("input")!;
      this.status = this.querySelector("[data-search-status]")!;
      this.results = this.querySelector("ol")!;
      this.more = this.querySelector("[data-search-more]")!;
      this.retry = this.querySelector("[data-search-retry]")!;
      this.openBtn.disabled = false;
      if (/(Mac|iPhone|iPod|iPad)/i.test(navigator.platform)) {
        this.querySelector("[data-shortcut-modifier]")!.textContent = "⌘";
        this.openBtn.setAttribute("aria-keyshortcuts", "Meta+K");
      }
      this.openBtn.addEventListener("click", this.openModal);
      this.closeBtn.addEventListener("click", this.closeModal);
      this.dialog.addEventListener("close", this.onClose);
      this.dialog.addEventListener("click", this.onDialogClick);
      this.input.addEventListener("input", this.onInput);
      this.more.addEventListener("click", this.showMore);
      this.retry.addEventListener("click", this.retrySearch);
      document.addEventListener("keydown", this.onKeyDown);
      document.addEventListener("astro:before-swap", this.beforeSwap);
    }

    disconnectedCallback() {
      clearTimeout(this.timer);
      this.version++;
      document.removeEventListener("keydown", this.onKeyDown);
      document.removeEventListener("astro:before-swap", this.beforeSwap);
      document.body.removeAttribute("data-search-modal-open");
    }

    openModal = () => {
      if (this.dialog.open) return;
      this.previousFocus =
        document.activeElement instanceof HTMLElement
          ? document.activeElement
          : this.openBtn;
      this.restoreFocus = true;
      this.dialog.showModal();
      document.body.setAttribute("data-search-modal-open", "");
      this.input.focus();
      if (!this.input.value.trim())
        void this.loadEngine()
          .then(() => {
            if (this.isConnected && !this.input.value.trim())
              this.status.textContent =
                "Search for a feature, task, or error message.";
          })
          .catch(() => this.showError());
    };

    closeModal = () => this.dialog.close();
    beforeSwap = () => {
      this.restoreFocus = false;
      this.dialog.close();
    };
    onClose = () => {
      document.body.removeAttribute("data-search-modal-open");
      if (this.restoreFocus && this.previousFocus?.isConnected)
        this.previousFocus.focus({ preventScroll: true });
    };
    onDialogClick = (event: MouseEvent) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (target.closest("a[href]")) {
        this.restoreFocus = false;
        this.closeModal();
      } else if (target === this.dialog) {
        const rect = this.dialog.getBoundingClientRect();
        if (
          event.clientX < rect.left ||
          event.clientX > rect.right ||
          event.clientY < rect.top ||
          event.clientY > rect.bottom
        )
          this.closeModal();
      }
    };
    onKeyDown = (event: KeyboardEvent) => {
      if (event.key === "Escape" && this.dialog.open) {
        event.preventDefault();
        event.stopPropagation();
        this.closeModal();
        return;
      }
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
        event.preventDefault();
        this.dialog.open ? this.closeModal() : this.openModal();
      }
    };

    loadEngine = () => {
      if (!this.engine) {
        this.status.textContent = "Loading search…";
        this.retry.hidden = true;
        this.engine = (async () => {
          const url =
            import.meta.env.BASE_URL.replace(/\/$/, "") +
            "/pagefind/pagefind.js";
          const engine = (await import(/* @vite-ignore */ url)) as SearchEngine;
          await engine.options({
            excerptLength: 24,
            ranking: { pageLength: 0.35, metaWeights: { title: 8 } },
          });
          return engine;
        })().catch((error) => {
          this.engine = null;
          throw error;
        });
      }
      return this.engine;
    };

    onInput = () => {
      clearTimeout(this.timer);
      this.version++;
      this.timer = setTimeout(this.search, 180);
    };

    search = async () => {
      const query = this.input.value.trim();
      const version = ++this.version;
      this.results.replaceChildren();
      this.more.hidden = true;
      this.retry.hidden = true;
      this.hits = [];
      this.shown = 0;
      if (!query) {
        this.results.removeAttribute("aria-busy");
        this.status.textContent =
          "Search for a feature, task, or error message.";
        return;
      }
      this.status.textContent = "Searching…";
      this.results.setAttribute("aria-busy", "true");
      try {
        const engine = await this.loadEngine();
        const response = await engine.search(query);
        if (version !== this.version || !this.isConnected) return;
        const hits = await this.rankHits(response.results, query);
        if (version !== this.version || !this.isConnected) return;
        this.hits = hits;
        if (!this.hits.length) {
          this.status.textContent =
            "No results for “" +
            query +
            "”. Try a feature name or fewer words.";
        } else {
          await this.renderNext(version);
        }
      } catch {
        if (version === this.version) this.showError();
      } finally {
        if (version === this.version) this.results.removeAttribute("aria-busy");
      }
    };

    showError() {
      if (!this.isConnected) return;
      this.results.removeAttribute("aria-busy");
      this.status.textContent = import.meta.env.DEV
        ? "Search is available in the production preview after building the documentation."
        : "Search couldn't load. Check your connection and try again.";
      this.retry.hidden = import.meta.env.DEV;
      this.more.hidden = true;
    }

    retrySearch = () => {
      this.engine = null;
      if (this.input.value.trim()) void this.search();
      else
        void this.loadEngine()
          .then(() => {
            this.status.textContent =
              "Search for a feature, task, or error message.";
          })
          .catch(() => this.showError());
    };

    showMore = async () => {
      const version = this.version;
      this.more.disabled = true;
      this.results.setAttribute("aria-busy", "true");
      try {
        await this.renderNext(version);
      } catch {
        if (version === this.version) this.showError();
      } finally {
        this.more.disabled = false;
        if (version === this.version) this.results.removeAttribute("aria-busy");
      }
    };

    async rankHits(hits: SearchHit[], query: string): Promise<SearchHit[]> {
      const normalize = (text: string) =>
        text
          .toLowerCase()
          .normalize("NFKD")
          .replace(/[\u0300-\u036f]/g, "")
          .replace(/[^a-z0-9]+/g, " ")
          .trim();
      const section = (path: string) =>
        path.startsWith("/docs/developers")
          ? "developers"
          : path.startsWith("/docs/deployment")
            ? "deployment"
            : path.startsWith("/docs/product/getting-started") ||
                path === "/docs"
              ? "overview"
              : "product";
      const words = normalize(query).split(" ").filter(Boolean);
      const phrase = normalize(query);
      const currentSection = section(location.pathname);
      const candidates = await Promise.all(
        hits.slice(0, 24).map(async (hit, index) => {
          const data = await hit.data();
          const title = normalize(data.meta.title || "");
          const matchesTitle =
            words.length > 0 &&
            words.every((word) => title.split(" ").includes(word));
          let score = matchesTitle ? 5 : 0;
          if (phrase && title.startsWith(phrase)) score += 3;
          if (title === phrase) score += 5;
          if (
            matchesTitle &&
            currentSection === "overview" &&
            section(new URL(data.url, location.origin).pathname) === "product"
          )
            score += 1;
          if (
            currentSection !== "overview" &&
            section(new URL(data.url, location.origin).pathname) ===
              currentSection
          )
            score += 1;
          return { data, index, score };
        }),
      );
      candidates.sort((a, b) => b.score - a.score || a.index - b.index);
      return [
        ...candidates.map(({ data }) => ({ data: async () => data })),
        ...hits.slice(24),
      ];
    }

    async renderNext(version: number) {
      const batch = await Promise.all(
        this.hits.slice(this.shown, this.shown + 8).map((hit) => hit.data()),
      );
      if (version !== this.version || !this.isConnected) return;
      for (const data of batch) {
        const item = document.createElement("li");
        const link = document.createElement("a");
        const match = data.sub_results?.find((entry) => entry.excerpt);
        const url = new URL(match?.url || data.url, location.origin);
        url.pathname = url.pathname.replace(/\.html$/, "").replace(/\/+$/, "");
        link.href = url.pathname + url.search + url.hash;
        const title = document.createElement("strong");
        title.textContent = data.meta.title || "Documentation";
        const section = document.createElement("span");
        section.className = "docs-search-result-section";
        section.textContent = url.pathname.startsWith("/docs/developers")
          ? "Developers"
          : url.pathname.startsWith("/docs/deployment")
            ? "Deploy Probo"
            : url.pathname.startsWith("/docs/product/getting-started") ||
                url.pathname === "/docs"
              ? "Get started"
              : "Use Probo";
        const excerpt = document.createElement("p");
        const parsed = new DOMParser().parseFromString(
          match?.excerpt || data.excerpt || "",
          "text/html",
        );
        for (const node of parsed.body.childNodes) {
          if (node instanceof HTMLElement && node.tagName === "MARK") {
            const mark = document.createElement("mark");
            mark.textContent = node.textContent;
            excerpt.append(mark);
          } else {
            excerpt.append(document.createTextNode(node.textContent || ""));
          }
        }
        link.append(section, title, excerpt);
        item.append(link);
        this.results.append(item);
      }
      this.shown += batch.length;
      this.status.textContent =
        this.hits.length + (this.hits.length === 1 ? " result" : " results");
      this.more.hidden = this.shown >= this.hits.length;
    }
  }

  customElementDefine("site-search", () => SiteSearch);
</script>

<style>
  site-search {
    display: block;
    min-width: 0;
  }
  [data-open-modal] {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    height: 2.375rem;
    width: 100%;
    border: 1px solid var(--color-border-low);
    border-radius: 0.5rem;
    padding: 0 0.625rem;
    background: var(--color-subtle);
    color: var(--color-muted-foreground);
    cursor: pointer;
    font: inherit;
    font-size: 0.8125rem;
    text-align: left;
  }
  [data-open-modal] > span {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  [data-open-modal] kbd {
    margin-inline-start: auto;
    white-space: nowrap;
    color: var(--color-tertiary-foreground);
    font-size: 0.6875rem;
  }
  [data-open-modal]:hover {
    border-color: var(--color-border-mid);
    color: var(--color-primary);
  }
  button:focus-visible,
  input:focus-visible {
    outline: 2px solid var(--docs-focus);
    outline-offset: 3px;
  }
  dialog {
    width: min(44rem, calc(100% - 2rem));
    max-height: min(46rem, calc(100dvh - 4rem));
    margin: 2rem auto auto;
    padding: 0;
    border: 1px solid var(--color-border-mid);
    border-radius: 0.875rem;
    background: var(--color-level-0);
    color: var(--color-primary);
    box-shadow: var(--sl-shadow-lg);
    overflow: auto;
  }
  dialog::backdrop {
    background: rgb(24 24 20 / 0.46);
    backdrop-filter: blur(2px);
  }
  .dialog-frame {
    padding: 1rem;
  }
  .docs-search-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
    font-size: 0.8125rem;
    font-weight: 600;
  }
  [data-close-modal] {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: 0.375rem;
    background: var(--color-subtle);
    color: inherit;
    cursor: pointer;
  }
  .docs-search-field {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem;
    border: 1px solid var(--color-border-mid);
    border-radius: 0.5rem;
  }
  .docs-search-field:focus-within {
    border-color: var(--docs-focus);
    box-shadow: none;
  }
  .docs-search-field input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: none;
    background: transparent;
    color: var(--color-primary);
    font: inherit;
    font-size: 1rem;
  }
  .docs-search-field input::placeholder {
    color: var(--color-muted-foreground);
    opacity: 1;
  }
  .docs-search-field input:focus-visible {
    outline: none;
  }
  .docs-search-feedback {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 3rem;
    font-size: 0.8125rem;
    color: var(--color-muted-foreground);
  }
  .docs-search-feedback p {
    margin: 0;
  }
  [data-search-retry],
  [data-search-more] {
    border: 1px solid var(--color-border-mid);
    border-radius: 0.375rem;
    padding: 0.5rem 0.75rem;
    font: inherit;
    font-size: 0.8125rem;
    background: var(--color-subtle);
    color: var(--color-primary);
    cursor: pointer;
  }
  #docs-search-results {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  #docs-search-results :global(li + li) {
    border-top: 1px solid var(--color-border-low);
  }
  #docs-search-results :global(a) {
    display: block;
    padding: 1rem 0.75rem;
    border-radius: 0.5rem;
    color: inherit;
    text-decoration: none;
  }
  #docs-search-results :global(a:hover) {
    background: var(--color-subtle);
  }
  #docs-search-results :global(a:focus-visible) {
    outline: 2px solid var(--docs-focus);
    outline-offset: -2px;
  }
  #docs-search-results :global(strong) {
    display: block;
    margin-top: 0.25rem;
    font-size: 1rem;
    font-weight: 600;
  }
  #docs-search-results :global(.docs-search-result-section) {
    color: var(--color-tertiary-foreground);
    font-size: 0.6875rem;
  }
  #docs-search-results :global(p) {
    margin: 0.375rem 0 0;
    color: var(--color-muted-foreground);
    font-size: 0.8125rem;
    line-height: 1.55;
  }
  #docs-search-results :global(mark) {
    background: var(--docs-accent-soft);
    color: var(--color-primary);
  }
  [data-search-more] {
    width: 100%;
    margin-top: 0.75rem;
  }
  .docs-search-hint {
    margin: 1rem 0 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border-low);
    color: var(--color-tertiary-foreground);
    font-size: 0.6875rem;
  }
  .docs-search-hint span {
    margin-inline: 0.25rem;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  @media (min-width: 40rem) {
    dialog {
      margin-top: 7rem;
    }
  }
  @media (max-width: 39.999rem) {
    [data-open-modal] kbd {
      display: none;
    }
  }
</style>
<style is:global>
  body[data-search-modal-open] {
    overflow: hidden;
  }
</style>
