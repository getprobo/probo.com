---
/**
 * Page-level tab navigation for docs that present alternate paths on one page
 * (for example SCIM Bridge vs Native). Wraps Starlight Tabs with Stripe-style
 * underline chrome, keeps the "On this page" TOC in sync with the active tab,
 * and mirrors the active tab in a query param so links stay shareable.
 *
 * Usage:
 *   import PageTabs from "../../../../../components/docs/PageTabs.astro";
 *   import { TabItem } from "@astrojs/starlight/components";
 *
 *   <PageTabs>
 *     <TabItem label="SCIM Bridge">...</TabItem>
 *     <TabItem label="Native">...</TabItem>
 *   </PageTabs>
 *
 * The tab label is slugified into the query param, so the example above is
 * shareable as `?tab=native`.
 */
import { Tabs } from "@astrojs/starlight/components";

interface Props {
  /** Query parameter name used to deep-link the active tab. */
  param?: string;
}

const { param = "tab" } = Astro.props;
---

<docs-page-tabs class="docs-page-tabs" data-param={param}>
  <Tabs>
    <slot />
  </Tabs>
</docs-page-tabs>

<script>
  import { animateDocsTab } from "./docs-motion";

  const slugify = (label: string) =>
    label
      .trim()
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");

  class DocsPageTabs extends HTMLElement {
    #initialized = false;
    #canAnimate = false;
    #observer: MutationObserver | undefined;
    #animation: Animation | null = null;
    #clipContainer: HTMLElement | null = null;
    #previousOverflow = "";
    #firstFrame = 0;
    #secondFrame = 0;
    #hashFrame = 0;
    #hashHandler: (() => void) | undefined;

    connectedCallback() {
      if (this.#initialized) return;
      this.#initialized = true;
      const tabs = [
        ...this.querySelectorAll<HTMLElement>(
          ':scope > starlight-tabs > .tablist-wrapper [role="tab"]',
        ),
      ];
      const panels = [
        ...this.querySelectorAll<HTMLElement>(
          ':scope > starlight-tabs > [role="tabpanel"]',
        ),
      ];
      if (!tabs.length || tabs.length !== panels.length) return;

      const param = this.dataset.param || "tab";
      const slugs = tabs.map((tab) => slugify(tab.textContent || ""));
      const requested = new URL(location.href).searchParams.get(param);
      const requestedIndex = requested ? slugs.indexOf(requested) : -1;
      if (requestedIndex >= 0) this.#activate(tabs, panels, requestedIndex);

      const syncQuery = (index: number) => {
        const url = new URL(location.href);
        if (index === 0) url.searchParams.delete(param);
        else url.searchParams.set(param, slugs[index]);
        // Do not retain an anchor owned by the panel the reader just left.
        let target: HTMLElement | null = null;
        try {
          target = document.getElementById(
            decodeURIComponent(url.hash.slice(1)),
          );
        } catch {
          /* An invalid external fragment does not select a panel. */
        }
        const targetPanel = target
          ? panels.findIndex((panel) => panel.contains(target))
          : -1;
        if (targetPanel >= 0 && targetPanel !== index) url.hash = "";
        if (url.href !== location.href)
          history.replaceState(history.state, "", url);
      };
      this.#hashHandler = () => {
        let id: string;
        try {
          id = decodeURIComponent(location.hash.slice(1));
        } catch {
          return;
        }
        if (!id) return;
        const target = document.getElementById(id);
        if (!target) return;
        const index = panels.findIndex((panel) => panel.contains(target));
        if (index < 0) return;
        // A real content fragment wins over a conflicting tab query. The
        // native tab API updates the panel and its aria state without focus theft.
        if (panels[index].hidden) this.#activate(tabs, panels, index);
        syncQuery(index);
        cancelAnimationFrame(this.#hashFrame);
        this.#hashFrame = requestAnimationFrame(() => {
          if (this.isConnected && !panels[index].hidden)
            target.scrollIntoView({ block: "start", behavior: "instant" });
        });
      };
      window.addEventListener("hashchange", this.#hashHandler);
      this.#hashHandler();

      let activeIndex = panels.findIndex((panel) => !panel.hidden);
      // Starlight owns selection and keyboard navigation. The same final
      // visibility state drives both motion and the shareable URL.
      this.#observer = new MutationObserver(() => {
        const nextIndex = panels.findIndex((panel) => !panel.hidden);
        if (nextIndex === -1 || nextIndex === activeIndex) return;
        const direction = nextIndex > activeIndex ? 1 : -1;
        activeIndex = nextIndex;
        this.#clearAnimation();
        if (!this.#canAnimate) return;

        syncQuery(nextIndex);

        const panel = panels[nextIndex];
        const animation = animateDocsTab(panel, direction);
        if (!animation) return;
        this.#animation = animation;
        this.#clipContainer = panel.parentElement;
        if (this.#clipContainer) {
          this.#previousOverflow = this.#clipContainer.style.overflowX;
          this.#clipContainer.style.overflowX = "clip";
        }
        void animation.finished.then(
          () => {
            if (this.#animation === animation) this.#clearAnimation();
          },
          () => {},
        );
      });
      panels.forEach((panel) =>
        this.#observer!.observe(panel, {
          attributes: true,
          attributeFilter: ["hidden"],
        }),
      );
      document.addEventListener("astro:before-swap", this.#beforeSwap);

      // Hydration and an initial deep link never animate reading content.
      this.#firstFrame = requestAnimationFrame(() => {
        this.#secondFrame = requestAnimationFrame(() => {
          this.#canAnimate = true;
        });
      });
    }

    disconnectedCallback() {
      this.#observer?.disconnect();
      this.#observer = undefined;
      this.#clearAnimation();
      cancelAnimationFrame(this.#firstFrame);
      cancelAnimationFrame(this.#secondFrame);
      cancelAnimationFrame(this.#hashFrame);
      if (this.#hashHandler)
        window.removeEventListener("hashchange", this.#hashHandler);
      this.#hashHandler = undefined;
      document.removeEventListener("astro:before-swap", this.#beforeSwap);
      this.#initialized = false;
      this.#canAnimate = false;
    }

    #beforeSwap = () => {
      this.#clearAnimation();
      cancelAnimationFrame(this.#hashFrame);
    };

    #clearAnimation() {
      this.#animation?.cancel();
      this.#animation = null;
      if (this.#clipContainer) {
        this.#clipContainer.style.overflowX = this.#previousOverflow;
        this.#clipContainer = null;
      }
    }

    #activate(tabs: HTMLElement[], panels: HTMLElement[], index: number) {
      const nativeTabs = this.querySelector(":scope > starlight-tabs") as
        | (HTMLElement & {
            switchTab?: (
              tab: HTMLElement,
              index: number,
              shouldSync?: boolean,
            ) => void;
          })
        | null;
      if (nativeTabs?.switchTab) {
        nativeTabs.switchTab(tabs[index], index, false);
        return;
      }
      tabs.forEach((tab, i) => {
        tab.setAttribute("aria-selected", i === index ? "true" : "false");
        if (i === index) tab.removeAttribute("tabindex");
        else tab.setAttribute("tabindex", "-1");
      });
      panels.forEach((panel, i) => {
        panel.hidden = i !== index;
      });
    }
  }

  if (!customElements.get("docs-page-tabs")) {
    customElements.define("docs-page-tabs", DocsPageTabs);
  }
</script>
