---
import Icon, { type IconName } from "../Icon.astro";
import {
  getDocsSectionForPath,
  normalizeDocsPath,
} from "../../lib/docs-navigation";

interface Props {
  placement?: "header" | "sidebar";
}

const { placement = "header" } = Astro.props;
const currentSection = getDocsSectionForPath(Astro.url.pathname);
const activeSection =
  currentSection === "overview" ? "product" : currentSection;
const spaces = [
  {
    id: "product",
    label: "Docs",
    href: "/docs/product",
    icon: "book-open-text",
  },
  {
    id: "developers",
    label: "Developers",
    href: "/docs/developers",
    icon: "code",
  },
  {
    id: "deployment",
    label: "Deployment",
    href: "/docs/deployment",
    icon: "terminal-window",
  },
] as const;
const sections = spaces;
---

<nav
  class:list={["docs-section-nav", `docs-section-nav--${placement}`]}
  aria-label={placement === "sidebar"
    ? "Documentation spaces"
    : "Documentation sections"}
>
  {
    sections.map((section) => {
      const isActive = section.id === activeSection;
      return (
        <a
          href={section.href}
          data-astro-prefetch="hover"
          class:list={[
            "docs-section-nav__link",
            isActive ? "docs-section-nav__link--active" : "",
          ]}
          aria-current={
            isActive
              ? normalizeDocsPath(Astro.url.pathname) === section.href
                ? "page"
                : "location"
              : undefined
          }
        >
          {"icon" in section && (
            <Icon name={section.icon as IconName} size={16} />
          )}
          {section.label}
        </a>
      );
    })
  }
</nav>

<style>
  .docs-section-nav {
    display: flex;
    align-items: center;
    min-width: 0;
    gap: 0.25rem;
  }
  .docs-section-nav--header {
    overflow-x: auto;
  }
  .docs-section-nav__link {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    gap: 0.625rem;
    position: relative;
    min-height: 2.25rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.375rem;
    font-size: 0.8125rem;
    white-space: nowrap;
    text-decoration: none;
    font-weight: 500;
    color: var(--color-muted-foreground);
  }

  .docs-section-nav__link:hover {
    text-decoration: none;
    color: var(--color-primary);
    background: var(--color-subtle);
  }

  .docs-section-nav__link--active,
  .docs-section-nav__link[aria-current="page"] {
    color: var(--color-primary);
    font-weight: 600;
  }
  .docs-section-nav--sidebar {
    display: grid;
    gap: 0.125rem;
  }
  .docs-section-nav--sidebar .docs-section-nav__link {
    width: 100%;
  }
  .docs-section-nav--sidebar :global(svg) {
    color: var(--color-tertiary-foreground);
    flex-shrink: 0;
  }
  .docs-section-nav--sidebar .docs-section-nav__link--active :global(svg) {
    color: var(--color-primary);
  }
  @media (max-width: 63.999rem) {
    .docs-section-nav--header {
      display: none;
    }
  }
</style>
