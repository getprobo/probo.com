---
import DefaultFooter from "@astrojs/starlight/components/Footer.astro";
import Icon from "../Icon.astro";

const links = [
  {
    label: "Discuss setup and usage in the",
    action: "Probo community",
    href: "https://discord.com/invite/8qfdJYfvpY",
    icon: "terminal-window",
  },
  {
    label: "See what's new in the",
    action: "changelog",
    href: "/changelog",
    icon: "notepad",
  },
] as const;
---

<DefaultFooter>
  <slot />
</DefaultFooter>

<footer class="docs-help-footer" aria-label="Documentation help">
  <h2>Keep going</h2>
  <ul>
    {
      links.map((link) => (
        <li>
          <span class="docs-help-footer__icon" aria-hidden="true">
            <Icon name={link.icon} size={20} />
          </span>
          <span>
            {link.label} <a href={link.href}>{link.action}</a>
          </span>
        </li>
      ))
    }
  </ul>
</footer>

<style>
  .docs-help-footer {
    margin-top: 2.5rem;
    border-top: 1px solid var(--color-border-low);
    padding: 2rem 0 0.5rem;
    color: var(--color-muted-foreground);
    font-size: 0.9375rem;
  }

  .docs-help-footer ul {
    display: grid;
    gap: 0.7rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .docs-help-footer h2 {
    margin: 0 0 0.9rem;
    color: var(--color-primary);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .docs-help-footer li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    line-height: 1.45;
  }

  .docs-help-footer__icon {
    display: grid;
    flex: 0 0 auto;
    width: 1.25rem;
    height: 1.25rem;
    place-items: center;
    color: var(--color-muted-foreground);
  }

  .docs-help-footer a {
    color: var(--docs-link);
    font-weight: 600;
    text-decoration: none;
  }

  .docs-help-footer a:hover {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .docs-help-footer a:focus-visible {
    border-radius: 0.2rem;
    outline: 2px solid var(--docs-focus);
    outline-offset: 3px;
  }
</style>
