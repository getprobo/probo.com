---
interface Props {
  chart: string;
  caption?: string;
  class?: string;
}

const { chart, caption, class: className } = Astro.props;
---

<figure class:list={["mermaid-diagram not-content", className]}>
  <pre
    class="mermaid"
    tabindex="0"
    role="region"
    aria-label={caption ||
      "Diagram. Scroll horizontally to explore."}>{chart}</pre>
  <figcaption>
    {caption && <span>{caption}</span>}<span class="diagram-scroll-hint"
      >Scroll horizontally to explore the diagram.</span
    >
  </figcaption>
</figure>

<style>
  .mermaid-diagram {
    margin: 1.5rem 0;
    border: 1px solid var(--color-border-low);
    border-radius: 0.5rem;
    background: var(--docs-surface-raised);
    box-shadow: 0 1px 2px rgb(20 30 18 / 0.03);
    overflow: hidden;
  }

  .mermaid-diagram :global(pre.mermaid) {
    display: flex;
    justify-content: flex-start;
    margin: 0;
    padding: 1.5rem 1rem;
    background: transparent;
    border: none;
    min-height: 12rem;
    overflow-x: auto;
  }

  .mermaid-diagram :global(pre.mermaid svg) {
    max-width: 100%;
    flex: 0 0 auto;
    height: auto;
    margin-inline: auto;
  }

  .mermaid-diagram :global(pre.mermaid-error) {
    color: var(--sl-color-red);
    font-size: var(--sl-text-sm);
  }

  .diagram-scroll-hint {
    display: none;
  }
  .mermaid-diagram[data-diagram-overflow="true"] .diagram-scroll-hint {
    display: block;
  }
  .mermaid-diagram figcaption:empty {
    display: none;
  }
  .mermaid-diagram figcaption {
    border-top: 1px solid var(--color-border-low);
    padding: 0.625rem 1rem;
    color: var(--color-muted-foreground);
    font-size: var(--sl-text-xs);
    text-align: center;
  }
</style>

<script>
  import { bindMermaidLifecycle } from "./mermaid-init.ts";

  bindMermaidLifecycle();
</script>
