---
import Icon from "../Icon.astro";
import { Badge } from "@astrojs/starlight/components";
import {
  getDocsSection,
  getDocsSectionForPath,
  normalizeDocsPath,
} from "../../lib/docs-navigation";

type Breadcrumb = {
  label: string;
  href?: string;
};

const { entry, sidebar } = Astro.locals.starlightRoute;
type SidebarEntry = (typeof sidebar)[number];
const { title, description, badge } = entry.data;
const titleBadge =
  badge ??
  (typeof entry.data.sidebar?.badge === "object"
    ? entry.data.sidebar?.badge
    : typeof entry.data.sidebar?.badge === "string"
      ? { text: entry.data.sidebar.badge, variant: "default" as const }
      : undefined);
const pathname = normalizeDocsPath(Astro.url.pathname);
const markdownUrl = pathname ? `${pathname}.md` : "/index.md";
const activeSection = getDocsSection(getDocsSectionForPath(Astro.url.pathname));

function firstHref(entries: SidebarEntry[]): string | undefined {
  for (const entry of entries) {
    if (entry.type === "link") return entry.href;
    const href = firstHref(entry.entries);
    if (href) return href;
  }
}

function findCurrent(
  entries: SidebarEntry[],
  parents: Breadcrumb[] = [],
): Breadcrumb[] | undefined {
  for (const entry of entries) {
    if (entry.type === "link" && entry.isCurrent) {
      return [...parents, { label: entry.label }];
    }

    if (entry.type === "group") {
      const result = findCurrent(entry.entries, [
        ...parents,
        { label: entry.label, href: firstHref(entry.entries) },
      ]);
      if (result) return result;
    }
  }
}

const sidebarCrumbs = findCurrent(sidebar) ?? [];
const breadcrumbs = [
  { label: "Docs", href: "/docs" },
  { label: activeSection.label, href: activeSection.href },
  ...sidebarCrumbs.slice(0, -1),
]
  .map((crumb) => ({
    ...crumb,
    href: crumb.href ? normalizeDocsPath(crumb.href) : undefined,
  }))
  .filter(
    (crumb, index, crumbs) =>
      crumb.href &&
      crumb.href !== pathname &&
      !/^(overview|developer overview|deployment overview)$/i.test(
        crumb.label,
      ) &&
      crumbs.findIndex((other) => other.href === crumb.href) === index,
  );
---

<header class="docs-page-header">
  {
    breadcrumbs.length > 0 && (
      <nav aria-label="Breadcrumb" data-pagefind-ignore>
        <ol class="docs-breadcrumbs">
          {breadcrumbs.map((crumb, index) => (
            <li>
              {index > 0 && (
                <span class="docs-breadcrumbs__separator" aria-hidden="true">
                  /
                </span>
              )}
              {crumb.href ? (
                <a href={crumb.href}>{crumb.label}</a>
              ) : (
                <span aria-current="page">{crumb.label}</span>
              )}
            </li>
          ))}
        </ol>
      </nav>
    )
  }

  <h1 id="_top" data-pagefind-weight="10">
    {title}
    {
      titleBadge && (
        <Badge
          text={titleBadge.text}
          variant={titleBadge.variant ?? "default"}
          class={titleBadge.class}
          size="medium"
        />
      )
    }
  </h1>
  {
    description && (
      <p class="docs-page-description" data-pagefind-weight="2">
        {description}
      </p>
    )
  }

  <div class="docs-page-actions" aria-label="Page actions" data-pagefind-ignore>
    <button
      type="button"
      class="docs-page-action"
      data-copy-markdown
      data-markdown-url={markdownUrl}
      title="Copy this page as Markdown"
    >
      <Icon name="copy" size={18} />
      <span data-copy-label aria-live="polite">Copy page</span>
    </button>
    <span class="docs-page-actions__divider" aria-hidden="true"></span>
    <a class="docs-page-action" href={markdownUrl} rel="nofollow">
      <Icon name="markdown-logo" size={18} />
      Markdown
    </a>
  </div>
</header>

<style>
  .docs-page-header {
    border-bottom: 1px solid var(--color-border-low);
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
  }

  .docs-breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 1.25rem;
    padding: 0;
    list-style: none;
    color: var(--color-muted-foreground);
    font-size: var(--sl-text-sm);
  }

  .docs-breadcrumbs li {
    display: flex;
    gap: 0.4rem;
  }

  .docs-breadcrumbs a {
    color: inherit;
    text-decoration: none;
  }

  .docs-breadcrumbs a:hover {
    color: var(--color-primary);
  }

  .docs-breadcrumbs__separator {
    color: var(--color-border-high);
  }

  #_top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 0.5rem !important;
    color: var(--color-primary);
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 650;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .docs-page-description {
    max-width: 46rem;
    margin: 0;
    color: var(--color-muted-foreground);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.45;
  }

  .docs-page-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .docs-page-action {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: 0;
    padding: 0.25rem 0;
    background: transparent;
    color: var(--color-muted-foreground);
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.3;
    text-decoration: none;
    cursor: pointer;
  }

  .docs-page-action:hover {
    color: var(--color-primary);
  }

  .docs-page-action:focus-visible {
    border-radius: 0.2rem;
    outline: 2px solid var(--docs-accent);
    outline-offset: 3px;
  }

  .docs-page-actions__divider {
    width: 1px;
    height: 1.15rem;
    background: var(--color-border-mid);
  }
</style>

<script>
  async function copyText(text: string) {
    try {
      await navigator.clipboard.writeText(text);
      return;
    } catch {
      const focused = document.activeElement;
      const textarea = document.createElement("textarea");
      textarea.value = text;
      textarea.setAttribute("readonly", "");
      textarea.style.position = "fixed";
      textarea.style.opacity = "0";
      document.body.append(textarea);
      textarea.select();
      const copied = document.execCommand("copy");
      textarea.remove();
      if (focused instanceof HTMLElement)
        focused.focus({ preventScroll: true });
      if (!copied) throw new Error("Clipboard write failed");
    }
  }

  if (!document.documentElement.dataset.docsCopyMarkdown) {
    document.documentElement.dataset.docsCopyMarkdown = "true";
    document.addEventListener("click", async (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const button = target.closest<HTMLButtonElement>("[data-copy-markdown]");
      if (!button) return;

      const label = button.querySelector<HTMLElement>("[data-copy-label]");
      const url = button.dataset.markdownUrl;
      if (!label || !url) return;

      button.disabled = true;
      label.textContent = "Copying…";
      try {
        const response = await fetch(url);
        if (!response.ok) throw new Error(`Markdown request failed`);
        const text = await response.text();
        if (/^\s*<!doctype html/i.test(text))
          throw new Error("Markdown unavailable");
        await copyText(text);
        label.textContent = "Copied";
      } catch {
        label.textContent = "Copy failed";
      } finally {
        button.disabled = false;
      }

      window.setTimeout(() => {
        label.textContent = "Copy page";
      }, 1800);
    });
  }
</script>
