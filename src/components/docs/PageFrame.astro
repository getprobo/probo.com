---
import { Image } from "astro:assets";
import Logo from "../../assets/probo-logo.svg";
import WhiteLogo from "../../assets/probo_white_logo.svg";
import MobileMenuToggle from "virtual:starlight/components/MobileMenuToggle";
import Search from "virtual:starlight/components/Search";
import Button from "../ui/Button.svelte";
import ThemeToggle from "./ThemeToggle.astro";
import Icon from "../Icon.astro";
import {
  getDocsSection,
  getDocsSectionForPath,
  normalizeDocsPath,
} from "../../lib/docs-navigation";

const hasCookieBanner = Boolean(
  import.meta.env.PUBLIC_COOKIE_BANNER_ID &&
  import.meta.env.PUBLIC_COOKIE_BANNER_API_BASE_URL,
);
const isHome = normalizeDocsPath(Astro.url.pathname) === "/docs";
const section = getDocsSection(getDocsSectionForPath(Astro.url.pathname));
---

<div class="docs-chrome">
  <header class="docs-masthead">
    <div class="docs-brand">
      <MobileMenuToggle />
      <a class="docs-logo" href="/" aria-label="Probo home">
        <Image
          class="docs-logo-light"
          src={Logo}
          alt="Probo"
          width={85}
          height={24}
        />
        <Image
          class="docs-logo-dark"
          src={WhiteLogo}
          alt="Probo"
          width={85}
          height={24}
        />
      </a>
      <span class="docs-brand-separator" aria-hidden="true"></span>
      <a
        class="docs-home-link"
        href="/docs"
        data-astro-prefetch="hover"
        aria-label={`${section.label} — documentation home`}
      >
        {section.label}
      </a>
    </div>
    <Search class="docs-chrome-search" />
    <div class="docs-masthead-actions">
      <ThemeToggle />
      <Button href="/contact" class="docs-compliant">Get compliant</Button>
    </div>
  </header>
</div>

<div
  transition:animate="none"
  class:list={["docs-shell", { "docs-shell--home": isHome }]}
>
  <div class="docs-main">
    <nav
      id="starlight__sidebar"
      class="sidebar"
      aria-label={Astro.locals.t("sidebarNav.accessibleLabel")}
    >
      <slot name="sidebar" />
    </nav>
    <div
      class:list={[
        "docs-content",
        { "docs-content--with-utilities": hasCookieBanner },
      ]}
    >
      <slot />
      {
        hasCookieBanner && (
          <footer class="docs-page-utilities" aria-label="Privacy settings">
            <div class="cookie-settings-row">
              <Icon name="cookie" size="1.2em" class="cookie-settings-icon" />
              <probo-settings-link class="cookie-settings">
                <span>Cookie settings</span>
              </probo-settings-link>
            </div>
          </footer>
        )
      }
    </div>
  </div>
</div>

{
  hasCookieBanner && (
    <probo-cookie-banner
      banner-id={import.meta.env.PUBLIC_COOKIE_BANNER_ID}
      base-url={import.meta.env.PUBLIC_COOKIE_BANNER_API_BASE_URL}
      position="bottom-right"
    />
  )
}

<script>
  import { initDocsMotion } from "./docs-motion";
  initDocsMotion();
</script>

<style>
  .docs-content--with-utilities {
    display: flex;
    flex-direction: column;
    min-height: calc(100dvh - var(--sl-docs-chrome-height));
    padding-block-end: 0.75rem;
  }
  .docs-content--with-utilities > :global(.docs-body) {
    width: 100%;
  }
  .docs-page-utilities {
    display: flex;
    justify-content: flex-end;
    margin-block-start: auto;
    margin-inline-end: calc(1.5rem - var(--docs-page-padding-x));
    padding-block-start: 2rem;
  }
  .cookie-settings-row {
    position: relative;
    width: fit-content;
    max-width: min(100%, 16rem);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .cookie-settings-row :global(.cookie-settings-icon) {
    position: absolute;
    inset-block-start: calc(0.5625rem + 0.15em);
    inset-inline-start: 0;
    pointer-events: none;
  }
  .cookie-settings {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    max-width: 100%;
    min-height: 2.25rem;
    padding-block: 0.5625rem;
    padding-inline: 0.625rem;
    padding-inline-start: calc(1.2em + 0.25rem);
    flex-wrap: wrap;
    font-size: inherit;
    line-height: 1.5;
    color: inherit;
    text-align: start;
  }
  .cookie-settings :global(> span) {
    flex-shrink: 0;
    overflow-wrap: normal;
  }
  .cookie-settings :global([data-probo-gpc]) {
    flex-basis: 100%;
    max-width: 100%;
    font-weight: 400 !important;
    line-height: 1.45;
    white-space: normal !important;
  }
  .cookie-settings-row:has(.cookie-settings:is(:hover, :focus-visible)) {
    color: var(--color-primary);
  }
  .cookie-settings:focus-visible {
    border-radius: 0.25rem;
    outline: 2px solid var(--docs-focus);
    outline-offset: 3px;
  }
  @media (max-width: 63.999rem) {
    .docs-page-utilities {
      margin-inline-end: calc(1.25rem - var(--docs-page-padding-x));
    }
    .cookie-settings {
      min-height: 2.75rem;
      padding-block: 0.8125rem;
    }
    .cookie-settings-row :global(.cookie-settings-icon) {
      inset-block-start: calc(0.8125rem + 0.15em);
    }
  }
</style>
