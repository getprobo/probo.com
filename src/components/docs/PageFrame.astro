---
import { Image } from "astro:assets";
import Logo from "../../assets/probo-logo.svg";
import WhiteLogo from "../../assets/probo_white_logo.svg";
import MobileMenuToggle from "virtual:starlight/components/MobileMenuToggle";
import Search from "virtual:starlight/components/Search";
import Icon from "../Icon.astro";
import SectionNav from "./SectionNav.astro";
import ThemeToggle from "./ThemeToggle.astro";

const hasCookieBanner = Boolean(
  import.meta.env.PUBLIC_COOKIE_BANNER_ID &&
  import.meta.env.PUBLIC_COOKIE_BANNER_API_BASE_URL,
);
const isHome = Astro.url.pathname.replace(/\/$/, "") === "/docs";
---

<div class="docs-chrome">
  <header class="docs-masthead">
    <div class="docs-brand">
      <MobileMenuToggle />
      <a class="docs-logo" href="/" aria-label="Probo home">
        <Image
          class="docs-logo-light"
          src={Logo}
          alt="Probo"
          width={85}
          height={24}
        />
        <Image
          class="docs-logo-dark"
          src={WhiteLogo}
          alt="Probo"
          width={85}
          height={24}
        />
      </a>
      <span class="docs-brand-divider" aria-hidden="true"></span>
      <a class="docs-brand-title" href="/docs">Documentation</a>
    </div>
    <div class="docs-masthead-actions">
      <Search class="docs-chrome-search" />
      <ThemeToggle />
      <a class="docs-website-link" href="/">
        Probo.com <Icon name="arrow-right" size={14} />
      </a>
    </div>
  </header>
  <div class="docs-horizon">
    <div class="docs-subnav"><SectionNav /></div>
  </div>
</div>

<div
  transition:animate="none"
  class:list={["docs-shell", { "docs-shell--home": isHome }]}
>
  <div class="docs-main">
    <nav
      id="starlight__sidebar"
      class="sidebar"
      aria-label={Astro.locals.t("sidebarNav.accessibleLabel")}
    >
      <slot name="sidebar" />
    </nav>
    <div class="docs-content"><slot /></div>
  </div>
  <footer class="docs-site-footer">
    <a href="/docs" class="docs-footer-home">Probo documentation</a>
    <div>
      <a href="https://github.com/getprobo/probo.com">Edit and contribute</a>
      {
        hasCookieBanner && (
          <probo-settings-link class="cookie-settings">
            <a href="#">Cookie settings</a>
          </probo-settings-link>
        )
      }
    </div>
  </footer>
</div>

{
  hasCookieBanner && (
    <probo-cookie-banner
      banner-id={import.meta.env.PUBLIC_COOKIE_BANNER_ID}
      base-url={import.meta.env.PUBLIC_COOKIE_BANNER_API_BASE_URL}
      position="bottom-right"
    />
  )
}

<script>
  import { initDocsMotion } from "./docs-motion";
  initDocsMotion();
</script>
