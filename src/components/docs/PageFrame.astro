---
import { Image } from "astro:assets";
import Logo from "../../assets/probo-logo.svg";
import WhiteLogo from "../../assets/probo_white_logo.svg";
import MobileMenuToggle from "virtual:starlight/components/MobileMenuToggle";
import Search from "virtual:starlight/components/Search";
import Button from "../ui/Button.svelte";
import ThemeToggle from "./ThemeToggle.astro";
import {
  getDocsSection,
  getDocsSectionForPath,
  normalizeDocsPath,
} from "../../lib/docs-navigation";

const hasCookieBanner = Boolean(
  import.meta.env.PUBLIC_COOKIE_BANNER_ID &&
  import.meta.env.PUBLIC_COOKIE_BANNER_API_BASE_URL,
);
const isHome = normalizeDocsPath(Astro.url.pathname) === "/docs";
const section = getDocsSection(getDocsSectionForPath(Astro.url.pathname));
---

<div class="docs-chrome">
  <header class="docs-masthead">
    <div class="docs-brand">
      <MobileMenuToggle />
      <a class="docs-logo" href="/" aria-label="Probo home">
        <Image
          class="docs-logo-light"
          src={Logo}
          alt="Probo"
          width={85}
          height={24}
        />
        <Image
          class="docs-logo-dark"
          src={WhiteLogo}
          alt="Probo"
          width={85}
          height={24}
        />
      </a>
      <span class="docs-brand-separator" aria-hidden="true"></span>
      <a
        class="docs-home-link"
        href="/docs"
        aria-label={`${section.label} — documentation home`}
      >
        {section.label}
      </a>
    </div>
    <Search class="docs-chrome-search" />
    <div class="docs-masthead-actions">
      <ThemeToggle />
      <Button href="/contact" class="docs-compliant">Get compliant</Button>
    </div>
  </header>
</div>

<div
  transition:animate="none"
  class:list={["docs-shell", { "docs-shell--home": isHome }]}
>
  <div class="docs-main">
    <nav
      id="starlight__sidebar"
      class="sidebar"
      aria-label={Astro.locals.t("sidebarNav.accessibleLabel")}
    >
      <slot name="sidebar" />
    </nav>
    <div class="docs-content"><slot /></div>
  </div>
</div>

{
  hasCookieBanner && (
    <probo-cookie-banner
      banner-id={import.meta.env.PUBLIC_COOKIE_BANNER_ID}
      base-url={import.meta.env.PUBLIC_COOKIE_BANNER_API_BASE_URL}
      position="bottom-right"
    />
  )
}

<script>
  import { initDocsMotion } from "./docs-motion";
  initDocsMotion();
</script>
