---
const hasToc = Boolean(Astro.locals.starlightRoute.toc);
---

<div class:list={["docs-body", { "docs-body--with-toc": hasToc }]}>
  <div class="docs-main-pane"><slot /></div>
  {
    hasToc && (
      <aside class="docs-toc-pane">
        <slot name="right-sidebar" />
      </aside>
    )
  }
</div>
