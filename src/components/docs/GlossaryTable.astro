---
import Icon from "../Icon.astro";

interface Props {
  id?: string;
  placeholder?: string;
}

const { id = "glossary-search", placeholder = "Filter glossary…" } =
  Astro.props;
---

<glossary-table class="glossary-table not-content">
  <div class="glossary-table__scroll">
    <table>
      <thead>
        <tr>
          <th scope="col">Glossary term</th>
          <th scope="col">Definition</th>
        </tr>
        <tr class="glossary-table__filters">
          <th scope="row">
            <label class="sr-only" for={id}>Filter glossary terms</label>
            <span class="glossary-table__search">
              <Icon name="magnifying-glass" size={16} />
              <input
                id={id}
                type="search"
                placeholder={placeholder}
                autocomplete="off"
                aria-controls={`${id}-body`}
              />
            </span>
          </th>
          <th></th>
        </tr>
      </thead>
      <tbody id={`${id}-body`}>
        <slot />
        <tr class="glossary-table__empty" hidden>
          <td colspan="2">No glossary terms match your search.</td>
        </tr>
      </tbody>
    </table>
  </div>
  <p class="sr-only" role="status" aria-live="polite"></p>
</glossary-table>

<script>
  import Fuse from "fuse.js";
  import { customElementDefine } from "../../lib/dom";

  interface GlossaryDocument {
    term: string;
    definition: string;
    row: HTMLTableRowElement;
  }

  class GlossaryTable extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready === "true") return;

      const input = this.querySelector<HTMLInputElement>(
        'input[type="search"]',
      );
      const rows = Array.from(
        this.querySelectorAll<HTMLTableRowElement>(
          "tbody > tr[data-glossary-row]",
        ),
      );
      const emptyRow = this.querySelector<HTMLTableRowElement>(
        ".glossary-table__empty",
      );
      const status = this.querySelector<HTMLElement>('[role="status"]');

      if (!input || !emptyRow || !status) return;

      const documents: GlossaryDocument[] = rows.map((row) => ({
        term: row.cells[0]?.textContent?.trim() ?? "",
        definition: row.cells[1]?.textContent?.trim() ?? "",
        row,
      }));
      const fuse = new Fuse(documents, {
        keys: [
          { name: "term", weight: 0.7 },
          { name: "definition", weight: 0.3 },
        ],
        threshold: 0.35,
        ignoreLocation: true,
        minMatchCharLength: 2,
      });

      const update = () => {
        const query = input.value.trim();
        const matches = query
          ? new Set(fuse.search(query).map(({ item }) => item.row))
          : new Set(rows);

        for (const row of rows) {
          row.hidden = !matches.has(row);
        }

        const resultCount = matches.size;
        emptyRow.hidden = resultCount !== 0;
        status.textContent = query
          ? `${resultCount} glossary ${
              resultCount === 1 ? "term" : "terms"
            } found.`
          : "";
      };

      input.addEventListener("input", update);
      this.dataset.ready = "true";
      update();
    }
  }

  customElementDefine("glossary-table", () => GlossaryTable);
</script>

<style>
  .glossary-table {
    display: block;
    margin-block: 1.5rem;
  }

  .glossary-table__scroll {
    overflow-x: auto;
  }

  table {
    width: 100%;
    min-width: 42rem;
    margin: 0;
    border: 0;
    border-collapse: separate;
    border-spacing: 0;
    background: transparent;
    box-shadow: none;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  th,
  :global(td) {
    padding: 1.15rem 1.25rem;
    border: 0;
    border-bottom: 1px solid var(--color-border-low);
    text-align: left;
    vertical-align: top;
  }

  th:first-child,
  :global(td:first-child) {
    width: 34%;
  }

  thead > tr:first-child th {
    padding: 0 1.25rem 0.5rem;
    border: 0;
    background: transparent;
    color: var(--color-quaternary);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .glossary-table__filters th {
    padding: 0.5rem 0.75rem;
    border-top: 1px solid var(--color-border-low);
    background: var(--color-subtle);
  }

  .glossary-table__filters th:first-child {
    border-left: 1px solid var(--color-border-low);
    border-top-left-radius: 0.5rem;
  }

  .glossary-table__filters th:last-child {
    border-right: 1px solid var(--color-border-low);
    border-top-right-radius: 0.5rem;
  }

  .glossary-table__search {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    width: min(100%, 18.5rem);
    padding-inline: 0.6rem;
    border: 1px solid var(--color-border-mid);
    border-radius: 0.3125rem;
    background: var(--docs-surface-raised);
    color: var(--color-quaternary);
    box-shadow: 0 1px 2px rgb(20 30 18 / 0.04);
  }

  .glossary-table__search:focus-within {
    border-color: var(--docs-focus);
    outline: 2px solid var(--docs-focus);
    outline-offset: 1px;
  }

  input {
    width: 100%;
    min-width: 0;
    padding-block: 0.3rem;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--color-primary);
    font: inherit;
    font-weight: 400;
  }

  input::placeholder {
    color: var(--color-quaternary);
  }

  input::-webkit-search-cancel-button {
    cursor: pointer;
  }

  tbody :global(td:first-child) {
    border-left: 1px solid var(--color-border-low);
  }

  tbody :global(td:last-child) {
    border-right: 1px solid var(--color-border-low);
  }

  tbody :global(tr:nth-child(even)) {
    background: color-mix(
      in srgb,
      var(--color-subtle) 72%,
      var(--docs-surface-raised)
    );
  }

  tbody :global(tr:nth-child(odd)) {
    background: var(--docs-surface-raised);
  }

  tbody :global(tr:last-child:not([hidden]) td) {
    border-bottom: 1px solid var(--color-border-low);
  }

  tbody :global(tr:last-child:not([hidden]) td:first-child) {
    border-bottom-left-radius: 0.5rem;
  }

  tbody :global(tr:last-child:not([hidden]) td:last-child) {
    border-bottom-right-radius: 0.5rem;
  }

  tbody :global(td:first-child) {
    color: var(--color-primary);
    font-weight: 450;
  }

  tbody :global(a) {
    color: var(--color-primary);
    text-decoration-color: color-mix(
      in srgb,
      var(--docs-accent) 75%,
      transparent
    );
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }

  tbody :global(tr[hidden]),
  .glossary-table__empty[hidden] {
    display: none;
  }

  .glossary-table__empty td {
    padding-block: 2rem;
    color: var(--color-quaternary);
    text-align: center;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 39.999rem) {
    .glossary-table__scroll {
      margin-inline: calc(var(--docs-page-padding-x) * -1);
    }
  }
  @media (max-width: 39.999rem) {
    table {
      min-width: 0;
      font-size: 0.875rem;
    }
    th,
    :global(td) {
      padding: 0.875rem 0.75rem;
      overflow-wrap: anywhere;
    }
    th:first-child,
    :global(td:first-child) {
      width: 32%;
    }
    .glossary-table__filters input {
      min-height: 2.75rem;
      font-size: 1rem;
    }
  }
</style>
