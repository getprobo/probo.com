---
import Icon from "../Icon.astro";

type Props = { class?: string };
const { class: className } = Astro.props;
---

<docs-theme-toggle class:list={["theme-toggle", className]}>
  <button
    type="button"
    class="theme-toggle-trigger"
    data-theme-trigger
    aria-label="Switch to dark mode"
    title="Switch to dark mode"
  >
    <span data-theme-icon="light"><Icon name="sun" size={16} /></span>
    <span data-theme-icon="dark"><Icon name="moon" size={16} /></span>
  </button>
</docs-theme-toggle>

<style>
  .theme-toggle {
    display: inline-flex;
    flex-shrink: 0;
  }
  .theme-toggle-trigger {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    border-radius: 0.5rem;
    color: var(--color-muted-foreground);
    background: transparent;
    cursor: pointer;
  }
  .theme-toggle-trigger:hover {
    color: var(--color-primary);
    background: var(--color-subtle);
  }
  [data-theme-icon] {
    display: grid;
    place-items: center;
  }
  .theme-toggle-trigger:focus-visible {
    outline: 2px solid var(--docs-focus);
    outline-offset: 3px;
  }
</style>

<style is:global>
  html[data-theme="light"] [data-theme-icon="dark"],
  html[data-theme="dark"] [data-theme-icon="light"] {
    display: none;
  }
  html[data-theme-switching] *,
  html[data-theme-switching] *::before,
  html[data-theme-switching] *::after {
    transition: none !important;
  }
</style>

<script>
  import { customElementDefine } from "../../lib/dom";
  type Theme = "auto" | "dark" | "light";
  const storageKey = "starlight-theme";
  const loadTheme = (): Theme => {
    try {
      const theme = localStorage.getItem(storageKey);
      return theme === "dark" || theme === "light" ? theme : "auto";
    } catch {
      return "auto";
    }
  };
  let preference = loadTheme();
  const colorScheme = matchMedia("(prefers-color-scheme: light)");
  const applyTheme = () => {
    const root = document.documentElement;
    const resolved =
      preference === "auto"
        ? colorScheme.matches
          ? "light"
          : "dark"
        : preference;
    if (root.dataset.theme !== resolved) {
      root.dataset.themeSwitching = "";
      root.dataset.theme = resolved;
      requestAnimationFrame(() =>
        requestAnimationFrame(() => delete root.dataset.themeSwitching),
      );
    }
    const label = `Switch to ${resolved === "light" ? "dark" : "light"} mode`;
    for (const trigger of document.querySelectorAll("[data-theme-trigger]")) {
      trigger.setAttribute("aria-label", label);
      trigger.setAttribute("title", label);
    }
  };
  colorScheme.addEventListener("change", () => {
    if (preference === "auto") applyTheme();
  });
  window.addEventListener("storage", (event) => {
    if (event.key === storageKey || event.key === null) {
      preference = loadTheme();
      applyTheme();
    }
  });

  class DocsThemeToggle extends HTMLElement {
    trigger = this.querySelector<HTMLButtonElement>("[data-theme-trigger]")!;
    connectedCallback() {
      applyTheme();
      this.trigger.addEventListener("click", this.toggle);
    }
    disconnectedCallback() {
      this.trigger.removeEventListener("click", this.toggle);
    }
    toggle = () => {
      preference =
        document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      try {
        localStorage.setItem(storageKey, preference);
      } catch {}
      applyTheme();
    };
  }
  customElementDefine("docs-theme-toggle", () => DocsThemeToggle);
</script>
