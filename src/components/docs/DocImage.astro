---
import { fileURLToPath } from "node:url";
import sharp from "sharp";

interface Props {
  src: string;
  alt: string;
  width?: number;
  caption?: string;
}

const { src, alt, width, caption } = Astro.props;
const publicRoot = new URL("../../../public/", import.meta.url);
const imageURL = new URL(`.${src}`, publicRoot);
if (
  !src.startsWith("/docs/") ||
  !imageURL.pathname.startsWith(publicRoot.pathname)
) {
  throw new Error(`DocImage requires a local /docs/ image: ${src}`);
}
const metadata = await sharp(fileURLToPath(imageURL)).metadata();
if (!metadata.width || !metadata.height)
  throw new Error(`Missing image size: ${src}`);
if (width !== undefined && (!Number.isFinite(width) || width <= 0)) {
  throw new Error(`Invalid DocImage display width: ${width}`);
}
const fragment = width !== undefined;
const ratio = metadata.height / metadata.width;
---

<figure
  class:list={["docs-media", { "docs-media-fragment": fragment }]}
  style={fragment
    ? { "--media-useful-width": `${width}px`, "--media-ratio": ratio }
    : undefined}
>
  <div class="docs-media-frame">
    <a
      class="docs-media-link"
      href={src}
      aria-label={`Open full-size image: ${alt}`}
    >
      <img
        class="docs-media-image"
        src={src}
        alt={alt}
        width={metadata.width}
        height={metadata.height}
        loading="lazy"
        decoding="async"
      />
    </a>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .docs-media {
    width: 100%;
    margin: 1.5rem 0;
    container-type: inline-size;
  }
  .docs-media-frame {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: 0.5rem;
  }
  .docs-media-link {
    display: block;
    width: 100%;
    margin: 0 auto;
  }
  .docs-media .docs-media-image {
    display: block;
    width: 100%;
    height: auto;
    max-height: none;
    margin: 0;
    border-radius: 0.375rem;
    outline: none;
  }
  .docs-media-fragment .docs-media-frame {
    --media-width: min(100cqi, var(--media-useful-width));
    --media-height: calc(var(--media-width) * var(--media-ratio));
    --media-cap: clamp(32px, calc(32px + (100cqi - 400px) * 0.48), 128px);
    --media-pad: max(
      0px,
      min(
        var(--media-cap),
        calc((100cqi - var(--media-width)) / 2),
        calc((100cqi - var(--media-height)) / 2)
      )
    );
    padding-block: var(--media-pad, 32px);
    background: #f3f3f1;
  }
  .docs-media-fragment .docs-media-link {
    width: min(100%, var(--media-useful-width));
  }
  .docs-media-link:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: -2px;
    border-radius: 0.375rem;
  }
  .docs-media figcaption {
    margin-top: 0.75rem;
    color: var(--sl-color-gray-2);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  @media (forced-colors: active) {
    .docs-media-frame {
      outline: 1px solid CanvasText;
    }
  }
  @media print {
    .docs-media-fragment .docs-media-frame {
      padding-block: 1rem;
      background: transparent;
    }
  }
</style>
