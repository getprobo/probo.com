---
import MobileTableOfContents from "virtual:starlight/components/MobileTableOfContents";
import TableOfContents from "virtual:starlight/components/TableOfContents";
---

{
  Astro.locals.starlightRoute.toc && (
    <aside class="right-sidebar text-sm">
      <div class="right-sidebar__mobile">
        <MobileTableOfContents />
      </div>
      <div class="right-sidebar__desktop">
        <TableOfContents />
      </div>
    </aside>
  )
}

<script>
  type StarlightToc = HTMLElement & { _current?: Element | null };

  const tableOfContents = () =>
    document.querySelectorAll<StarlightToc>("starlight-toc");

  const setCurrent = (toc: StarlightToc, link: Element | undefined) => {
    if (!link || link.getAttribute("aria-current") === "true") return;
    for (const other of toc.querySelectorAll("a"))
      other.removeAttribute("aria-current");
    link.setAttribute("aria-current", "true");
    // Keep Starlight's own pointer in sync so it clears our highlight later.
    toc._current = link;
  };

  /** Bottom of the band Starlight's intersection observer watches. */
  const observedBandBottom = (toc: StarlightToc) => {
    const navBarHeight =
      document.querySelector("header")?.getBoundingClientRect().height || 0;
    const mobileTocHeight =
      toc.querySelector("summary")?.getBoundingClientRect().height || 0;
    return navBarHeight + mobileTocHeight + 32 + 53;
  };

  const headingIdsInHiddenTabPanels = () => {
    const ids = new Set<string>();
    for (const panel of document.querySelectorAll<HTMLElement>(
      '[role="tabpanel"][hidden]',
    )) {
      for (const heading of panel.querySelectorAll<HTMLElement>(
        "h2[id], h3[id], h4[id]",
      )) {
        if (heading.id) ids.add(heading.id);
      }
    }
    return ids;
  };

  /** Hide TOC entries for headings that live in inactive tab panels. */
  const syncTocWithTabs = () => {
    const hiddenIds = headingIdsInHiddenTabPanels();
    for (const toc of tableOfContents()) {
      for (const link of toc.querySelectorAll<HTMLAnchorElement>(
        "a[href^='#']",
      )) {
        const id = decodeURIComponent(link.hash.slice(1));
        const item = link.closest("li");
        if (!item) continue;
        item.hidden = hiddenIds.has(id);
      }
    }
  };

  const visibleTocLinks = (toc: StarlightToc) =>
    [...toc.querySelectorAll<HTMLAnchorElement>("a")].filter(
      (link) => !link.closest("li")?.hidden,
    );

  // Starlight only highlights a heading once it crosses that band, so a freshly
  // loaded page stays unhighlighted until the first scroll.
  const highlightHeadingAtRest = () => {
    for (const toc of tableOfContents()) {
      if (toc.querySelector('li:not([hidden]) a[aria-current="true"]'))
        continue;

      const links = visibleTocLinks(toc);
      const bottom = observedBandBottom(toc);
      let current = links[0];

      for (const link of links) {
        const heading = document.getElementById(
          decodeURIComponent(link.hash.slice(1)),
        );
        if (!heading) continue;
        if (heading.getBoundingClientRect().top > bottom) break;
        current = link;
      }

      setCurrent(toc, current);
    }
  };

  const highlightLastHeading = () => {
    const scrolled = window.innerHeight + window.scrollY;
    if (scrolled < document.documentElement.scrollHeight - 2) return;

    for (const toc of tableOfContents()) {
      const links = visibleTocLinks(toc);
      setCurrent(toc, links[links.length - 1]);
    }
  };

  let queued = false;
  const schedule = () => {
    if (queued) return;
    queued = true;
    requestAnimationFrame(() => {
      queued = false;
      highlightLastHeading();
    });
  };

  const watchTabPanels = () => {
    for (const panel of document.querySelectorAll<HTMLElement>(
      '[role="tabpanel"]',
    )) {
      if (panel.dataset.proboTocTabWatched !== undefined) continue;
      panel.dataset.proboTocTabWatched = "";
      new MutationObserver(() => {
        syncTocWithTabs();
        highlightHeadingAtRest();
      }).observe(panel, { attributes: true, attributeFilter: ["hidden"] });
    }
  };

  const init = () => {
    syncTocWithTabs();
    highlightHeadingAtRest();
    watchTabPanels();

    // Starlight's intersection observer can overwrite the highlight after a scroll.
    for (const toc of tableOfContents()) {
      if (toc.dataset.proboTocWatched !== undefined) continue;
      toc.dataset.proboTocWatched = "";
      new MutationObserver(schedule).observe(toc, {
        subtree: true,
        attributeFilter: ["aria-current"],
      });
    }
  };

  window.addEventListener("scroll", schedule, { passive: true });
  document.addEventListener("astro:page-load", init);
  init();
</script>

<style>
  @layer starlight.core {
    .right-sidebar {
      width: 100%;
    }

    .right-sidebar__desktop {
      display: none;
    }

    .right-sidebar :global(h2) {
      color: var(--sl-color-white);
      font-weight: 600;
      line-height: var(--sl-line-height-headings);
      margin-bottom: 0.5rem;
    }
    .right-sidebar :global(:where(a)) {
      display: block;
      text-decoration: none;
      color: var(--sl-color-gray-3);
      overflow-wrap: anywhere;
    }
    .right-sidebar :global(:where(a):hover) {
      color: var(--sl-color-white);
    }
    .right-sidebar :global(a[aria-current="true"]) {
      color: var(--color-primary);
      font-weight: 600;
    }

    .right-sidebar__desktop :global(ul) {
      display: grid;
      gap: 0.5rem;
    }

    .right-sidebar__desktop :global(li > ul) {
      margin-block-start: 0.5rem;
    }

    .right-sidebar__desktop :global(a) {
      padding-block: 0.125rem;
      padding-inline: 0;
      line-height: 1.45;
    }

    .right-sidebar__desktop :global(li:not([style*="--depth: 0"])) {
      border-inline-start: 1px solid var(--color-border-low);
    }

    .right-sidebar__desktop :global(li:not([style*="--depth: 0"]) > a) {
      padding-inline-start: 1rem;
    }

    .right-sidebar :global(nav) {
      left: 0;
      width: 100%;
      border: none;
      background-color: var(--color-level-0);
    }

    @media (max-width: 79.999rem) {
      .right-sidebar :global(nav) {
        border-bottom: solid 1px var(--color-border-low);
      }
    }

    @media (min-width: 80rem) {
      .right-sidebar__mobile {
        display: none;
      }

      .right-sidebar__desktop {
        display: block;
      }

      .right-sidebar :global(nav) {
        background-color: transparent;
      }
    }
  }
</style>
