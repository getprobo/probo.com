import Sparkle from "@phosphor-icons/core/regular/sparkle.svg?raw";
import Sun from "@phosphor-icons/core/regular/sun.svg?raw";
import TerminalWindow from "@phosphor-icons/core/regular/terminal-window.svg?raw";
import UsersThree from "@phosphor-icons/core/regular/users-three.svg?raw";
import X from "@phosphor-icons/core/regular/x.svg?raw";
import Plus from "@phosphor-icons/core/regular/plus.svg?raw";
import Minus from "@phosphor-icons/core/regular/minus.svg?raw";
import MinusBold from "@phosphor-icons/core/bold/minus-bold.svg?raw";
import WrenchBold from "@phosphor-icons/core/bold/wrench-bold.svg?raw";
import MinusLight from "@phosphor-icons/core/light/minus-light.svg?raw";
import WrenchLight from "@phosphor-icons/core/light/wrench-light.svg?raw";
import Wrench from "@phosphor-icons/core/regular/wrench.svg?raw";
import Check from "@phosphor-icons/core/regular/check.svg?raw";
import CheckBold from "@phosphor-icons/core/bold/check-bold.svg?raw";
import CheckCircleFill from "@phosphor-icons/core/fill/check-circle-fill.svg?raw";
import XCircleFill from "@phosphor-icons/core/fill/x-circle-fill.svg?raw";
import DownloadSimple from "@phosphor-icons/core/regular/download-simple.svg?raw";
import LinkedinLogo from "@phosphor-icons/core/regular/linkedin-logo.svg?raw";
import Megaphone from "@phosphor-icons/core/regular/megaphone.svg?raw";
import RocketLaunch from "@phosphor-icons/core/regular/rocket-launch.svg?raw";
import SealCheck from "@phosphor-icons/core/regular/seal-check.svg?raw";

import Broadcast from "@phosphor-icons/core/regular/broadcast.svg?raw";
import Cloud from "@phosphor-icons/core/regular/cloud.svg?raw";
import Fingerprint from "@phosphor-icons/core/regular/fingerprint.svg?raw";
import FlowArrow from "@phosphor-icons/core/regular/flow-arrow.svg?raw";
import Graph from "@phosphor-icons/core/regular/graph.svg?raw";
import Key from "@phosphor-icons/core/regular/key.svg?raw";
import PlugsConnected from "@phosphor-icons/core/regular/plugs-connected.svg?raw";
import ShieldWarning from "@phosphor-icons/core/regular/shield-warning.svg?raw";
import SlidersHorizontal from "@phosphor-icons/core/regular/sliders-horizontal.svg?raw";

const icons = {
  broadcast: Broadcast,
  cloud: Cloud,
  fingerprint: Fingerprint,
  "flow-arrow": FlowArrow,
  graph: Graph,
  key: Key,
  "plugs-connected": PlugsConnected,
  "shield-warning": ShieldWarning,
  "sliders-horizontal": SlidersHorizontal,

  article: Article,
  "arrow-right": ArrowRight,
  bell: Bell,
  "book-open-text": BookOpenText,
  briefcase: Briefcase,
  "caret-down": CaretDown,
  "caret-right": CaretRight,
  "chats-circle": ChatsCircle,
  "clock-counter-clockwise": ClockCounterClockwise,
  code: Code,
  compass: Compass,
  copy: Copy,
  cookie: Cookie,
  files: Files,
  "github-logo": GithubLogo,
  handshake: Handshake,
  heart: Heart,
  info: Info,
  list: List,
  "list-checks": ListChecks,
  "magnifying-glass": MagnifyingGlass,
  "markdown-logo": MarkdownLogo,
  monitor: Monitor,
  moon: Moon,
  "newspaper-clipping": NewspaperClipping,
  notepad: Notepad,
  "paint-brush": PaintBrush,
  question: Question,
  quotes: Quotes,
  "shield-check": ShieldCheck,
  sparkle: Sparkle,
  sun: Sun,
  "terminal-window": TerminalWindow,
  "users-three": UsersThree,
  x: X,
  check: Check,
  "check-bold": CheckBold,
  "check-circle-fill": CheckCircleFill,
  "x-circle-fill": XCircleFill,
  plus: Plus,
  minus: Minus,
  "minus-bold": MinusBold,
  "wrench-bold": WrenchBold,
  "minus-light": MinusLight,
  "wrench-light": WrenchLight,
  wrench: Wrench,
  "download-simple": DownloadSimple,
  "linkedin-logo": LinkedinLogo,
  megaphone: Megaphone,
  "rocket-launch": RocketLaunch,
  "seal-check": SealCheck,
} as const;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  size?: number | string;
  class?: string;
  label?: string;
}

const { name, size = 24, class: className, label } = Astro.props;
const content = icons[name]
  .replace(/^<svg[^>]*>/, "")
  .replace(/<\/svg>\s*$/, "");
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 256 256"
  width={size}
  height={size}
  fill="currentColor"
  class={className}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  set:html={content}
/>
