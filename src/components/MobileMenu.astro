---
import {
  directMenuItems,
  menuGroups,
  pricingMenuItem,
} from "../content/menu.ts";
import Icon from "./Icon.astro";
import MenuIcon from "./MenuIcon.astro";

interface Props {
  id?: string;
}

const { id } = Astro.props;
---

<dialog
  {id}
  class="bg-secondary group fixed inset-x-0 top-14 bottom-0 z-50 m-0 h-auto max-h-none w-full max-w-none overflow-y-auto border-0 px-5 pt-6 pb-28 transition-all transition-discrete duration-300 not-open:opacity-0 starting:opacity-0"
>
  <a
    href={pricingMenuItem.href}
    class="mb-7 flex items-center gap-4 border-b pb-5"
  >
    <span class="flex min-w-0 flex-1 flex-col gap-0.5">
      <span class="text-lg font-medium">{pricingMenuItem.label}</span>
      <span class="text-muted-foreground text-sm"
        >{pricingMenuItem.description}</span
      >
    </span>
    <Icon name="caret-right" size={20} class="text-muted-foreground" />
  </a>
  {
    menuGroups.map((group) => (
      <section class="mb-7">
        {group.showLabel !== false && (
          <h2 class="text-muted-foreground border-b pb-2 text-xs font-medium tracking-wider uppercase">
            {group.label}
          </h2>
        )}
        {group.items.map((item) => (
          <a href={item.href} class="flex items-center gap-4 border-b py-4">
            <span class="grid size-11 shrink-0 place-items-center rounded-lg border">
              <MenuIcon name={item.icon} />
            </span>
            <span class="flex min-w-0 flex-1 flex-col gap-0.5">
              <span class="text-lg font-medium">{item.label}</span>
              <span class="text-muted-foreground truncate text-sm">
                {item.description}
              </span>
            </span>
            <Icon name="caret-right" size={20} class="text-muted-foreground" />
          </a>
        ))}
      </section>
    ))
  }
  <section>
    <h2
      class="text-muted-foreground border-b pb-2 text-xs font-medium tracking-wider uppercase"
    >
      Explore
    </h2>
    {
      directMenuItems.map((item) => (
        <a href={item.href} class="flex items-center gap-4 border-b py-4">
          <span class="grid size-11 shrink-0 place-items-center rounded-lg border">
            <MenuIcon name={item.icon} />
          </span>
          <span class="flex min-w-0 flex-1 flex-col gap-0.5">
            <span class="text-lg font-medium">{item.label}</span>
            <span class="text-muted-foreground truncate text-sm">
              {item.description}
            </span>
          </span>
          <Icon name="caret-right" size={20} class="text-muted-foreground" />
        </a>
      ))
    }
  </section>
</dialog>
