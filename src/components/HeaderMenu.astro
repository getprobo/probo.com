---
import type { MenuGroup } from "../content/menu";
import Icon from "./Icon.astro";
import MenuIcon from "./MenuIcon.astro";
import Button from "./ui/Button.svelte";

interface Props {
  groups: MenuGroup[];
}

const { groups } = Astro.props;
const menuId = "desktop-navigation-menu";
---

<header-menu class="relative flex h-8 items-center gap-2.25">
  {
    groups.map((group, index) => {
      const triggerId = `${menuId}-trigger-${index}`;

      return (
        <Button
          variant="navigation"
          size="navigation"
          type={group.href ? undefined : "button"}
          href={group.href}
          id={triggerId}
          data-menu-trigger
          data-menu-index={index}
          aria-expanded="false"
          aria-controls={menuId}
        >
          {group.label}
          <Icon name="caret-down" size={14} />
        </Button>
      );
    })
  }

  <div
    data-hover-corridor
    class="fixed top-12 left-1/2 z-10 h-7 w-[min(896px,calc(100vw-40px))] -translate-x-1/2"
    hidden
  >
  </div>

  <div
    id={menuId}
    data-menu-viewport
    class="fixed top-16 left-1/2 z-10 w-[min(896px,calc(100vw-40px))] pt-3"
    hidden
  >
    <div
      data-menu-shell
      class="bg-secondary relative h-111 overflow-hidden rounded-2xl shadow-[inset_0_0_0_1px_var(--color-border-low),0_16px_32px_rgba(186,193,122,0.2)]"
    >
      {
        groups.map((group, index) => (
          <div
            data-menu-panel
            data-menu-index={index}
            data-products-panel={group.label === "Products" ? "" : undefined}
            role="group"
            aria-labelledby={`${menuId}-trigger-${index}`}
            class="absolute top-0 grid h-full grid-cols-[minmax(0,1fr)_420px] items-start gap-8 p-3"
            hidden
          >
            <div
              class:list={[
                "flex min-w-0 flex-col items-start self-start px-2",
                group.label === "Products" ? "gap-2 py-3" : "gap-6 py-5",
              ]}
            >
              {group.showLabel !== false && (
                <p class="text-muted-foreground px-3 text-sm font-medium">
                  {group.label}
                </p>
              )}
              <div
                class:list={[
                  "w-full",
                  group.label === "Products"
                    ? "grid grid-flow-col grid-cols-2 gap-x-8"
                    : "flex flex-col",
                ]}
                style={
                  group.label === "Products"
                    ? `grid-template-rows: repeat(${Math.ceil(group.items.length / 2)}, auto)`
                    : undefined
                }
              >
                {group.items.map((item) => (
                  <a
                    href={item.href}
                    class="navigation-menu-link relative isolate flex min-w-0 items-center gap-4 rounded-2xl p-3 outline-none"
                  >
                    <span class="grid size-12 shrink-0 place-items-center rounded-[10px] border">
                      <MenuIcon name={item.icon} />
                    </span>
                    <span class="min-w-0 text-base leading-6">
                      <span class="block truncate font-semibold">
                        {item.label}
                      </span>
                      <span class="text-muted-foreground block truncate">
                        {item.description}
                      </span>
                    </span>
                  </a>
                ))}
              </div>
            </div>

            <a
              href={group.feature.href}
              class="bg-subtle group/feature relative block size-105 shrink-0 overflow-hidden rounded-lg outline-none focus-visible:ring-2 focus-visible:ring-current"
              aria-label={`${group.feature.eyebrow}: ${group.feature.title}`}
            >
              <img
                data-feature-image
                data-src={group.feature.asset}
                alt={group.feature.alt}
                width={group.feature.variant === "illustration" ? 344 : 1080}
                height={group.feature.variant === "illustration" ? 420 : 720}
                decoding="async"
                fetchpriority="low"
                class:list={[
                  "navigation-feature-media absolute max-w-none",
                  group.feature.variant === "story" &&
                    "navigation-feature-media--story inset-0 size-full object-cover",
                  group.feature.variant === "product" &&
                    "navigation-feature-media--product top-25 left-6 h-180 w-270 rounded-[15px] object-cover object-top-left shadow-[0_16px_32px_rgba(186,193,122,0.2)]",
                  group.feature.variant === "illustration" &&
                    "navigation-feature-media--illustration top-0 left-0 z-1 h-auto w-full",
                  group.feature.variant === "guide" &&
                    "navigation-feature-media--guide top-25 -left-43.5 h-55 w-193.5",
                ]}
              />

              {group.feature.variant === "story" && (
                <div class="absolute inset-0 bg-linear-to-b from-[rgba(0,0,0,0.72)] via-[rgba(0,0,0,0.05)] to-[rgba(0,0,0,0.35)]" />
              )}
              {group.feature.variant !== "story" && (
                <span
                  class:list={[
                    "navigation-feature-halo",
                    group.feature.variant === "illustration" &&
                      "navigation-feature-halo--behind",
                  ]}
                  aria-hidden="true"
                />
              )}

              <span
                class:list={[
                  "absolute top-5 right-5 left-5 z-10 flex flex-col items-start gap-1 [word-break:break-word]",
                  { "text-[#fff]": group.feature.variant === "story" },
                  { "sr-only": group.feature.variant === "illustration" },
                ]}
              >
                <span
                  class:list={[
                    "text-sm leading-5 font-medium",
                    group.feature.variant === "story"
                      ? "text-[#e6ff03]"
                      : "text-muted-foreground",
                  ]}
                >
                  {group.feature.eyebrow}
                </span>
                <span class="text-[20px] leading-7 font-semibold tracking-[-0.4px]">
                  {group.feature.title}
                </span>
              </span>
            </a>
          </div>
        ))
      }
    </div>
  </div>
</header-menu>

<script>
  import { customElementDefine } from "../lib/dom";

  const closeDelay = 160;
  const shellDuration = 180;
  const contentPhaseDuration = 120;
  const contentTravelDistance = 48;
  const easing = "cubic-bezier(0.22, 1, 0.36, 1)";

  class HeaderMenu extends HTMLElement {
    triggers: HTMLButtonElement[] = [];
    panels: HTMLElement[] = [];
    links: HTMLAnchorElement[] = [];
    viewport: HTMLElement | null = null;
    corridor: HTMLElement | null = null;
    activeIndex = -1;
    closeTimer: number | null = null;
    hideTimer: number | null = null;
    transitionToken = 0;
    lastPointerType = "";
    suppressNextFocus = false;

    connectedCallback() {
      this.triggers = Array.from(
        this.querySelectorAll<HTMLButtonElement>("[data-menu-trigger]"),
      );
      this.panels = Array.from(
        this.querySelectorAll<HTMLElement>("[data-menu-panel]"),
      );
      this.links = Array.from(
        this.querySelectorAll<HTMLAnchorElement>("[data-menu-panel] a"),
      );
      this.viewport = this.querySelector("[data-menu-viewport]");
      this.corridor = this.querySelector("[data-hover-corridor]");

      this.triggers.forEach((trigger) => {
        trigger.addEventListener("pointerenter", this.onTriggerPointerEnter);
        trigger.addEventListener("pointerdown", this.onTriggerPointerDown);
        trigger.addEventListener("focus", this.onTriggerFocus);
        trigger.addEventListener("click", this.onTriggerClick);
      });
      this.links.forEach((link) => link.addEventListener("click", this.close));
      this.addEventListener("pointerenter", this.cancelClose);
      this.addEventListener("pointerleave", this.scheduleClose);
      this.addEventListener("focusout", this.onFocusOut);
      document.addEventListener("pointerdown", this.onDocumentPointerDown);
      document.addEventListener("keydown", this.onKeyDown);
    }

    disconnectedCallback() {
      this.triggers.forEach((trigger) => {
        trigger.removeEventListener("pointerenter", this.onTriggerPointerEnter);
        trigger.removeEventListener("pointerdown", this.onTriggerPointerDown);
        trigger.removeEventListener("focus", this.onTriggerFocus);
        trigger.removeEventListener("click", this.onTriggerClick);
      });
      this.links.forEach((link) =>
        link.removeEventListener("click", this.close),
      );
      this.removeEventListener("pointerenter", this.cancelClose);
      this.removeEventListener("pointerleave", this.scheduleClose);
      this.removeEventListener("focusout", this.onFocusOut);
      document.removeEventListener("pointerdown", this.onDocumentPointerDown);
      document.removeEventListener("keydown", this.onKeyDown);
      this.cancelClose();
      if (this.hideTimer !== null) window.clearTimeout(this.hideTimer);
    }

    indexFromTrigger = (trigger: HTMLButtonElement) =>
      Number(trigger.dataset.menuIndex);

    onTriggerPointerEnter = (event: PointerEvent) => {
      if (event.pointerType === "touch") return;
      this.open(
        this.indexFromTrigger(event.currentTarget as HTMLButtonElement),
      );
    };

    onTriggerPointerDown = (event: PointerEvent) => {
      this.lastPointerType = event.pointerType;
    };

    onTriggerFocus = (event: FocusEvent) => {
      if (this.suppressNextFocus) {
        this.suppressNextFocus = false;
        return;
      }
      if (this.lastPointerType === "touch") return;
      this.open(
        this.indexFromTrigger(event.currentTarget as HTMLButtonElement),
      );
    };

    onTriggerClick = (event: MouseEvent) => {
      const index = this.indexFromTrigger(
        event.currentTarget as HTMLButtonElement,
      );
      if (
        this.lastPointerType === "touch" &&
        event.detail > 0 &&
        this.activeIndex === index
      ) {
        this.close();
        return;
      }
      this.open(index);
    };

    onFocusOut = (event: FocusEvent) => {
      if (!this.contains(event.relatedTarget as Node | null)) {
        this.scheduleClose();
      }
    };

    onDocumentPointerDown = (event: PointerEvent) => {
      if (!this.contains(event.target as Node)) this.close();
    };

    onKeyDown = (event: KeyboardEvent) => {
      if (event.key !== "Escape") {
        this.lastPointerType = "";
        return;
      }
      if (this.activeIndex === -1) return;
      event.preventDefault();
      const trigger = this.triggers[this.activeIndex];
      this.close();
      this.suppressNextFocus = true;
      trigger?.focus();
    };

    cancelClose = () => {
      if (this.closeTimer === null) return;
      window.clearTimeout(this.closeTimer);
      this.closeTimer = null;
    };

    scheduleClose = () => {
      this.cancelClose();
      this.closeTimer = window.setTimeout(() => {
        this.closeTimer = null;
        const hasVisibleFocus = this.querySelector(":focus-visible") !== null;
        if (!this.matches(":hover") && !hasVisibleFocus) {
          this.close();
        }
      }, closeDelay);
    };

    open = (index: number) => {
      if (!this.viewport || !this.panels[index]) return;
      this.cancelClose();
      const featureImage = this.panels[index].querySelector<HTMLImageElement>(
        "[data-feature-image]",
      );
      if (featureImage?.dataset.src && !featureImage.src) {
        featureImage.src = featureImage.dataset.src;
      }
      if (this.hideTimer !== null) {
        window.clearTimeout(this.hideTimer);
        this.hideTimer = null;
      }

      const previousIndex = this.activeIndex;
      if (previousIndex === index && this.dataset.open === "true") return;

      const wasOpen = this.dataset.open === "true";
      this.dataset.resizing = String(wasOpen);
      this.activeIndex = index;
      this.dataset.productsOpen = String(
        this.panels[index].hasAttribute("data-products-panel"),
      );
      if (!wasOpen) {
        this.panels.forEach((panel) => {
          panel.getAnimations().forEach((animation) => animation.cancel());
          panel.hidden = true;
        });
      }
      if (this.viewport.hidden) {
        this.dataset.open = "false";
        this.viewport.hidden = false;
        // Paint the closed state before starting the opening transition.
        this.viewport.getBoundingClientRect();
      }
      this.dataset.open = "true";
      if (this.corridor) this.corridor.hidden = false;
      this.triggers.forEach((trigger, triggerIndex) => {
        trigger.setAttribute(
          "aria-expanded",
          String(triggerIndex === this.activeIndex),
        );
      });

      this.transitionPanels(index);
    };

    transitionPanels = async (nextIndex: number) => {
      const nextPanel = this.panels[nextIndex];
      const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      const token = ++this.transitionToken;
      const visiblePanel = this.panels.find(
        (panel) => !panel.hidden && !panel.inert,
      );
      const visibleIndex = visiblePanel
        ? Number(visiblePanel.dataset.menuIndex)
        : nextIndex;
      const currentStyles = new Map(
        this.panels
          .filter((panel) => !panel.hidden)
          .map((panel) => {
            const style = getComputedStyle(panel);
            return [
              panel,
              { opacity: style.opacity, transform: style.transform },
            ];
          }),
      );

      this.panels.forEach((panel) => {
        panel.getAnimations().forEach((animation) => animation.cancel());
        if (panel !== visiblePanel && panel !== nextPanel) panel.hidden = true;
      });
      this.showPanel(nextPanel);

      if (reducedMotion || visiblePanel === nextPanel) {
        this.panels.forEach((panel) => (panel.hidden = panel !== nextPanel));
        return;
      }

      if (!visiblePanel) {
        nextPanel.animate([{ opacity: 0 }, { opacity: 1 }], {
          duration: shellDuration,
          easing,
        });
        return;
      }

      const direction = nextIndex > visibleIndex ? 1 : -1;
      visiblePanel.inert = true;
      visiblePanel.setAttribute("aria-hidden", "true");
      const exitAnimation = visiblePanel.animate(
        [
          currentStyles.get(visiblePanel)!,
          {
            opacity: 0,
            transform: `translateX(${-direction * contentTravelDistance}px)`,
          },
        ],
        {
          duration: contentPhaseDuration,
          easing,
          fill: "forwards",
        },
      );
      const enterAnimation = nextPanel.animate(
        [
          currentStyles.get(nextPanel) ?? {
            opacity: 0,
            transform: `translateX(${direction * contentTravelDistance}px)`,
          },
          { opacity: 1, transform: "translateX(0)" },
        ],
        { duration: contentPhaseDuration * 2, easing },
      );

      try {
        await exitAnimation.finished;
        if (token !== this.transitionToken) return;
        visiblePanel.hidden = true;
        exitAnimation.cancel();
        await enterAnimation.finished;
      } catch {
        return;
      }

      if (token === this.transitionToken && this.activeIndex === nextIndex) {
        this.showPanel(nextPanel);
      }
    };

    showPanel = (panel: HTMLElement) => {
      panel.hidden = false;
      panel.inert = false;
      panel.removeAttribute("aria-hidden");
    };

    close = () => {
      if (this.activeIndex === -1) return;
      this.cancelClose();
      this.transitionToken += 1;
      this.panels.forEach((panel, index) => {
        panel.getAnimations().forEach((animation) => animation.cancel());
        panel.hidden = index !== this.activeIndex;
      });
      this.activeIndex = -1;
      this.dataset.open = "false";
      this.triggers.forEach((trigger) =>
        trigger.setAttribute("aria-expanded", "false"),
      );

      this.hideTimer = window.setTimeout(() => {
        if (this.dataset.open === "true") return;
        if (this.viewport) this.viewport.hidden = true;
        if (this.corridor) this.corridor.hidden = true;
        this.panels.forEach((panel) => (panel.hidden = true));
        this.hideTimer = null;
      }, shellDuration);
    };
  }

  customElementDefine("header-menu", () => HeaderMenu);
</script>

<style>
  header-menu[data-resizing="true"] {
    --menu-resize-duration: 240ms;
  }

  [data-hover-corridor] {
    transition: width var(--menu-resize-duration, 0ms)
      cubic-bezier(0.22, 1, 0.36, 1);
  }

  header-menu[data-products-open="true"] [data-hover-corridor],
  header-menu[data-products-open="true"] [data-menu-viewport] {
    width: min(1332px, calc(100vw - 40px));
  }

  [data-menu-panel] {
    --panel-width: min(896px, calc(100vw - 40px));
    left: 50%;
    width: var(--panel-width);
    margin-left: calc(var(--panel-width) / -2);
  }

  [data-products-panel] {
    --panel-width: min(1332px, calc(100vw - 40px));
  }

  .navigation-menu-link::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    pointer-events: none;
    content: "";
    background: var(--color-subtle);
    opacity: 0;
    transform: scale(0.9);
    transition:
      opacity 280ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .navigation-menu-link:focus-visible::before {
    opacity: 1;
    transform: scale(1);
  }

  @media (hover: hover) and (pointer: fine) {
    .navigation-menu-link:hover::before {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-menu-panel] {
      --panel-width: min(896px, calc(100vw - 40px));
      left: 50%;
      width: var(--panel-width);
      margin-left: calc(var(--panel-width) / -2);
    }

    [data-products-panel] {
      --panel-width: min(1332px, calc(100vw - 40px));
    }

    .navigation-menu-link::before {
      transform: none;
      transition: none;
    }
  }

  [data-menu-viewport] {
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%) translateY(-8px) scale(0.985);
    transform-origin: top center;
    transition:
      opacity 160ms cubic-bezier(0.64, 0, 0.78, 0),
      transform 180ms cubic-bezier(0.64, 0, 0.78, 0),
      width var(--menu-resize-duration, 0ms) cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, transform;
  }

  header-menu[data-open="true"] [data-menu-viewport] {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0) scale(1);
    transition:
      opacity 180ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
      width var(--menu-resize-duration, 0ms) cubic-bezier(0.22, 1, 0.36, 1);
  }

  .navigation-feature-halo {
    position: absolute;
    bottom: -52px;
    left: 50%;
    z-index: 2;
    display: block;
    width: 783px;
    height: 783px;
    transform: translateX(-50%);
    pointer-events: none;
  }

  .navigation-feature-halo--behind {
    z-index: 0;
  }

  .navigation-feature-halo::before {
    position: absolute;
    inset: -21.93%;
    content: "";
    background: url("/navigation/ellipse.svg") center / 100% 100% no-repeat;
    transform: rotate(180deg) scaleY(-1);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-hover-corridor],
    [data-menu-viewport] {
      transform: translateX(-50%);
      transition: none;
    }

    header-menu[data-open="true"] [data-menu-viewport] {
      transform: translateX(-50%);
      transition: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine) {
    .navigation-feature-media {
      transition: transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
      will-change: transform;
    }

    a:hover .navigation-feature-media--product {
      transform: translate3d(0, -4px, 0);
    }

    a:hover .navigation-feature-media--guide {
      transform: translate3d(-8px, 0, 0);
    }

    a:hover .navigation-feature-media--story {
      transform: scale(1.02);
    }
  }
</style>
