---
import clsx from "clsx";
import { Image } from "astro:assets";
import AntoinePortrait from "../../assets/antoine-bourchardy.png";
import ArthurPortrait from "../../assets/arthur-mayoux-blog.svg";
import BryanPortrait from "../../assets/bryan_firmin.svg";
import EmilePortrait from "../../assets/emile_blog.svg";

interface Props {
  class?: string;
  author?: string;
  variant?: "default" | "journal";
}

const { class: className, author } = Astro.props;

const journal = Astro.props.variant === "journal";
const authorDetails: Record<string, { role: string; biography: string }> = {
  "Antoine Bouchardy": {
    role: "CEO and co-founder",
    biography:
      "He writes about the challenges founders face balancing growth with regulation.",
  },
  "Arthur Mayoux": {
    role: "Chief of Staff",
    biography:
      "Working across multiple departments, his primary objective is to help the company scale.",
  },
  "Bryan Frimin": {
    role: "CTO and co-founder",
    biography:
      "Experienced with cyber-security, he is building the open compliance tool which adapts to your actual stack.",
  },
  "Émile Ré": {
    role: "Founding engineer",
    biography:
      "He writes about the technical side of making compliance simple for startups.",
  },
};
const details = author ? authorDetails[author] : undefined;
const showBoth = !author && !journal;
const isAntoine = author === "Antoine Bouchardy";
const isArthur = author === "Arthur Mayoux";
const isBryan = author === "Bryan Frimin";
const isEmile = author === "Émile Ré";
---

{
  showBoth && (
    <div class={clsx("flex flex-col gap-8 sm:gap-10", className)}>
      <div class="text-xs font-medium">
        Written by Antoine Bouchardy, Bryan Frimin, Arthur Mayoux and Émile Ré
      </div>

      <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:gap-10">
        <div class="flex flex-col gap-2">
          <div class="text-muted-foreground text-xs">
            <a
              href="https://www.linkedin.com/in/antoinebouchardy/"
              class="text-success"
            >
              Antoine Bouchardy
            </a>
            is the CEO and co-founder of Probo, on a mission to make compliance
            simple and startup-friendly. He writes about the challenges founders
            face balancing growth with regulation. When he's not building Probo,
            you'll find him cycling or tinkering with open-source projects.
          </div>
        </div>

        <Image
          densities={[1, 2]}
          src={AntoinePortrait}
          alt="Portrait Antoine Bouchardy"
          class="mx-auto block shrink-0 sm:mx-0 sm:size-25"
          width={164}
          height={164}
        />
      </div>

      <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:gap-10">
        <div class="flex flex-col gap-2">
          <div class="text-muted-foreground text-xs">
            <a
              href="https://www.linkedin.com/in/gearnode/"
              class="text-success"
            >
              Bryan Frimin
            </a>
            is the CTO and co-founder. Experienced with cyber-security, he's now
            building the open compliance tool which adapts to your actual stack.
          </div>
        </div>

        <Image
          src={BryanPortrait}
          alt="Portrait Bryan Frimin"
          class="mx-auto block shrink-0 sm:mx-0 sm:size-25"
          width={164}
          height={164}
        />
      </div>

      <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:gap-10">
        <div class="flex flex-col gap-2">
          <div class="text-muted-foreground text-xs">
            <a
              href="https://www.linkedin.com/in/arthurmayoux/"
              class="text-success"
            >
              Arthur Mayoux
            </a>
            is the Chief of Staff at Probo. Working across multiple departments,
            his primary objective is to help the company scale.
          </div>
        </div>

        <Image
          src={ArthurPortrait}
          alt="Portrait Arthur Mayoux"
          class="mx-auto block shrink-0 sm:mx-0 sm:size-25"
          width={164}
          height={164}
        />
      </div>

      <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:gap-10">
        <div class="flex flex-col gap-2">
          <div class="text-muted-foreground text-xs">
            Émile Ré is a founding engineer at Probo, building the open-source
            compliance platform from the ground up. He writes about the
            technical side of making compliance simple for startups.
          </div>
        </div>

        <Image
          src={EmilePortrait}
          alt="Portrait Émile Ré"
          class="mx-auto block shrink-0 sm:mx-0 sm:size-25"
          width={164}
          height={164}
        />
      </div>
    </div>
  )
}

{
  (isAntoine || isArthur || isBryan || isEmile) && (
    <div
      class={clsx(
        "flex flex-col gap-6 sm:flex-row sm:items-center sm:gap-10",
        className,
      )}
    >
      <div class="flex flex-col gap-2">
        {isAntoine && (
          <>
            <div class="text-xs font-medium">Written by Antoine Bouchardy</div>
            <div class="text-muted-foreground text-xs">
              <a
                href="https://www.linkedin.com/in/antoinebouchardy/"
                class="text-success"
              >
                Antoine Bouchardy
              </a>
              is the CEO and co-founder of Probo, on a mission to make
              compliance simple and startup-friendly. He writes about the
              challenges founders face balancing growth with regulation. When
              he's not building Probo, you'll find him cycling or tinkering with
              open-source projects.
            </div>
          </>
        )}
        {isArthur && (
          <>
            <div class="text-xs font-medium">Written by Arthur Mayoux</div>
            <div class="text-muted-foreground text-xs">
              <a
                href="https://www.linkedin.com/in/arthurmayoux/"
                class="text-success"
              >
                Arthur Mayoux
              </a>
              is the Chief of Staff at Probo. Working across multiple
              departments, his primary objective is to help the company scale.
            </div>
          </>
        )}
        {isBryan && (
          <>
            <div class="text-xs font-medium">Written by Bryan Frimin</div>
            <div class="text-muted-foreground text-xs">
              <a
                href="https://www.linkedin.com/in/gearnode/"
                class="text-success"
              >
                Bryan Frimin
              </a>
              is the CTO and co-founder. Experienced with cyber-security, he's
              now building the open compliance tool which adapts to your actual
              stack.
            </div>
          </>
        )}
        {isEmile && (
          <>
            <div class="text-xs font-medium">Written by Émile Ré</div>
            <div class="text-muted-foreground text-xs">
              Émile Ré is a founding engineer at Probo, building the open-source
              compliance platform from the ground up. He writes about the
              technical side of making compliance simple for startups.
            </div>
          </>
        )}
      </div>

      {isAntoine && (
        <Image
          densities={[1, 2]}
          src={AntoinePortrait}
          alt="Portrait Antoine Bouchardy"
          class="mx-auto block shrink-0 sm:mx-0 sm:size-25"
          width={164}
          height={164}
        />
      )}

      {isArthur && (
        <Image
          src={ArthurPortrait}
          alt="Portrait Arthur Mayoux"
          class="mx-auto block shrink-0 sm:mx-0 sm:size-25"
          width={164}
          height={164}
        />
      )}

      {isBryan && (
        <Image
          src={BryanPortrait}
          alt="Portrait Bryan Frimin"
          class="mx-auto block shrink-0 sm:mx-0 sm:size-25"
          width={164}
          height={164}
        />
      )}

      {isEmile && (
        <Image
          src={EmilePortrait}
          alt="Portrait Émile Ré"
          class="mx-auto block shrink-0 sm:mx-0 sm:size-25"
          width={164}
          height={164}
        />
      )}
    </div>
  )
}

{
  journal && (
    <div class="journal-author">
      <p class="text-muted-foreground text-xs">Written by</p>
      <div>
        <p class="font-medium">{author}</p>
        {details && (
          <p class="text-muted-foreground mt-1 text-sm">{details.role}</p>
        )}
      </div>
      {details && <p class="text-muted-foreground">{details.biography}</p>}
    </div>
  )
}
