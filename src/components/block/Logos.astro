---
import { clsx } from "clsx";
import { getCollection } from "astro:content";
import LogosScroll from "../LogosScroll.svelte";

type Props = {
  constrained?: boolean;
  class?: string;
};

type Company = {
  image: string;
  width: number;
  height: number;
  alt: string;
  href: string;
  class: string;
  /** Id of the customer story in the stories collection, when there is one. */
  story?: string;
};

const storyIds = new Set(
  (await getCollection("stories")).map((story) => story.id),
);

const allCompanies: Company[] = [
  {
    image: "ahrefs.svg",
    width: 74,
    height: 19,
    alt: "Ahrefs",
    story: "ahrefs-iso",
    href: "https://ahrefs.com",
    class: "h-5 w-auto sm:h-6",
  },
  {
    image: "lucis.svg",
    width: 246,
    height: 74,
    alt: "Lucis",
    story: "lucis-iso",
    href: "https://www.lucis.life",
    class: "h-6 w-auto sm:h-7",
  },
  {
    image: "filz.svg",
    width: 598,
    height: 240,
    alt: "Filz",
    href: "https://www.filiz.io",
    class: "h-8 w-auto sm:h-9",
  },
  {
    image: "wolfia.svg",
    width: 115,
    height: 40,
    alt: "Wolfia",
    href: "https://www.wolfia.com",
    class: "h-7 w-auto sm:h-8",
  },
  {
    image: "trace_for_good.svg",
    width: 1023,
    height: 154,
    alt: "Trace for Good",
    href: "https://www.traceforgood.com",
    class: "h-6 w-auto sm:h-7",
  },
  {
    image: "tinfoil.svg",
    width: 3154,
    height: 813,
    alt: "Tinfoil",
    href: "https://tinfoil.sh",
    class: "h-6 w-auto sm:h-7",
  },
  {
    image: "typebot.svg",
    width: 100,
    height: 23,
    alt: "Typebot",
    href: "https://typebot.com/",
    class: "h-6 w-auto sm:h-7",
  },
  {
    image: "normal.svg",
    width: 1680,
    height: 258,
    alt: "Normal",
    story: "normal-computing-soc2",
    href: "https://www.normalcomputing.com/",
    class: "h-4 w-auto sm:h-5",
  },
  {
    image: "morphik.svg",
    width: 4218,
    height: 1174,
    alt: "Morphik",
    href: "https://www.morphik.ai/",
    class: "h-8 w-auto sm:h-9",
  },
  {
    image: "vybe.svg",
    width: 603,
    height: 161,
    alt: "Vybe",
    story: "vybe-soc2",
    href: "https://www.vybe.build/",
    class: "h-6 w-auto sm:h-7",
  },
  {
    image: "blaxel-logo.svg",
    width: 939,
    height: 270,
    alt: "Blaxel",
    story: "blaxel-soc2",
    href: "https://blaxel.ai/",
    class: "h-6 w-auto sm:h-7",
  },
  {
    image: "sonarly-logo.svg",
    width: 944,
    height: 195,
    alt: "Sonarly",
    href: "https://sonarly.com/",
    class: "h-6 w-auto sm:h-7",
  },
  {
    image: "verso.svg",
    width: 872,
    height: 224,
    alt: "Verso",
    href: "https://www.askverso.ai/",
    class: "h-6 w-auto sm:h-7",
  },
  {
    image: "awen_logo.webp",
    width: 426,
    height: 119,
    alt: "Awen",
    href: "https://www.awen.ai/",
    class: "h-6 w-auto sm:h-7",
  },
  {
    image: "wafer_logo.svg",
    width: 725,
    height: 207,
    alt: "Wafer",
    href: "https://www.wafer.ai/",
    class: "h-6 w-auto sm:h-7",
  },
  {
    image: "bluejay.svg",
    width: 160,
    height: 36,
    alt: "Bluejay",
    story: "bluejay-soc2",
    href: "https://getbluejay.ai/",
    class: "h-6 w-auto sm:h-7",
  },
  {
    image: "paladin.svg",
    width: 200,
    height: 44,
    alt: "Paladin",
    href: "https://www.paladin.fr/",
    class: "h-6 w-auto sm:h-7",
  },
  {
    image: "parallel.svg",
    width: 104,
    height: 32,
    alt: "Parallel",
    href: "https://www.beparallel.com/",
    class: "h-6 w-auto sm:h-7",
  },
];

// A logo opens its customer story when one is published, the company site otherwise.
const companies = allCompanies.map((company) => {
  const hasStory = Boolean(company.story && storyIds.has(company.story));
  return {
    ...company,
    hasStory,
    link: hasStory ? `/stories/${company.story}` : company.href,
  };
});
---

<section
  class={clsx(
    "p-0 overflow-hidden relative",
    Astro.props.class,
    Astro.props.constrained && "sm:max-w-270 mx-auto",
  )}
>
  <LogosScroll class="flex h-20 w-max items-center sm:h-30" client:visible>
    {
      companies.map((company) => (
        <div class="relative mx-4 flex w-30 flex-none items-center justify-center py-5 sm:mx-15 sm:w-50 sm:py-8">
          <a
            href={company.link}
            target={company.hasStory ? undefined : "_blank"}
            rel={company.hasStory ? undefined : "noopener noreferrer"}
            class="group relative flex size-full items-center justify-center"
            aria-label={
              company.hasStory
                ? `Read the ${company.alt} customer story`
                : company.alt
            }
          >
            <img
              src={`/clients/${company.image}`}
              alt={company.alt}
              width={company.width}
              height={company.height}
              loading="lazy"
              decoding="async"
              class={company.class}
            />
            {company.hasStory && (
              <span class="story-tag text-muted-foreground group-hover:text-primary group-hover:border-border-mid absolute top-full left-1/2 mt-1 -translate-x-1/2 rounded-full border px-2 text-[11px] leading-4 font-medium whitespace-nowrap transition-colors sm:mt-2.5 sm:py-0.5 sm:text-xs">
                Read story →
              </span>
            )}
          </a>
        </div>
      ))
    }
  </LogosScroll>

  {
    Astro.props.constrained && (
      <>
        <div class="absolute top-0 right-0 h-full w-5 bg-linear-to-l from-[#FFFFFB] to-[#FFFFFB]/0 sm:w-10" />
        <div class="absolute top-0 left-0 h-full w-5 bg-linear-to-r from-[#FFFFFB] to-[#FFFFFB]/0 sm:w-10" />
      </>
    )
  }
</section>
