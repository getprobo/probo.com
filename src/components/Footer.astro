---
import "../styles/footer.css";
import { Image } from "astro:assets";
import Logo from "../assets/probo-logo.svg";
import { menuGroups } from "../content/menu";
import Frameworks from "./block/Frameworks.astro";
import OpenStatus from "../components/OpenStatus.svelte";
import Newsletter from "./block/Newsletter.astro";
import AskAi from "./AskAi.astro";
import { Toaster } from "svelte-sonner";
import { getCollection } from "astro:content";

const comparisonOrder = [
  "probo-vs-vanta",
  "probo-vs-drata",
  "probo-vs-oneleet",
];
const comparisonRank = (id: string) => {
  const index = comparisonOrder.indexOf(id);
  return index === -1 ? comparisonOrder.length : index;
};
const comparisonPages = (
  await getCollection(
    "hub",
    ({ id, data }) => id.startsWith("probo-vs-") && !data.draft,
  )
)
  .sort(
    (a, b) =>
      comparisonRank(a.id) - comparisonRank(b.id) ||
      a.data.date.getTime() - b.data.date.getTime(),
  )
  .map(({ id, data }) => ({
    label: data.highlight ?? data.title.split(":")[0],
    href: `/hub/${id}`,
  }));

const hasCookieBanner = Boolean(
  import.meta.env.PUBLIC_COOKIE_BANNER_ID &&
  import.meta.env.PUBLIC_COOKIE_BANNER_API_BASE_URL,
);

const menus = [
  {
    label: "Products",
    items: menuGroups.find((group) => group.label === "Products")!.items,
  },
  {
    label: "Resources",
    items: [
      { label: "Home", href: "/" },
      { label: "Blog", href: "/blog" },
      { label: "Hub", href: "/hub" },
      { label: "Customer stories", href: "/stories" },
      { label: "Love from customers", href: "/love-from-customer" },
      { label: "Changelog", href: "/changelog" },
      { label: "Help Center", href: "/docs" },
      { label: "GitHub", href: "https://github.com/getprobo/probo" },
    ],
  },
  {
    label: "Compare",
    items: [
      ...comparisonPages,
      {
        label: "Probo vs fractional CISO",
        href: "/hub/probo-vs-fractional-ciso",
      },
    ],
  },
  {
    label: "Company",
    items: [
      { label: "About", href: "/about" },
      { label: "Careers", href: "/careers" },
      { label: "Brand", href: "/brand" },
      { label: "LinkedIn", href: "https://www.linkedin.com/company/getprobo" },
    ],
  },
  {
    label: "Legal",
    items: [
      { label: "Cookie Policy", href: "/cookie-policy" },
      { label: "Privacy Policy", href: "/privacy" },
      { label: "Terms of service", href: "/terms" },
      { label: "Security", href: "https://compliance.probo.com" },
      {
        label: "Subprocessors",
        href: "https://compliance.probo.com/subprocessors",
      },
    ],
  },
];
type Props = {
  noFrameworks?: boolean;
  journal?: boolean;
};
const showFrameworks = !Astro.props.journal && !Astro.props.noFrameworks;
---

<footer
  class:list={[
    "journal-footer",
    showFrameworks && "journal-footer--with-frameworks",
  ]}
>
  <div class="footer-container">
    {showFrameworks && <Frameworks />}
    {!showFrameworks && <Newsletter variant="journal" />}
    <nav class="journal-footer-nav" aria-label="Footer">
      <a href="/" aria-label="Probo home" class="journal-footer-brand">
        <Image src={Logo} alt="Probo" width={110} height={31} />
      </a>
      {
        menus.map((menu) => (
          <div>
            <h2 class="text-sm font-medium">{menu.label}</h2>
            <ul>
              {menu.items.map((item) => (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ))}
              {menu.label === "Legal" && hasCookieBanner && (
                <li>
                  <probo-settings-link>
                    <a href="#">Cookie Settings</a>
                  </probo-settings-link>
                </li>
              )}
            </ul>
          </div>
        ))
      }
    </nav>
    {showFrameworks && <Newsletter variant="journal" />}
    <div class="journal-footer-bottom">
      <div class="journal-footer-legal">
        <p>
          Copyright © 2025-{new Date().getFullYear()} Probo. All rights reserved.
        </p>
        <OpenStatus client:visible />
      </div>
      <AskAi />
    </div>
  </div>
</footer>

<Toaster richColors position="top-center" client:only="svelte" />
