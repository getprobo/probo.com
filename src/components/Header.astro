---
import { Image } from "astro:assets";
import Logo from "../assets/probo-logo.svg";
import WhiteLogo from "../assets/probo_white_logo.svg";
import HeaderMenu from "./HeaderMenu.astro";
import Button from "./ui/Button.svelte";
import MobileMenu from "./MobileMenu.astro";
import GithubStars from "./GithubStars.astro";
import Icon from "./Icon.astro";
import { directMenuItems, menuGroups } from "../content/menu";
type Props = {
  hideBurger?: boolean;
  docsChrome?: boolean;
};

const { hideBurger = false, docsChrome = false } = Astro.props;
---

<header
  class:list={[
    "page-header text-primary transition-all",
    docsChrome
      ? "bg-transparent"
      : "bg-secondary/80 sticky top-0 z-50 border-b backdrop-blur-md",
  ]}
>
  <div
    class:list={[
      "mx-auto flex items-center py-3 sm:py-4",
      docsChrome
        ? "docs-header-inner w-full max-w-none px-[var(--docs-page-padding-x)]"
        : "container",
    ]}
  >
    <a class="mr-auto" href="/" transition:name="header-logo">
      <Image
        src={Logo}
        alt="Probo"
        width={73}
        height={20}
        class="logo-light block"
      />
      <Image
        src={WhiteLogo}
        alt="Probo"
        width={73}
        height={20}
        class="logo-dark hidden"
      />
    </a>
    <nav
      class="hidden items-center gap-2.25 lg:flex"
      transition:name="header-nav"
    >
      <HeaderMenu groups={menuGroups} />
      <Button
        variant="secondary"
        href={directMenuItems[0].href}
        class="text-sm leading-tight"
      >
        <div class="flex items-center gap-1.5">
          <Icon name="github-logo" size={17} />
          <div class="mt-0.5">Star</div>
        </div>
        <hr class="bg-border-solid h-full w-[1px]" />
        <GithubStars class="mt-0.5 block" />
      </Button>
    </nav>
    <div transition:name="header-compliant">
      <Button
        href="/contact"
        class="ml-auto h-9 px-4 whitespace-nowrap lg:ml-4 lg:h-8 lg:px-3"
      >
        Get compliant
      </Button>
    </div>
    <slot />
    {
      !hideBurger && (
        <burger-menu
          class="group ml-3 grid size-9 place-items-center lg:hidden"
          role="button"
          tabindex="0"
          aria-label="Open mobile menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <Icon name="list" size={16} class="group-aria-expanded:hidden" />
          <Icon name="x" size={16} class="hidden group-aria-expanded:block" />
        </burger-menu>
      )
    }
  </div>
</header>

<style>
  :global(html[data-theme="dark"]) .logo-light {
    display: none;
  }

  :global(html[data-theme="dark"]) .logo-dark {
    display: block;
  }
</style>

<MobileMenu id="mobile-menu" />

<script>
  import { customElementDefine } from "../lib/dom";

  class BurgerMenu extends HTMLElement {
    scrolled = null as null | boolean;
    menu = document.querySelector("#mobile-menu") as HTMLDialogElement | null;

    connectedCallback() {
      this.addEventListener("click", this.toggleExpanded);
      this.addEventListener("keydown", this.toggleFromKeyboard);
      document.addEventListener("keydown", this.closeOnEscape);
      this.menu?.addEventListener("click", this.closeAfterNavigation);
      this.menu?.addEventListener("close", this.syncClosedState);
      window.addEventListener("scroll", this.onScroll);
      this.setExpanded(false);
      this.onScroll();
    }

    disconnectedCallback() {
      this.removeEventListener("click", this.toggleExpanded);
      this.removeEventListener("keydown", this.toggleFromKeyboard);
      document.removeEventListener("keydown", this.closeOnEscape);
      this.menu?.removeEventListener("click", this.closeAfterNavigation);
      this.menu?.removeEventListener("close", this.syncClosedState);
      window.removeEventListener("scroll", this.onScroll);
      document.body.style.removeProperty("overflow");
    }

    setExpanded(expanded: boolean) {
      if (!this.menu) return;
      if (expanded && !this.menu.open) {
        this.menu.showModal();
      } else if (!expanded && this.menu.open) {
        this.menu.close();
      }
      this.setAttribute("aria-expanded", String(expanded));
      this.setAttribute(
        "aria-label",
        expanded ? "Close mobile menu" : "Open mobile menu",
      );
      if (expanded) {
        document.body.style.setProperty("overflow", "hidden");
      } else {
        document.body.style.removeProperty("overflow");
      }
      if (expanded) {
        queueMicrotask(() =>
          this.menu?.querySelector<HTMLElement>("a")?.focus(),
        );
      }
    }

    toggleExpanded = () =>
      this.setExpanded(this.getAttribute("aria-expanded") !== "true");

    toggleFromKeyboard = (event: KeyboardEvent) => {
      if (event.key !== "Enter" && event.key !== " ") return;
      event.preventDefault();
      this.toggleExpanded();
    };

    closeOnEscape = (event: KeyboardEvent) => {
      if (
        event.key === "Escape" &&
        this.getAttribute("aria-expanded") === "true"
      ) {
        event.preventDefault();
        this.setExpanded(false);
        this.focus();
      }
    };

    closeAfterNavigation = (event: Event) => {
      if (event.target instanceof Element && event.target.closest("a")) {
        this.setExpanded(false);
      }
    };

    syncClosedState = () => {
      this.setAttribute("aria-expanded", "false");
      this.setAttribute("aria-label", "Open mobile menu");
      document.body.style.removeProperty("overflow");
    };

    onScroll = () => {
      const isScrolled = document.documentElement.scrollTop > 10;
      if (isScrolled === this.scrolled) {
        return;
      }
      this.closest("header")?.setAttribute(
        "data-scrolled",
        isScrolled.toString(),
      );
      this.scrolled = isScrolled;
    };
  }

  customElementDefine("burger-menu", () => BurgerMenu);
</script>
