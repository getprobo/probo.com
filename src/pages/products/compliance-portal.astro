---
import "@phosphor-icons/web/regular";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import ProductDiscovery from "../../components/block/ProductDiscovery.astro";
import Button from "../../components/ui/Button.svelte";
import LottiePlayer from "../../components/LottiePlayer.svelte";
import LogosScroll from "../../components/LogosScroll.svelte";
import PaulSinai from "../../assets/testimonial/paul-sinai.jpg";
import BlaxelFounders from "../../assets/stories/blaxel-header.jpg";

const pageTitle = "Compliance Portal Software with NDA Access Control";
const pageDescription =
  "Give prospects one secure Compliance Portal to request access, sign NDAs, and download watermarked compliance documents while your team stays in control.";

const overviewFeatures = [
  {
    icon: "ph-file-c",
    title: "Compliance docs, with granular permissions",
    description:
      "Share key security materials from one Compliance Portal, and decide what stays public, restricted, or approval-only.",
  },
  {
    icon: "ph-slack-logo",
    title: "Manage access from your stack",
    description:
      "Review access requests in Slack and keep rules aligned with the way your team already works.",
  },
  {
    icon: "ph-signature",
    title: "Your documents under an NDA",
    description:
      "Let prospects sign an NDA in the Compliance Portal before downloading protected, watermarked files.",
  },
  {
    icon: "ph-key",
    title: "Simple authentication",
    description:
      "Let prospects sign in with SSO or magic links without creating another account.",
  },
  {
    icon: "ph-bell-simple",
    title: "Keep customers informed",
    description:
      "Choose which policy, subprocessor, report, or audit updates subscribers should receive.",
  },
];

const accessFeatures = [
  {
    title: "Approve requests from Slack",
    lottie: "/lottie/trust-center/slack.json",
    bullets: [
      "Review access requests directly from Slack.",
      "Notify the right owners when a prospect needs access.",
      "Keep every decision synced with your Compliance Portal automatically.",
    ],
  },
  {
    title: "Gate sensitive downloads with an NDA",
    lottie: "/lottie/trust-center/nda.json",
    reverse: true,
    bullets: [
      "Require an NDA before sensitive files can be opened.",
      "Let prospects sign directly inside the product page.",
      "Share watermarked documents without extra legal back and forth.",
    ],
  },
  {
    title: "Frictionless authentication",
    lottie: "/lottie/trust-center/authentication.json",
    bullets: [
      "Let visitors sign in with magic links or SSO.",
      "Remove account creation from the security review flow.",
      "Keep access secure while making the buyer experience seamless.",
    ],
  },
  {
    title: "Notify subscribers about the right updates",
    lottie: "/lottie/trust-center/updates.json",
    reverse: true,
    bullets: [
      "Notify subscribers when selected security documents change.",
      "Choose which updates subscribers receive.",
      "Keep every notification relevant and controlled.",
    ],
  },
];

const publishCards = [
  {
    visual: "documents",
    title: "Documents",
    description:
      "Share SOC 2, ISO, pentest, and other reports in a structured, access-controlled library.",
  },
  {
    visual: "protected-assets",
    title: "Protected Assets",
    description:
      "Let buyers open, review, and download each PDF in a secure, focused experience.",
  },
  {
    visual: "audits",
    title: "Audits",
    description:
      "Give buyers the audit history and historical compliance materials they need when appropriate.",
  },
  {
    visual: "subprocessors",
    title: "Subprocessors",
    description:
      "List subprocessors with the context buyers need to assess risk.",
  },
  {
    visual: "data-requests",
    title: "Data Requests",
    description:
      "Handle customer data requests through a guided flow, from identity check to export delivery.",
  },
  {
    visual: "security-commitments",
    title: "Security Commitments",
    description:
      "Explain what your company commits to in security, in a concise, scannable, and engaging format.",
  },
];

const visualAssets: Record<
  string,
  {
    className: string;
    src: string;
    alt: string;
    width: number;
    height: number;
  }[]
> = {
  "protected-assets": [
    {
      className: "trust-category-browser",
      src: "/trust-center/pdf.svg",
      alt: "Watermarked PDF of a protected compliance document",
      width: 740,
      height: 1072,
    },
  ],
  audits: [
    {
      className: "trust-category-audit-row trust-category-audit-row--one",
      src: "/trust-center/audit-row-1.svg",
      alt: "Audit history row in the Compliance Portal",
      width: 702,
      height: 140,
    },
    {
      className: "trust-category-audit-row trust-category-audit-row--two",
      src: "/trust-center/audit-row-2.svg",
      alt: "Audit history row in the Compliance Portal",
      width: 520,
      height: 140,
    },
    {
      className: "trust-category-audit-row trust-category-audit-row--three",
      src: "/trust-center/audit-row-3.svg",
      alt: "Audit history row in the Compliance Portal",
      width: 702,
      height: 140,
    },
  ],
  subprocessors: [
    {
      className:
        "trust-category-subprocessor-card trust-category-subprocessor-card--docusign",
      src: "/trust-center/subprocessor-docusign.svg",
      alt: "DocuSign listed as a subprocessor",
      width: 281,
      height: 221,
    },
    {
      className:
        "trust-category-subprocessor-card trust-category-subprocessor-card--hubspot",
      src: "/trust-center/subprocessor-hubspot.svg",
      alt: "HubSpot listed as a subprocessor",
      width: 281,
      height: 221,
    },
    {
      className:
        "trust-category-subprocessor-card trust-category-subprocessor-card--linear",
      src: "/trust-center/subprocessor-linear.svg",
      alt: "Linear listed as a subprocessor",
      width: 281,
      height: 221,
    },
    {
      className:
        "trust-category-subprocessor-card trust-category-subprocessor-card--stripe",
      src: "/trust-center/subprocessor-stripe.svg",
      alt: "Stripe listed as a subprocessor",
      width: 281,
      height: 221,
    },
  ],
  "data-requests": [
    {
      className: "trust-category-data-requests",
      src: "/trust-center/data-requests.svg",
      alt: "Data request flow from identity check to export",
      width: 1024,
      height: 192,
    },
  ],
  "security-commitments": [
    {
      className:
        "trust-category-security-card trust-category-security-card--encryption",
      src: "/trust-center/security-encryption.svg",
      alt: "Encryption security commitment",
      width: 201,
      height: 171,
    },
    {
      className:
        "trust-category-security-card trust-category-security-card--privacy",
      src: "/trust-center/security-privacy.svg",
      alt: "Privacy security commitment",
      width: 201,
      height: 171,
    },
    {
      className:
        "trust-category-security-card trust-category-security-card--monitoring",
      src: "/trust-center/security-monitoring.svg",
      alt: "Monitoring security commitment",
      width: 201,
      height: 171,
    },
    {
      className:
        "trust-category-security-card trust-category-security-card--vulnerability",
      src: "/trust-center/security-vulnerability.svg",
      alt: "Vulnerability management security commitment",
      width: 201,
      height: 171,
    },
  ],
};

const trustedLogos = [
  {
    src: "/clients/trace_for_good.svg",
    alt: "Trace for Good",
    class: "trusted-logo--trace",
    width: 1023,
    height: 154,
  },
  {
    src: "/clients/jimo.svg",
    alt: "Jimo",
    class: "trusted-logo--jimo",
    width: 72,
    height: 36,
  },
  {
    src: "/clients/lucis.svg",
    alt: "Lucis",
    class: "trusted-logo--lucis",
    width: 246,
    height: 74,
  },
  {
    src: "/clients/filz.svg",
    alt: "Filiz",
    class: "trusted-logo--filiz",
    width: 598,
    height: 240,
  },
  {
    src: "/clients/ahrefs.svg",
    alt: "Ahrefs",
    class: "trusted-logo--ahrefs",
    width: 74,
    height: 19,
  },
];

const faqs = [
  {
    question: "Can we host it on our own domain?",
    answer:
      "Yes. Add a CNAME record pointing to your Compliance Portal, and it will run on your own domain, such as trust.yourcompany.com.",
  },
  {
    question: "How long does it take to set up?",
    answer:
      "Just a few minutes. Once your compliance content lives in Probo, publishing your Compliance Portal is nearly instant, and you can even set it up via MCP.",
  },
  {
    question: "Can we show a pen test report or security questionnaire?",
    answer:
      "Yes. Add any document to Probo, then choose its visibility on your Compliance Portal: public, restricted, or hidden.",
  },
  {
    question: "Can requests be approved from Slack?",
    answer:
      "Yes. Connect a Slack channel to receive access requests directly: approve or revoke access in one click, with every decision synced back to the Compliance Portal. You can also manage requests anytime from the access request page in Probo.",
  },
  {
    question: "Can we list our third parties?",
    answer:
      "Yes. Every third party in your Probo organization is available to display. You decide which ones to show and which to keep private.",
  },
  {
    question:
      "Does it update automatically when our controls or documents change?",
    answer:
      "Yes. Your Compliance Portal always shows the latest version of every document, so it stays current without manual updates.",
  },
  {
    question: "Can access require an NDA?",
    answer:
      "Yes. Prospects can sign an NDA before opening protected files, so access stays controlled without slowing the review.",
  },
  {
    question: "Can buyers access without creating an account?",
    answer:
      "Yes. Buyers can use magic links or SSO, so the review stays secure without adding account creation friction.",
  },
  {
    question: "Who keeps the content up to date?",
    answer:
      "Probo helps structure and maintain the materials, while your team keeps control over what is public, restricted, or approval-only.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};

const softwareApplicationSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Probo Compliance Portal",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description: pageDescription,
  url: "https://www.probo.com/products/compliance-portal",
  publisher: {
    "@type": "Organization",
    name: "Probo",
    url: "https://www.probo.com",
  },
};
---

<Layout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script
    type="application/ld+json"
    set:html={JSON.stringify(softwareApplicationSchema)}
  />
  <main class="-mt-16 overflow-hidden pt-16">
    <div class="relative isolate overflow-hidden">
      <div
        aria-hidden="true"
        data-node-id="241:851"
        class="trust-hero-orb pointer-events-none absolute top-[-1314px] left-1/2 z-0 size-[2265px] rounded-full border-[350px] border-[#E6FF03] blur-[96px]"
      >
      </div>

      <section class="relative z-10 container py-16 text-center sm:py-24">
        <div
          class="border-border-low text-tertiary-foreground animate-perspective-in mx-auto mb-6 w-max rounded-lg border px-2 py-0.5 text-sm font-medium"
          style="animation-delay: 100ms"
        >
          Compliance Portal
        </div>
        <h1
          class="mx-auto mb-6 max-w-[600px] text-[2.75rem] leading-none font-semibold tracking-[-1.4px] text-balance sm:text-5xl sm:tracking-[-1.6px]"
          aria-label="Your compliance documentation with access control."
        >
          <span aria-hidden="true" class="block overflow-hidden">
            <span
              class="animate-perspective-in block"
              style="animation-delay: 150ms">Your compliance</span
            >
          </span>
          <span aria-hidden="true" class="hidden overflow-hidden sm:block">
            <span
              class="animate-perspective-in block"
              style="animation-delay: 200ms">documentation with</span
            >
          </span>
          <span aria-hidden="true" class="block overflow-hidden sm:hidden">
            <span
              class="animate-perspective-in block"
              style="animation-delay: 200ms">documentation</span
            >
          </span>
          <span aria-hidden="true" class="block overflow-hidden sm:hidden">
            <span
              class="animate-perspective-in block"
              style="animation-delay: 250ms">with</span
            >
          </span>
          <span aria-hidden="true" class="hidden overflow-hidden sm:block">
            <span
              class="animate-perspective-in block"
              style="animation-delay: 250ms">access control.</span
            >
          </span>
          <span aria-hidden="true" class="block overflow-hidden sm:hidden">
            <span
              class="animate-perspective-in block"
              style="animation-delay: 300ms">access control.</span
            >
          </span>
        </h1>
        <p
          class="text-muted-foreground animate-perspective-in mx-auto mb-8 max-w-[420px] text-base"
          style="animation-delay: 350ms"
        >
          Give prospects one clear place to request access, sign the right NDA,
          and download watermarked documents while your team keeps control.
        </p>
        <div
          class="animate-perspective-in flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center"
          style="animation-delay: 400ms"
        >
          <Button href="/contact" size="lg">Book a demo</Button>
          <Button
            href="https://compliance.probo.com/"
            variant="secondary"
            size="lg"
            target="_blank"
            rel="noopener noreferrer"
          >
            See it in action
            <i class="ph ph-arrow-right" aria-hidden="true"></i>
          </Button>
        </div>
      </section>

      <section class="relative z-10 container pb-0">
        <img
          src="/trust-center/browser.svg"
          alt="Acme Compliance Portal browser preview"
          width="1146"
          height="786"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="animate-slide-in mx-auto h-auto w-full"
          style="animation-delay: 600ms"
        />
      </section>
    </div>

    <section class="container pt-16 pb-0 text-center sm:pt-32">
      <h2
        class="mx-auto max-w-[552px] text-[1.875rem] leading-9 font-semibold tracking-[-1px] text-balance text-[#141e12]"
        data-trust-reveal
      >
        Everything your buyers need to review security, in one place.
      </h2>
      <p
        class="mx-auto mt-2 max-w-[504px] text-[16px] leading-6 text-[#6b716a]"
        data-trust-reveal
        style="--trust-reveal-delay: 100ms"
      >
        Help buyers find the right materials faster, while your team decides
        what is public, restricted, or approval-only.
      </p>

      <div class="overview-feature-grid mt-16">
        {
          overviewFeatures.map((feature, index) => (
            <div
              class="overview-feature"
              data-trust-reveal
              style={`--trust-reveal-delay: ${index * 70}ms`}
            >
              <i
                class:list={["ph overview-feature-icon", feature.icon]}
                aria-hidden="true"
              />
              <div class="overview-feature-copy">
                <h3>{feature.title}</h3>
                <p>{feature.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section id="access-control" class="pt-16 pb-0 sm:pt-32">
      <div class="container mb-12 text-center sm:mb-16">
        <h2
          class="mx-auto max-w-[600px] text-[1.875rem] leading-9 font-semibold tracking-[-1px] text-balance"
          data-trust-reveal
        >
          Give buyers access without losing control
        </h2>
        <p
          class="text-muted-foreground mx-auto mt-2 max-w-[520px] text-[16px] leading-6"
          data-trust-reveal
          style="--trust-reveal-delay: 100ms"
        >
          Approve requests in Slack, support SSO or magic links, and keep every
          permission attached to the right company.
        </p>
      </div>

      <div class="space-y-8 sm:space-y-12">
        {
          accessFeatures.map((feature, index) => (
            <div
              class:list={[
                "container flex flex-col gap-8 lg:items-center lg:gap-16",
                feature.reverse ? "lg:flex-row-reverse" : "lg:flex-row",
              ]}
              data-trust-reveal
              style={`--trust-reveal-delay: ${index * 80}ms`}
            >
              <div class="bg-subtle relative aspect-[508/664] w-full overflow-hidden rounded-2xl lg:w-[508px] lg:flex-none">
                <LottiePlayer
                  client:visible
                  src={feature.lottie}
                  label={`${feature.title} animation`}
                  class="size-full origin-center scale-[1.12] transform-gpu"
                />
              </div>

              <div
                class:list={[
                  "w-full max-w-[508px] lg:w-[508px] lg:flex-none",
                  feature.reverse ? "lg:pr-16" : "lg:pl-16",
                ]}
              >
                <h3 class="mb-6 text-[24px] leading-8 font-semibold tracking-[-0.6px]">
                  {feature.title}
                </h3>
                <ul class="text-muted-foreground space-y-3 text-[16px] leading-6">
                  {feature.bullets.map((bullet) => (
                    <li class="flex gap-2">
                      <i
                        class="ph ph-check inline-flex size-6 shrink-0 items-center justify-center text-[24px] leading-none text-current"
                        aria-hidden="true"
                      />
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="container pt-16 pb-0 sm:pt-32">
      <div class="mb-16 text-center">
        <h2
          class="mx-auto max-w-[560px] text-[1.875rem] leading-9 font-semibold tracking-[-1px] text-balance"
          data-trust-reveal
        >
          All your compliance materials, organized for security review
        </h2>
        <p
          class="text-muted-foreground mx-auto mt-2 max-w-[520px] text-[16px] leading-6"
          data-trust-reveal
          style="--trust-reveal-delay: 100ms"
        >
          Organize policies, controls, reports, audits, and vendors into clear
          categories instead of scattered compliance materials.
        </p>
      </div>

      <div class="grid gap-x-6 gap-y-16 sm:grid-cols-2 lg:grid-cols-3">
        {
          publishCards.map((card, index) => (
            <article
              class="flex flex-col gap-6"
              data-trust-reveal
              style={`--trust-reveal-delay: ${index * 70}ms`}
            >
              <div
                class:list={[
                  "trust-category-visual",
                  `trust-category-visual--${card.visual}`,
                ]}
                data-trust-material-visual
                aria-hidden="true"
              >
                {visualAssets[card.visual]?.map((asset) => (
                  <img
                    class={asset.className}
                    src={asset.src}
                    alt={asset.alt}
                    width={asset.width}
                    height={asset.height}
                    loading="lazy"
                    decoding="async"
                  />
                ))}
                <span class="trust-category-halo" />
                {card.visual === "documents" && (
                  <img
                    src="/trust-center/documents.svg"
                    alt="Compliance document library with SOC 2, ISO, and pentest reports"
                    width="653"
                    height="224"
                    loading="lazy"
                    decoding="async"
                    class="trust-category-documents-art"
                  />
                )}
              </div>
              <div class="flex flex-col gap-2">
                <h3 class="text-[20px] leading-7 font-semibold tracking-[-0.4px]">
                  {card.title}
                </h3>
                <p class="text-muted-foreground text-[16px] leading-6">
                  {card.description}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="container pt-16 pb-0 sm:pt-32">
      <div class="pb-12 text-center sm:pb-16">
        <h2
          class="text-[1.875rem] leading-9 font-semibold tracking-[-1px] text-[#141e12]"
          data-trust-reveal
        >
          Trusted by 130+ companies
        </h2>
        <p
          class="mx-auto mt-2 max-w-[504px] text-[16px] leading-6 text-[#6b716a]"
          data-trust-reveal
          style="--trust-reveal-delay: 100ms"
        >
          Security teams use Probo to share the right materials, protect
          sensitive documents, and keep access requests moving.
        </p>
      </div>

      <div class="trusted-showcase">
        <div
          class="trusted-photo-card"
          data-trust-reveal
          style="--trust-reveal-delay: 100ms"
        >
          <Image
            src={BlaxelFounders}
            alt="Paul Sinai and the Blaxel team"
            width={528}
            height={528}
            densities={[1, 2]}
            class="trusted-photo"
            loading="lazy"
          />
        </div>

        <div
          class="trusted-quote-card"
          data-trust-reveal
          style="--trust-reveal-delay: 180ms"
        >
          <span class="trusted-quote-halo" aria-hidden="true"></span>
          <div class="trusted-quote-content">
            <blockquote class="trusted-quote">
              &ldquo;Probo handled our SOC 2 and compliance, so we could focus
              on building.&rdquo;
            </blockquote>

            <div class="trusted-author">
              <div class="trusted-author-copy">
                <div class="trusted-author-name">Paul Sinai</div>
                <div class="trusted-author-role">
                  CEO &amp; Co-founder of Blaxel
                </div>
              </div>
              <Image
                src={PaulSinai}
                alt="Paul Sinai"
                width={48}
                height={48}
                densities={[1, 2]}
                class="trusted-avatar"
                loading="lazy"
              />
            </div>
          </div>

          <div class="trusted-logo-block">
            <p>Trusted by teams building compliance-ready workflows</p>
            <div class="trusted-logo-rail" aria-label="Trusted companies">
              <LogosScroll class="trusted-logo-ticker" client:load>
                {
                  trustedLogos.map((logo) => (
                    <span class:list={["trusted-logo-item", logo.class]}>
                      <img
                        src={logo.src}
                        alt={logo.alt}
                        width={logo.width}
                        height={logo.height}
                        loading="lazy"
                        decoding="async"
                      />
                    </span>
                  ))
                }
              </LogosScroll>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="container pt-16 sm:pt-32">
      <h2
        class="mb-6 text-center text-[1.875rem] leading-9 font-semibold tracking-[-1px] text-[#141e12]"
        data-trust-reveal
      >
        Frequently asked questions
      </h2>
      <div class="faq-accordion mx-auto max-w-[768px]" data-faq-accordion>
        {
          faqs.map((faq, index) => (
            <div
              class="faq-item"
              data-faq-item
              data-trust-reveal
              style={`--trust-reveal-delay: ${index * 60}ms`}
            >
              <h3>
                <button
                  class="faq-trigger"
                  type="button"
                  id={`trust-center-faq-trigger-${index}`}
                  aria-expanded="false"
                  aria-controls={`trust-center-faq-panel-${index}`}
                  data-faq-trigger
                >
                  <span>{faq.question}</span>
                  <span class="faq-icon" aria-hidden="true">
                    <i class="ph ph-plus faq-icon-plus" />
                    <i class="ph ph-minus faq-icon-minus" />
                  </span>
                </button>
              </h3>
              <div
                class="faq-panel"
                id={`trust-center-faq-panel-${index}`}
                role="region"
                aria-labelledby={`trust-center-faq-trigger-${index}`}
                aria-hidden="true"
                data-faq-panel
              >
                <div class="faq-panel-inner">
                  <p>{faq.answer}</p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </section>
    <ProductDiscovery />
  </main>
</Layout>

<script>
  const initTrustCenterAnimations = () => {
    const materialVisuals = Array.from(
      document.querySelectorAll<HTMLElement>("[data-trust-material-visual]"),
    );
    const revealTargets = Array.from(
      document.querySelectorAll<HTMLElement>("[data-trust-reveal]"),
    );

    if (materialVisuals.length === 0 && revealTargets.length === 0) {
      return;
    }

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (prefersReducedMotion || !("IntersectionObserver" in window)) {
      materialVisuals.forEach((visual) => {
        visual.classList.add("is-visible");
      });
      revealTargets.forEach((target) => {
        target.classList.add("is-visible");
      });
      return;
    }

    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) {
            return;
          }

          entry.target.classList.add("is-visible");
          revealObserver.unobserve(entry.target);
        });
      },
      { threshold: 0.18, rootMargin: "0px 0px -8% 0px" },
    );

    const materialObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) {
            return;
          }

          entry.target.classList.add("is-visible");
          materialObserver.unobserve(entry.target);
        });
      },
      { threshold: 0.35 },
    );

    revealTargets.forEach((target) => {
      if (target.dataset.revealReady === "true") {
        return;
      }

      target.dataset.revealReady = "true";
      target.classList.add("is-awaiting-reveal");
      revealObserver.observe(target);
    });

    materialVisuals.forEach((visual) => {
      if (visual.dataset.motionReady === "true") {
        return;
      }

      visual.dataset.motionReady = "true";
      visual.classList.add("is-awaiting-animation");
      materialObserver.observe(visual);
    });
  };

  const initTrustCenterFaq = () => {
    const faqAccordions = Array.from(
      document.querySelectorAll<HTMLElement>("[data-faq-accordion]"),
    );

    faqAccordions.forEach((faqAccordion) => {
      if (faqAccordion.dataset.faqReady === "true") {
        return;
      }

      faqAccordion.dataset.faqReady = "true";

      const faqItems = Array.from(
        faqAccordion.querySelectorAll<HTMLElement>("[data-faq-item]"),
      );

      const setFaqItemState = (item: HTMLElement, shouldOpen: boolean) => {
        const trigger =
          item.querySelector<HTMLButtonElement>("[data-faq-trigger]");
        const panel = item.querySelector<HTMLElement>("[data-faq-panel]");

        if (!trigger || !panel) {
          return;
        }

        item.classList.toggle("is-open", shouldOpen);
        trigger.setAttribute("aria-expanded", String(shouldOpen));
        panel.setAttribute("aria-hidden", String(!shouldOpen));
      };

      faqItems.forEach((item, index) => {
        const trigger =
          item.querySelector<HTMLButtonElement>("[data-faq-trigger]");

        if (!trigger) {
          return;
        }

        trigger.addEventListener("click", () => {
          const shouldOpen = !item.classList.contains("is-open");

          faqItems.forEach((faqItem) => {
            setFaqItemState(faqItem, faqItem === item && shouldOpen);
          });
        });

        trigger.addEventListener("keydown", (event) => {
          const lastIndex = faqItems.length - 1;
          const nextIndex =
            event.key === "ArrowDown"
              ? Math.min(index + 1, lastIndex)
              : event.key === "ArrowUp"
                ? Math.max(index - 1, 0)
                : event.key === "Home"
                  ? 0
                  : event.key === "End"
                    ? lastIndex
                    : index;

          if (nextIndex === index) {
            return;
          }

          event.preventDefault();
          faqItems[nextIndex]
            ?.querySelector<HTMLButtonElement>("[data-faq-trigger]")
            ?.focus();
        });
      });
    });
  };

  const initTrustCenterPage = () => {
    initTrustCenterAnimations();
    initTrustCenterFaq();
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initTrustCenterPage, {
      once: true,
    });
  } else {
    initTrustCenterPage();
  }
</script>

