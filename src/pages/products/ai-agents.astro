---
import "@phosphor-icons/web/regular";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import ProductDiscovery from "../../components/block/ProductDiscovery.astro";
import Button from "../../components/ui/Button.svelte";
import LogosScroll from "../../components/LogosScroll.svelte";
import LottiePlayer from "../../components/LottiePlayer.svelte";
import PaulSinai from "../../assets/testimonial/paul-sinai.jpg";
import BlaxelFounders from "../../assets/stories/blaxel-header.jpg";
import AiToolsGallery from "../../components/AiToolsGallery.svelte";
import aiClients from "../../data/ai-clients.json";

const pageTitle = "AI Agents for Compliance | Probo MCP";
const pageDescription =
  "Connect Claude, Cursor, ChatGPT, and any MCP client to more than 350 Probo tools, while scoped tokens keep every agent inside your existing permissions.";

const overviewFeatures = [
  {
    icon: "ph-file-code",
    title: "+350 tools, one connection",
    description:
      "Reach every Probo record from a single MCP endpoint, with tools and schemas discovered at connection time.",
  },
  {
    icon: "ph-slack-logo",
    title: "Works in the tools your team already opens",
    description:
      "Connect Claude, Cursor, VS Code, Windsurf, Zed, and OpenCode without building an integration.",
  },
  {
    icon: "ph-signature",
    title: "Scoped to what each person can already do",
    description:
      "Grant read-only or read-write scopes per resource, and never above the user’s own permissions.",
  },
  {
    icon: "ph-key",
    title: "Skills that know how to use the tools",
    description:
      "Install open-source compliance workflows next to the tools, so an agent follows a procedure instead of improvising.",
  },
  {
    icon: "ph-bell-simple",
    title: "Agents that act, not only report",
    description:
      "Create and update records so an agent can carry a piece of compliance work to the end.",
  },
];

type ReviewStep = {
  title: string;
  lottie: string;
  illustration: string;
  overlay: { x: number; y: number; width: number; height: number };
  reverse?: boolean;
  bullets: string[];
};

const reviewSteps: ReviewStep[] = [
  {
    title: "Install the plugin, then sign in",
    lottie: "/lottie/access-review/1.json",
    illustration: "workflow-connect-systems",
    overlay: { x: -97.5, y: 104.5, width: 704, height: 456 },
    bullets: [
      "Add the marketplace with claude plugin marketplace add getprobo/probo.",
      "Install with claude plugin install probo@probo, then run claude mcp login probo-us.",
      "Point at the US endpoint, the EU endpoint, or your own self-hosted origin.",
    ],
  },
  {
    title: "Connect the client your team already uses",
    lottie: "/lottie/access-review/2.json",
    illustration: "workflow-account-context",
    overlay: { x: 64, y: 64, width: 720, height: 654 },
    reverse: true,
    bullets: [
      "Sign in with interactive OAuth from Claude, Cursor, VS Code, Windsurf, and Zed.",
      "Use a static scoped token for clients that cannot run an interactive flow.",
      "Load the same package in Codex, OpenCode, and Cursor from one plugin manifest.",
    ],
  },
  {
    title: "Scope every agent before it connects",
    lottie: "/lottie/access-review/3.json",
    illustration: "workflow-review-decisions",
    // The SVG includes 29px of shadow to the left of the UI's Figma x=102.
    overlay: { x: 73, y: 65, width: 439, height: 607 },
    bullets: [
      "Grant v1:resource:read for read-only access, or v1:resource to allow writes.",
      "Keep access at the intersection of the token scopes and the user’s permissions.",
      "Rotate or replace a token without touching the person’s account.",
    ],
  },
  {
    title: "Ask questions against live compliance data",
    lottie: "/lottie/access-review/4.json",
    illustration: "workflow-audit-evidence",
    overlay: { x: 36, y: 103, width: 436, height: 458 },
    reverse: true,
    bullets: [
      "Query risks, controls, evidence, audits, and findings in plain language.",
      "Page through large result sets with cursors instead of truncated answers.",
      "Read the current state of your program without exporting anything first.",
    ],
  },
  {
    title: "Let agents do the work, not only describe it",
    lottie: "/lottie/access-review/1.json",
    illustration: "workflow-connect-systems",
    overlay: { x: -97.5, y: 104.5, width: 704, height: 456 },
    bullets: [
      "Create and update risks, measures, tasks, documents, and evidence.",
      "Build agentic workflows without writing an API client first.",
      "Check the behavior hints that mark each tool read only, destructive, idempotent, or open world.",
    ],
  },
];

const trustedLogos = [
  {
    src: "/clients/trace_for_good.svg",
    alt: "Trace for Good",
    class: "trusted-logo--trace",
    width: 1023,
    height: 154,
  },
  {
    src: "/clients/jimo.svg",
    alt: "Jimo",
    class: "trusted-logo--jimo",
    width: 72,
    height: 36,
  },
  {
    src: "/clients/lucis.svg",
    alt: "Lucis",
    class: "trusted-logo--lucis",
    width: 246,
    height: 74,
  },
  {
    src: "/clients/filz.svg",
    alt: "Filiz",
    class: "trusted-logo--filiz",
    width: 598,
    height: 240,
  },
  {
    src: "/clients/ahrefs.svg",
    alt: "Ahrefs",
    class: "trusted-logo--ahrefs",
    width: 74,
    height: 19,
  },
];

const faqs = [
  {
    question: "How do we connect our AI assistant?",
    answer:
      "With one endpoint. Point your MCP client at us.probo.com/api/mcp/v1 or eu.probo.com/api/mcp/v1, complete the OAuth flow, and the tools appear.",
  },
  {
    question: "Does it work with self-hosted Probo?",
    answer:
      "Yes. Use the same /api/mcp/v1 endpoint on your own Probo origin, with the authentication and permissions of your deployment.",
  },
  {
    question: "Which AI agents and assistants are supported?",
    answer:
      "Connect Claude, ChatGPT, Codex, Cursor, VS Code, Windsurf, Zed, OpenCode, or another compatible MCP client. The setup and authentication method depend on the client.",
  },
  {
    question: "What can an AI agent actually do in Probo?",
    answer:
      "Agents can query risks, controls, evidence, audits, and findings, and create or update records when you grant the required write scopes.",
  },
  {
    question: "Can the agent change our compliance data?",
    answer:
      "Only when both its token scopes and the connected user’s permissions allow it. Use read-only scopes when the agent only needs to inspect data.",
  },
  {
    question: "Can an AI agent see more than the person who connected it?",
    answer:
      "No. Access is limited to the intersection of the token scopes and the permissions of the person who connected it.",
  },
  {
    question: "Do we have to update anything when Probo adds tools?",
    answer:
      "Clients discover the available tools and their schemas when they connect. Reconnect to discover newly available tools, subject to your granted scopes.",
  },
  {
    question: "Is this a proprietary integration?",
    answer:
      "No. Probo uses the open Model Context Protocol, so compatible clients can connect without a proprietary integration.",
  },
  {
    question: "What is the difference between the tools and the skills?",
    answer:
      "Tools let an agent read or change Probo records. Skills provide reusable compliance workflows that guide how the agent uses those tools.",
  },
  {
    question: "Can we read, fork, or write our own skills?",
    answer:
      "Yes. The compliance skills are open source, so you can read them, adapt them to your procedures, or write your own.",
  },
  {
    question: "Who decides what an agent is allowed to touch?",
    answer:
      "You choose the token scopes, and Probo enforces the connected user’s existing permissions on every operation.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};

const softwareApplicationSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Probo AI Agents",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description: pageDescription,
  url: "https://www.probo.com/products/ai-agents",
  publisher: {
    "@type": "Organization",
    name: "Probo",
    url: "https://www.probo.com",
  },
};
