const faqs = [
  {
    question: "What systems can we connect?",
    answer:
      "Connect 60+ identity, cloud, source code, SaaS, and finance providers. Import a CSV for anything else.",
  },
  {
    question: "What if a system has no connector?",
    answer:
      "Import a CSV export and review it alongside your connected sources. Replace the CSV before the next campaign whenever you need a fresher snapshot.",
  },
  {
    question: "Can we review service accounts, not just people?",
    answer:
      "Yes. Probo marks service accounts separately from people when the provider or CSV identifies them, so reviewers can assess non-human credentials in the same campaign.",
  },
  {
    question: "Can reviewers approve in bulk?",
    answer:
      "Yes. Select multiple accounts and apply a decision or flags in bulk. Revoke, Modify, and Escalate still require a note that stays with the review.",
  },
  {
    question: "Is the review live data or a snapshot?",
    answer:
      "A campaign is a point-in-time snapshot. Provider data may keep changing, but the accounts, context, and decisions in that review stay preserved.",
