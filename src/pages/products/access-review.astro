    title: "Campaigns",
    description:
      "Scope a review to the systems that matter, then snapshot them in one click.",
  },
  {
    illustration: "capability-sources",
    title: "Sources",
    description: "Connect providers and reuse them across campaigns.",
  },
  {
    illustration: "capability-access-entries",
    title: "Access entries",
    description:
      "Every account with role, admin, MFA, and last login context to decide fast.",
  },
  {
    illustration: "capability-flags",
    title: "Flags",
    description:
      "Orphaned, dormant, over-privileged, and shared accounts surfaced automatically.",
  },
  {
    illustration: "capability-decisions",
    title: "Decisions",
    description:
      "Approve, revoke, defer, or escalate, with justifications kept on record.",
  },
  {
    illustration: "capability-statistics-export",
    title: "Statistics & export",
    description:
      "Live counts by decision and flag, plus a PDF record auditors accept.",
