const overviewFeatures = [
  {
    icon: "ph-plugs-connected",
    title: "Pull access from your whole stack",
    description:
      "Bring accounts from Google Workspace, Okta, GitHub, cloud infrastructure, Slack, and Brex into one review.",
  },
  {
    icon: "ph-camera",
    title: "A snapshot, frozen for the record",
    description:
      "Freeze who had access to what when the campaign starts, regardless of later changes.",
  },
  {
    icon: "ph-check-circle",
    title: "Decide in one click, at scale",
    description:
      "Approve, revoke, defer, or escalate, individually or in bulk. Notes are required except for approvals.",
  },
  {
    icon: "ph-flag",
    title: "Flags that surface risky accounts",
    description:
      "Probo flags orphaned, dormant, over-privileged, and shared accounts for priority review.",
  },
  {
    icon: "ph-arrows-clockwise",
    title: "See what changed since last quarter",
    description:
      "Each campaign tags accounts as new, removed, or unchanged since the last.",
  },
  {
    icon: "ph-seal-check",
    title: "Evidence auditors accept",
    description:
      "Export a closed campaign as a PDF recording who reviewed what, and why.",
  },
];

type ReviewStep = {
  title: string;
  lottie: string;
  illustration: string;
  overlay: { x: number; y: number; width: number; height: number };
  reverse?: boolean;
  bullets: string[];
