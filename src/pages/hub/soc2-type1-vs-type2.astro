---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ArticleSchema from "../../components/schema/ArticleSchema.astro";
import FAQSchema from "../../components/schema/FAQSchema.astro";
import AuthorAvatar from "../../components/blog/AuthorAvatar.astro";
import BlogToc from "../../components/blog/BlogToc.astro";
import BlogCard from "../../components/blog/BlogCard.astro";
import BlogEnhancements from "../../components/blog/BlogEnhancements.astro";
import WrittenBy from "../../components/block/WrittenBy.astro";
import { blogDate } from "../../lib/blog";
import { getCanonicalUrl } from "../../lib/i18n.ts";
import "../../styles/journal.css";

const pageTitle = "SOC 2 Type 1 vs Type 2: which one you need";
const pageDescription =
  "SOC 2 Type 1 checks your controls on one day. Type 2 checks them over 3+ months. What each costs, how long it takes, and when Type 1 is worth it.";
const deck =
  "Same checklist. Type 1 checks it on one day, Type 2 over at least three months. How to pick, what each costs, and what to show your customer while the audit runs.";
const author = "Arthur Mayoux";
const datePublished = "2026-04-07";
const dateModified = "2026-11-06";
const canonical = getCanonicalUrl(Astro.url);

const toc = [
  { depth: 2, slug: "difference", text: "What actually differs" },
  { depth: 2, slug: "which-one", text: "Which one you need" },
  { depth: 2, slug: "while-you-wait", text: "What to show while you wait" },
  { depth: 2, slug: "timeline", text: "A real timeline" },
  { depth: 2, slug: "cost", text: "What each costs" },
  { depth: 2, slug: "after", text: "After the first report" },
  { depth: 2, slug: "how-probo-helps", text: "How Probo helps" },
  { depth: 2, slug: "bottom-line", text: "The bottom line" },
  {
    depth: 2,
    slug: "frequently-asked-questions",
    text: "Frequently asked questions",
  },
];

const comparison = [
  {
    aspect: "What the auditor checks",
    type1: "Your controls are designed correctly, on one date",
    type2:
      "Your controls are designed correctly and worked, every day of a period",
  },
  {
    aspect: "Period covered",
    type1: "A single day",
    type2: "At least 3 months for a first report, up to 12",
  },
  {
    aspect: "Checklist you prepare",
    type1: "The same",
    type2: "The same",
  },
  {
    aspect: "Evidence",
    type1: "A snapshot: policies, settings, screenshots",
    type2:
      "Samples across the period: access reviews, onboarding, offboarding, incidents, changes",
  },
  {
    aspect: "Report in hand",
    type1: "A few weeks after your controls are in place",
    type2: "About 3 to 4 months after you start",
  },
  {
    aspect: "Audit fee",
    type1: "Depends on the firm: about $5,000 to $40,000",
    type2:
      "Depends on the firm: about $5,000 to $40,000. Doing both with the same firm usually comes as a bundle",
  },
  {
    aspect: "What buyers do with it",
    type1: "Accept it as a stopgap, ask when the Type 2 lands",
    type2: "Accept it. This is the report security teams expect",
  },
];

const faqs = [
  {
    question: "What is the difference between SOC 2 Type 1 and Type 2?",
    answer:
      "Both reports cover the same controls. A Type 1 says your controls were designed correctly on a single date. A Type 2 says they were designed correctly and actually worked over a period, at least three months for a first report. The checklist you prepare is the same; Type 2 adds the observation period.",
  },
  {
    question: "Should I get a SOC 2 Type 1 before the Type 2?",
    answer:
      "Usually not. Most audit firms offer a bundle if you do both with them (about $1,500 more with the firm most of our customers use), but it is still a second report and a second round of auditor requests, and most buyers ask when the Type 2 is coming anyway. Only three of our customers ever needed a Type 1, each because a deal was closing within about six weeks. Everyone else went straight to Type 2 and showed the auditor's engagement letter while the observation period ran.",
  },
  {
    question: "How much does a SOC 2 Type 1 cost compared to a Type 2?",
    answer:
      "It depends mostly on the audit firm. A Type 2 audit ranges from about $5,000 with a smaller peer-reviewed CPA firm to $40,000 with the large audit brands, and a Type 1 on its own sits in the same range. Most firms offer a bundle if you do both with them. Headcount and infrastructure move it too. The audit is only one of three costs: with the platform and the people doing the work, a startup under 15 people using a smaller peer-reviewed firm pays about $15,000 for year one.",
  },
  {
    question: "How long is the SOC 2 Type 2 observation period?",
    answer:
      "Between three and twelve months. For a first report, three months is the norm and what most buyers accept. After that, each yearly report usually covers the twelve months since the last one, so there is no gap in coverage.",
  },
  {
    question: "Do enterprise customers accept a SOC 2 Type 1?",
    answer:
      "Some accept it as a temporary answer, almost always with a follow-up question: when is the Type 2? Large enterprises and regulated buyers generally want the Type 2. If a buyer needs something today, an auditor's engagement letter with the audit dates, plus a completed security questionnaire, often does the same job as a Type 1.",
  },
];

const relatedIds = [
  "2025-03-04-what-is-soc2-cost",
  "2026-09-17-how-to-announce-soc-2-in-progress",
];
const posts = await getCollection("blog");
const related = relatedIds
  .map((id) => posts.find((post) => post.id.split("/").at(-1) === id))
  .filter((post) => post !== undefined);

const site = Astro.site ?? new URL("https://www.probo.com");
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: new URL("/", site).toString(),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Hub",
      item: new URL("/hub", site).toString(),
    },
    { "@type": "ListItem", position: 3, name: pageTitle },
  ],
};
---

<Layout
  journal
  noFrameworks
  title={pageTitle}
  description={pageDescription}
  ogType="article"
>
  <ArticleSchema
    title={pageTitle}
    description={pageDescription}
    url="https://www.probo.com/hub/soc2-type1-vs-type2"
    datePublished={datePublished}
    dateModified={dateModified}
  />
  <FAQSchema faqs={faqs} />
  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  />
  <main class="journal-container journal-article">
    <nav class="journal-breadcrumb" aria-label="Breadcrumb">
      <a href="/hub" class="journal-back"
        ><img src="/blog/icons/back.svg" width="16" height="16" alt="" />Hub</a
      >
      <span aria-hidden="true">/</span>
      <a href="/hub/soc2" class="journal-category">SOC 2</a>
    </nav>
    <header class="journal-hero">
      <h1>{pageTitle}</h1>
      <p class="journal-deck">{deck}</p>
      <p class="journal-metadata items-center">
        <span class="inline-flex items-center gap-2">
          <AuthorAvatar author={author} size="medium" loading="eager" />
          {author}
        </span><span aria-hidden="true">·</span><span
          >Updated <time datetime={dateModified}
            >{blogDate.format(new Date(dateModified))}</time
          ></span
        ><span aria-hidden="true">·</span><span>7 min read</span>
      </p>
    </header>
    <div class="journal-reading-layout">
      <BlogToc headings={toc} />
      <div class="journal-reading-column">
        <article class="journal-prose" data-article-body>
          <p>
            A customer asked for your SOC 2 report, and the first question every
            guide throws at you is Type 1 or Type 2. Most of them make it sound
            like a big strategic choice. For most startups it isn't.
          </p>
          <p>
            The checklist is the same for both. A Type 1 looks at your controls
            on one day. A Type 2 looks at the same controls over a period of at
            least three months. Your customer's security team wants the Type 2,
            so that's the one to start.
          </p>

          <h2 id="key-takeaways">Key takeaways</h2>
          <ul>
            <li>
              <strong>Same work, different window.</strong> Type 2 adds an observation
              period, not a different checklist.
            </li>
            <li>
              <strong>Go straight to Type 2.</strong> Doing both means paying for
              a second report, and buyers still ask when the Type 2 is coming.
            </li>
            <li>
              <strong>Type 1 has one good use.</strong> A signed deal that needs a
              report in the next six weeks.
            </li>
            <li>
              <strong>You are not empty-handed while you wait.</strong> An auditor's
              engagement letter with dates, and an honest "SOC 2 in progress" line,
              carry most deals to the report.
            </li>
          </ul>

          <h2 id="difference">
            What actually differs between Type 1 and Type 2?
          </h2>
          <p>
            SOC 2 is not a certification. It's an attestation report, written
            and signed by a licensed CPA firm after it examines your controls
            (here is <a href="/blog/2025-10-28-what-is-soc2"
              >what SOC 2 actually is</a
            >). Type 1 and Type 2 are two flavours of that report.
          </p>
          <p>
            A <strong>Type 1</strong> answers one question: on this date, were your
            controls designed correctly? The auditor reads your policies, checks your
            settings and takes a snapshot.
          </p>
          <p>
            A <strong>Type 2</strong> answers a harder one: over this period, did
            your controls actually work? The auditor picks samples across the window.
            Was that new hire's access approved? Was the leaver offboarded the same
            day? Did someone review access last quarter? A policy that exists only
            on paper shows up here.
          </p>
          <table>
            <thead>
              <tr>
                <th></th>
                <th>Type 1</th>
                <th>Type 2</th>
              </tr>
            </thead>
            <tbody>
              {
                comparison.map((row) => (
                  <tr>
                    <td>
                      <strong>{row.aspect}</strong>
                    </td>
                    <td>{row.type1}</td>
                    <td>{row.type2}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
          <p>
            Both reports use the same Trust Services Criteria. Security is the
            only one that is required, and it's the only one most startups need.
            Add availability, confidentiality, processing integrity or privacy
            only when a customer asks for it in writing.
          </p>

          <h2 id="which-one">Which one do you need?</h2>
          <p>
            <strong>Default: go straight to Type 2.</strong> The work to get ready
            is identical, and the Type 2 is what your buyer's security team will ask
            for in the end. A Type 1 first means paying for a second report, answering
            the auditor twice, and still getting the "when is your Type 2?" email.
          </p>
          <p>
            We have run hundreds of audits. Only three of our customers ever
            needed a Type 1. Each time, the reason was the same.
          </p>
          <h3>When a Type 1 is the right call</h3>
          <ul>
            <li>
              <strong>A deal closes in the next six weeks</strong> and the buyer wrote
              that they need a report, not a letter. A Type 1 gets you a signed report
              fast, and the Type 2 observation period starts the same day.
            </li>
            <li>
              <strong>Your infrastructure is about to change</strong>, for
              example a cloud migration next quarter. A Type 1 now covers the
              gap, and the Type 2 window starts once the new setup is stable, so
              you don't audit a system you are about to throw away.
            </li>
          </ul>
          <h3>When you might not need either yet</h3>
          <p>
            If no customer has asked in writing, wait. SOC 2 is a business
            decision, not a rite of passage. Here is <a
              href="/blog/2026-04-22-do-you-need-a-soc-2-report"
              >how to decide if you need a SOC 2 report</a
            >, and <a href="/blog/2025-10-08-soc2-or-iso27001"
              >whether SOC 2 or ISO 27001 fits your buyers</a
            > better.
          </p>

          <h2 id="while-you-wait">
            What do you show your customer while the Type 2 runs?
          </h2>
          <p>
            This is the real reason founders reach for a Type 1: a customer
            wants proof now, and three months feels long. In practice,
            enterprise buyers rarely need the report on day one. They need
            confidence that it's coming, with a date.
          </p>
          <p>Three things give them that:</p>
          <ol>
            <li>
              <strong>An engagement letter from the auditor</strong>, naming the
              CPA firm, the report type and the observation dates. It's a
              document a security team can file.
            </li>
            <li>
              <strong>A dated "SOC 2 in progress" line</strong> on your security page:
              "Type 2 examination with [firm], observation period 1 December to 28
              February, report expected in March." Here is <a
                href="/blog/2026-09-17-how-to-announce-soc-2-in-progress"
                >how to announce SOC 2 in progress</a
              > without overclaiming, with an email template.
            </li>
            <li>
              <strong>Your security questionnaire, answered</strong>, and your
              policies available under NDA. Most buyers send a questionnaire
              with or without a report anyway.
            </li>
          </ol>
          <p>
            One rule: only say "in progress" when it's true. Signing up for a
            compliance tool is not a status. An auditor booked with dates is.
          </p>

          <h2 id="timeline">
            What does the timeline look like with real dates?
          </h2>
          <p>
            "About three months" is hard to plan around. Here is what a Type 2
            looks like for a startup that starts in November:
          </p>
          <table>
            <thead>
              <tr>
                <th>When</th>
                <th>What happens</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Week 1</strong></td>
                <td
                  >Auditor booked, engagement letter signed, "in progress" line
                  goes on the security page</td
                >
              </tr>
              <tr>
                <td><strong>November</strong></td>
                <td
                  >Risk analysis, policies written for your company, vendor
                  reviews, controls switched on</td
                >
              </tr>
              <tr>
                <td><strong>1 December to 28 February</strong></td>
                <td
                  >Observation period: controls run, evidence is collected as it
                  happens</td
                >
              </tr>
              <tr>
                <td><strong>March</strong></td>
                <td>Auditor fieldwork, then the signed report</td>
              </tr>
            </tbody>
          </table>
          <p>
            Ask any auditor for their lead time before you commit to a date.
            Booking the audit early is what keeps the project moving. More on <a
              href="/blog/2025-10-09-how-long-for-soc2">how long SOC 2 takes</a
            >.
          </p>
          <p>
            If a customer's contract depends on the report, write the date into
            that contract: certified within four months. Sign with your
            compliance provider the day the customer signs with you, and the
            money goes out after the revenue it unlocks.
          </p>

          <h2 id="cost">What does each one cost?</h2>
          <p>
            The audit fee depends mostly on who signs the report. A Type 2
            ranges from about $5,000 with a smaller US peer-reviewed CPA firm to
            $40,000 with the large audit brands. A Type 1 on its own sits in the
            same range. If you do both with the same firm, most offer a bundle
            well below the price of two separate audits. Your headcount, your
            infrastructure and the Trust Services Criteria you include move the
            price within that range.
          </p>
          <p>
            For a company under 15 people, the peer-reviewed firm most of our
            customers use charges about $5,000 for a Type 2, and about $6,500
            for a Type 1 plus a Type 2. Whichever firm you pick, ask for the
            Type 2 alone and the bundle side by side. Pay for a big brand only
            when a customer insists on a name.
          </p>
          <p>
            The audit is one of three costs. The platform and the people doing
            the work are the other two, and the people are the biggest line,
            whether you pay a provider or spend 40 to 100 hours of your own
            time. All in, a startup under 15 people working with a smaller
            peer-reviewed firm pays about $15,000 for year one. Full breakdown
            by company size: <a href="/blog/2025-03-04-what-is-soc2-cost"
              >SOC 2 cost in 2026</a
            >.
          </p>
          <p>
            Be wary of $1,000 or $2,000 audits. A SOC 2 report is worth the
            auditor who signs it, and your customer's security team will <a
              href="/hub/evaluate-soc2-report-quality">read the report</a
            >. Ask who signs it, ask for the firm's AICPA peer review letter,
            and check it on the AICPA site.
          </p>

          <h2 id="after">What happens after the first report?</h2>
          <p>
            A Type 2 covers a period, so it ages. Buyers usually want a report
            that ended within the last twelve months. The next observation
            period starts the day after the previous one ends, and the next
            report covers the full year.
          </p>
          <p>
            Between two reports, if a customer asks whether anything changed,
            you send a bridge letter: a short letter signed by your management
            saying no significant change happened since the last report ended.
            The controls keep running all year. That's the part tools leave to
            you, and the part that slips first.
          </p>

          <h2 id="how-probo-helps">How Probo helps you get the Type 2</h2>
          <p>
            Probo is an open-source compliance platform plus a compliance
            officer who does the work. We do the compliance, you do the tech.
            Here is what that looks like for a SOC 2 Type 2:
          </p>
          <ul>
            <li>
              <strong>The right report, on day one.</strong> We tell you whether you
              need a Type 1 at all (usually not), which Trust Services Criteria to
              include, and whether SOC 2 or ISO 27001 fits your buyers.
            </li>
            <li>
              <strong>Proof the day after you sign.</strong> An engagement letter
              from Probo, then one from the auditor with the audit dates, so you can
              answer your customer within the week.
            </li>
            <li>
              <strong>An auditor you can verify.</strong> We book a peer-reviewed
              CPA firm within a week, or work with the auditor you already chose after
              a reference check. You pay the auditor at cost. We take no margin on
              the audit.
            </li>
            <li>
              <strong>The work done for you.</strong> Your compliance officer runs
              the risk analysis, writes the policies for your company (not templates),
              reviews your vendors, collects evidence with you during the observation
              period and handles the auditor's requests. You spend 5 to 10 hours of
              engineering time over the whole project.
            </li>
            <li>
              <strong>A trust page that says where you stand.</strong> Your <a
                href="/products/compliance-portal">compliance portal</a
              > shows "SOC 2 Type 2 in progress" while the audit runs, then shares
              the report and your policies with buyers once it's signed.
            </li>
            <li>
              <strong>The year after.</strong> The next observation period starts
              right away. We run the access reviews, vendor reviews and policy updates
              through the year so the next report is not a scramble.
            </li>
            <li>
              <strong>No lock-in.</strong> The platform is open source. Your data
              is exportable at any time, and you can self-host if you leave.
            </li>
          </ul>
          <p>
            If a deal really does need a Type 1 in the next few weeks, we set it
            up the same way and start the Type 2 window the same day.
          </p>

          <h2 id="bottom-line">The bottom line</h2>
          <p>
            Type 1 and Type 2 are the same work. The Type 2 is the report your
            customer will ask for, so start there, book the auditor early, and
            show the engagement letter while the observation period runs. Keep
            the Type 1 for the deal that cannot wait six weeks.
          </p>
          <p>
            If a customer just asked for your report, <a href="/contact"
              >book a 15-minute call</a
            >. Send us their email, and we'll tell you which report you need,
            the dates, and the full price, audit included, on the call.
          </p>

          <section aria-labelledby="frequently-asked-questions">
            <h2 id="frequently-asked-questions">Frequently asked questions</h2>
            {
              faqs.map((faq) => (
                <div class="journal-faq">
                  <h3>{faq.question}</h3>
                  <p>{faq.answer}</p>
                </div>
              ))
            }
          </section>
        </article>
        <WrittenBy author={author} variant="journal" />
        <div class="journal-share" aria-label="Share this article">
          <button type="button" data-copy-link={canonical}
            ><img
              src="/blog/icons/link.svg"
              alt=""
              width="16"
              height="16"
            /><span>Copy Link</span></button
          >
          <a
            href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonical)}`}
            target="_blank"
            rel="noopener noreferrer"
            ><img
              src="/blog/icons/linkedin.svg"
              alt=""
              width="16"
              height="16"
            />Share on LinkedIn</a
          >
          <p class="sr-only" aria-live="polite" data-copy-status></p>
        </div>
      </div>
    </div>
    <section class="journal-related" aria-labelledby="keep-reading">
      <h2 id="keep-reading">Keep reading</h2>
      <div class="journal-grid">
        {related.map((post) => <BlogCard post={post} />)}
      </div>
    </section>
  </main>
  <BlogEnhancements />
</Layout>
