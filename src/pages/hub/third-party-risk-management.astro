---
import Layout from "../../layouts/Layout.astro";
import ArticleSchema from "../../components/schema/ArticleSchema.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";

const tableOfContents = [
  { id: "intro", label: "What Is TPRM?" },
  { id: "why-tprm", label: "Why Third-Party Risk Is Growing" },
  { id: "lifecycle", label: "The TPRM Lifecycle" },
  { id: "best-practices", label: "TPRM Best Practices" },
  { id: "probo-support", label: "How Probo Supports TPRM" },
];
---

<Layout
  title="What Is Third-Party Risk Management (TPRM)?"
  description="Learn what Third-Party Risk Management (TPRM) is, why it matters for ISO 27001 and SOC 2, and best practices for managing vendor and supplier risks."
>
  <ArticleSchema
    title="What Is Third-Party Risk Management (TPRM)?"
    description="Learn what Third-Party Risk Management (TPRM) is, why it matters for compliance frameworks like ISO 27001 and SOC 2, and best practices for managing vendor and supplier risks."
    url="https://www.probo.com/hub/third-party-risk-management"
    image="https://www.probo.com/og.png"
    datePublished="2025-01-01"
    dateModified="2026-08-06"
  />
  <main class="container my-10 sm:my-20">
    <Breadcrumbs
      items={[
        { label: "Hub", href: "/hub" },
        { label: "Third-Party Risk Management" },
      ]}
      class="mb-6"
    />
    <!-- Header -->
    <header class="mx-auto mb-12 max-w-[900px] text-center sm:mb-16">
      <h1
        class="text-foreground mb-6 text-[2.5rem] leading-[1.1] font-semibold tracking-[-0.02em] sm:text-[3.5rem]"
      >
        What Is
        <span class="highlight-text">Third-Party Risk Management</span>
        (TPRM)?
      </h1>
      <p class="text-muted-foreground text-lg">
        Modern organizations rarely operate alone. Cloud providers, SaaS tools,
        payment processors, logistics partners, consultants, and outsourced
        service providers are now deeply embedded in daily operations. While
        these third parties enable scale, speed, and innovation, they also
        introduce a growing and often underestimated source of exposure to your
        business:
        <strong class="text-foreground">third-party risk</strong>.
      </p>
    </header>

    <!-- Content with TOC -->
    <div class="flex flex-col gap-10 lg:flex-row lg:gap-16">
      <!-- Table of Contents - Sidebar -->
      <aside class="shrink-0 lg:w-56">
        <nav class="lg:sticky lg:top-24">
          <div class="flex flex-col gap-2">
            {
              tableOfContents.map((item) => (
                <button
                  type="button"
                  data-section={item.id}
                  class="toc-link cursor-pointer border-none bg-transparent p-0 text-left text-sm leading-5 text-[#6b716a] transition-colors hover:text-[#141e12]"
                >
                  {item.label}
                </button>
              ))
            }
          </div>
        </nav>
      </aside>

      <!-- Main Content -->
      <article class="max-w-[720px] flex-1">
        <!-- Introduction -->
        <section id="intro" class="mb-12 scroll-mt-24">
          <h2
            class="text-foreground mb-6 text-2xl font-semibold tracking-[-0.01em] sm:text-[1.75rem]"
          >
            What Is Third-Party Risk Management?
          </h2>
          <div class="text-muted-foreground space-y-4 leading-relaxed">
            <p>
              This is where
              <strong class="text-foreground"
                >Third-Party Risk Management (TPRM)</strong
              >
              comes in, and this is why it is important for compliance frameworks
              such as ISO 27001 or
              <a
                href="/blog/2025-10-28-what-is-soc2"
                class="font-semibold text-[#5d770d] hover:underline">SOC 2</a
              >
              as we mentioned in our article
              <a
                href="/blog/2025-09-11-what-are-the-steps-toward-compliance"
                class="font-semibold text-[#5d770d] hover:underline"
                >What Are The Steps Toward Compliance</a
              >.
            </p>
            <p>
              Third-Party Risk Management (TPRM) is the discipline of
              <strong class="text-foreground">
                identifying, assessing, mitigating, and continuously monitoring
                risks that exist from relationships with external parties</strong
              >
              , such as vendors, suppliers, partners, contractors, and service providers.
            </p>
            <p>These risks go far beyond cybersecurity. A third party may:</p>
            <ul class="ml-0 list-none space-y-3">
              <li class="flex items-start gap-2">
                <span class="text-muted-foreground">•</span>
                <span>Access sensitive customer or employee data</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-muted-foreground">•</span>
                <span>Connect directly to internal systems</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-muted-foreground">•</span>
                <span>Perform a business-critical service</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-muted-foreground">•</span>
                <span> Operate in a regulated or high-risk jurisdiction</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-muted-foreground">•</span>
                <span> Rely on fourth parties you don't directly control</span>
              </li>
            </ul>
            <p>
              TPRM provides organizations with
              <strong class="text-foreground"
                >visibility, control, and assurance</strong
              >
              over this extended ecosystem. Ensuring that third parties meet security,
              compliance, operational, and ethical expectations throughout the entire
              relationship lifecycle.
            </p>
            <p>
              In practice, TPRM often overlaps with terms like vendor risk
              management (VRM) or supply chain risk management, it is actually
              covering all third-party risks across the enterprise.
            </p>
          </div>
        </section>

        <hr class="border-border-low mb-12" />

        <!-- Why Third-Party Risk Is a Growing Concern -->
        <section id="why-tprm" class="mb-12 scroll-mt-24">
          <h2
            class="text-foreground mb-6 text-2xl font-semibold tracking-[-0.01em] sm:text-[1.75rem]"
          >
            Why Third-Party Risk Is a Growing Concern
          </h2>
          <div class="text-muted-foreground space-y-4 leading-relaxed">
            <p>
              Third-party risk has become a board-level issue for several
              reasons:
            </p>

            <div class="mt-6 space-y-6">
              <div>
                <h3 class="text-foreground mb-2 text-lg font-semibold">
                  1. Expanding attack surfaces
                </h3>
                <p>
                  Even organizations with strong internal security controls
                  remain vulnerable if their vendors have weaker defenses. Many
                  major data breaches now originate through third-party access
                  rather than direct compromise.
                </p>
              </div>

              <div>
                <h3 class="text-foreground mb-2 text-lg font-semibold">
                  2. Increasing regulatory pressure
                </h3>
                <p>
                  Regulations such as GDPR, DORA, NIS2, SOC 2, and ISO 27001
                  explicitly extend accountability to third parties. A vendor's
                  failure can quickly become
                  <em>your</em>
                  compliance issue. Learn about the
                  <a
                    href="/blog/2025-09-11-what-are-the-steps-toward-compliance"
                    class="text-[#5d770d] hover:underline"
                    >key steps toward compliance</a
                  >.
                </p>
              </div>

              <div>
                <h3 class="text-foreground mb-2 text-lg font-semibold">
                  3. Operational dependency
                </h3>
                <p>
                  From cloud infrastructure to payroll processing, third parties
                  often support critical business functions. Outages, financial
                  instability, or delivery failures can directly disrupt
                  operations.
                </p>
              </div>

              <div>
                <h3 class="text-foreground mb-2 text-lg font-semibold">
                  4. Reputational and ESG exposure
                </h3>
                <p>
                  Unethical practices, data misuse, or regulatory violations by
                  a third party can severely damage your customer trust, even if
                  your organization is not directly responsible.
                </p>
              </div>
            </div>
          </div>
        </section>

        <hr class="border-border-low mb-12" />

        <!-- The Third-Party Risk Management Lifecycle -->
        <section id="lifecycle" class="mb-12 scroll-mt-24">
          <h2
            class="text-foreground mb-6 text-2xl font-semibold tracking-[-0.01em] sm:text-[1.75rem]"
          >
            The Third-Party Risk Management Lifecycle
          </h2>
          <div class="text-muted-foreground space-y-4 leading-relaxed">
            <p>
              An effective TPRM program can change depending on the relationship
              it exists between your business and the third party service.
            </p>

            <div class="mt-6 space-y-6">
              <div>
                <h3 class="text-foreground mb-2 text-lg font-semibold">
                  1. Third-party identification
                </h3>
                <p>
                  Organizations begin by building a comprehensive inventory of
                  all third parties.
                </p>
              </div>

              <div>
                <h3 class="text-foreground mb-2 text-lg font-semibold">
                  2. Evaluation and selection
                </h3>
                <p>
                  Before onboarding, vendors should be evaluated based on
                  business needs, inherent risk, regulatory requirements, and
                  alignment with internal policies.
                </p>
              </div>

              <div>
                <h3 class="text-foreground mb-2 text-lg font-semibold">
                  3. Risk assessment
                </h3>
                <p class="mb-3">
                  Risk assessments analyze exposure across multiple domains,
                  such as:
                </p>
                <ul class="ml-0 list-none space-y-2">
                  <li class="flex items-start gap-2">
                    <span class="text-muted-foreground">•</span>
                    <span>Information security</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-muted-foreground">•</span>
                    <span>Privacy and data protection</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-muted-foreground">•</span>
                    <span>Operational resilience</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-muted-foreground">•</span>
                    <span>Financial stability</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-muted-foreground">•</span>
                    <span>Compliance and regulatory risk</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-muted-foreground">•</span>
                    <span>Reputational and ethical risk</span>
                  </li>
                </ul>
                <p class="mt-3">
                  These assessments often rely on standardized frameworks (ISO,
                  NIST, SIG, SOC reports) combined with questionnaires and
                  evidence reviews.
                </p>
              </div>

              <div>
                <h3 class="text-foreground mb-2 text-lg font-semibold">
                  4. Risk mitigation
                </h3>
                <p>
                  Identified risks are prioritized and either accepted,
                  mitigated, or rejected based on the organization's risk
                  appetite. Mitigation actions may include control improvements,
                  contractual safeguards, or remediation plans.
                </p>
              </div>

              <div>
                <h3 class="text-foreground mb-2 text-lg font-semibold">
                  5. Contracting and onboarding
                </h3>
                <p>
                  Risk requirements are embedded into contracts through clauses
                  covering data protection, confidentiality, SLAs, audit rights,
                  and incident notification.
                </p>
              </div>

              <div>
                <h3 class="text-foreground mb-2 text-lg font-semibold">
                  6. Documentation and reporting
                </h3>
                <p>
                  All activities must be documented to support audits,
                  regulatory inquiries, and internal governance.
                </p>
              </div>

              <div>
                <h3 class="text-foreground mb-2 text-lg font-semibold">
                  7. Continuous monitoring
                </h3>
                <p>
                  Risk is not static. Ongoing monitoring tracks changes such as
                  security incidents, regulatory updates, financial
                  deterioration, or negative news affecting vendors.
                </p>
              </div>

              <div>
                <h3 class="text-foreground mb-2 text-lg font-semibold">
                  8. Offboarding
                </h3>
                <p>
                  When a relationship ends, access must be revoked, data
                  securely returned or deleted, and the offboarding process
                  documented to prevent residual risk.
                </p>
              </div>
            </div>
          </div>
        </section>

        <hr class="border-border-low mb-12" />

        <!-- TPRM Best Practices -->
        <section id="best-practices" class="mb-12 scroll-mt-24">
          <h2
            class="text-foreground mb-6 text-2xl font-semibold tracking-[-0.01em] sm:text-[1.75rem]"
          >
            TPRM Best Practices
          </h2>
          <div class="text-muted-foreground space-y-4 leading-relaxed">
            <p>
              At Probo, we try to optimize our third party risk management
              system by applying some best practices we recommend:
            </p>

            <div class="mt-6 space-y-6">
              <div>
                <h3 class="text-foreground mb-2 text-lg font-semibold">
                  Prioritize vendors by data and business risk
                </h3>
                <p class="mb-3">
                  Not all third parties present the same type of risk. A
                  practical way to prioritize vendors is to distinguish between <strong
                    class="text-foreground">data risk</strong
                  > and <strong class="text-foreground">business risk</strong>.
                </p>
                <p class="mb-3">
                  <strong class="text-foreground">Data risk</strong>
                  focuses on the impact of a data compromise. This depends on the
                  type and sensitivity of the data shared (personal data, financial
                  data, intellectual property) and any regulatory obligations attached
                  to it.
                </p>
                <p class="mb-3">
                  <strong class="text-foreground">Business risk</strong>
                  looks at operational impact. Vendors supporting critical services
                  or core infrastructure may pose high business risk if an issue occurs,
                  even if they handle limited data.
                </p>
                <p>
                  By assessing both dimensions together, organizations can
                  better prioritize vendors and apply the right level of
                  oversight, focusing effort where risk truly matters.
                </p>
              </div>

              <div>
                <h3 class="text-foreground mb-2 text-lg font-semibold">
                  Embed TPRM early in procurement
                </h3>
                <p>
                  Risk assessments should begin before contracts are signed, not
                  after onboarding.
                </p>
              </div>

              <div>
                <h3 class="text-foreground mb-2 text-lg font-semibold">
                  Automate wherever possible
                </h3>
                <p>
                  Manual questionnaires and spreadsheets do not scale.
                  Automation enables consistent assessments, real-time alerts,
                  reassessments, and reporting. This is a core advantage of
                  <a
                    href="/blog/2025-02-04-the-case-for-open-source-compliance"
                    class="text-[#5d770d] hover:underline"
                    >open-source compliance platforms</a
                  >.
                </p>
              </div>

              <div>
                <h3 class="text-foreground mb-2 text-lg font-semibold">
                  Maintain continuous monitoring
                </h3>
                <p>
                  Annual reviews are no longer sufficient. Organizations need
                  ongoing insight into vendor risk posture as conditions change.
                </p>
              </div>
            </div>
          </div>
        </section>

        <hr class="border-border-low mb-12" />

        <!-- How Platforms Like Probo Support Effective TPRM -->
        <section id="probo-support" class="mb-12 scroll-mt-24">
          <h2
            class="text-foreground mb-6 text-2xl font-semibold tracking-[-0.01em] sm:text-[1.75rem]"
          >
            How Platforms Like Probo Support Effective TPRM
          </h2>
          <div class="text-muted-foreground space-y-4 leading-relaxed">
            <p>
              As third-party ecosystems grow, managing risk manually becomes
              unsustainable. This is where modern compliance and risk platforms
              play a critical role.
            </p>
            <p>
              Solutions like
              <a
                href="https://www.probo.com/"
                target="_blank"
                rel="noopener noreferrer"
                class="font-semibold text-[#5d770d] hover:underline">Probo</a
              >
              help organizations:
            </p>
            <ul class="mt-4 ml-0 list-none space-y-3">
              <li class="flex items-start gap-2">
                <span class="text-muted-foreground">•</span>
                <span>
                  Centralize third-party compliance and risk evidence</span
                >
              </li>
              <li class="flex items-start gap-2">
                <span class="text-muted-foreground">•</span>
                <span>Maintain audit-ready documentation</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-muted-foreground">•</span>
                <span>
                  Align third-party oversight with frameworks like SOC 2, ISO
                  27001, and GDPR</span
                >
              </li>
              <li class="flex items-start gap-2">
                <span class="text-muted-foreground">•</span>
                <span>
                  Reduce friction between security, compliance, and business
                  teams</span
                >
              </li>
              <li class="flex items-start gap-2">
                <span class="text-muted-foreground">•</span>
                <span
                  >Move from periodic to <strong class="text-foreground"
                    >continuous assessments</strong
                  ></span
                >
              </li>
            </ul>
            <p class="mt-4">
              See how companies like
              <a
                href="/stories/ahrefs-iso"
                class="text-[#5d770d] hover:underline"
                >Ahrefs achieved ISO 27001</a
              >
              with Probo, including vendor oversight as part of their certification.
            </p>
          </div>
        </section>

        <!-- CTA Section -->
        <section class="border-border-low rounded-xl border bg-[#f8f9f7] p-8">
          <div class="text-center">
            <p class="text-foreground mb-4 text-lg font-semibold">
              Ready to streamline your Third-Party Risk Management?
            </p>
            <p class="text-muted-foreground mb-6">
              See how Probo can help you manage vendor risks and maintain
              compliance.
            </p>
            <a
              href="/contact"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center rounded-lg bg-[#D7EDBA] px-6 py-3 font-medium text-[#141e12] transition-colors hover:bg-[#c5dba8]"
            >
              Get Started with Probo
            </a>
          </div>
        </section>
      </article>
    </div>
  </main>
</Layout>

<style>
  .toc-link.active {
    color: #5d770d;
    font-weight: 500;
  }
  .highlight-text {
    background: linear-gradient(
      180deg,
      transparent 65%,
      #f0ff3c 65%,
      #f0ff3c 85%,
      transparent 85%
    );
    display: inline;
  }
</style>

<script>
  const sectionIds = [
    "intro",
    "why-tprm",
    "lifecycle",
    "best-practices",
    "probo-support",
  ];

  const tocLinks = document.querySelectorAll(".toc-link");

  // Function to scroll to a specific section
  function scrollToSection(id: string) {
    const element = document.getElementById(id);
    if (element) {
      const offset = 100;
      const elementPosition = element.offsetTop - offset;
      window.scrollTo({ top: elementPosition, behavior: "smooth" });
    }
  }

  // Handle scroll to update active section
  function handleScroll() {
    const sections = sectionIds.map((id) => document.getElementById(id));
    const scrollPosition = window.scrollY + 200;

    let activeId = sectionIds[0];

    for (let i = sections.length - 1; i >= 0; i--) {
      const section = sections[i];
      if (section && section.offsetTop <= scrollPosition) {
        activeId = sectionIds[i];
        break;
      }
    }

    // Update active class on TOC links
    tocLinks.forEach((link) => {
      const linkSection = link.getAttribute("data-section");
      if (linkSection === activeId) {
        link.classList.add("active");
      } else {
        link.classList.remove("active");
      }
    });
  }

  // Add click handlers to TOC buttons
  tocLinks.forEach((link) => {
    link.addEventListener("click", () => {
      const sectionId = link.getAttribute("data-section");
      if (sectionId) {
        scrollToSection(sectionId);
      }
    });
  });

  // Listen to scroll events
  window.addEventListener("scroll", handleScroll);

  // Initial call to set active section on page load
  handleScroll();
</script>
