---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.svelte";
import Icon, { type IconName } from "../components/Icon.astro";
import Faq from "../components/block/Faq.astro";
import Logos from "../components/block/Logos.astro";
import PricingChooser from "../components/block/PricingChooser.astro";
import { comparison, githubUrl, plans } from "../data/pricing";
import faqs from "../data/pricing-faq.json";
import CardReselect from "../components/pricing-explorations/CardReselect.astro";
import CardAlternatives from "../components/pricing-explorations/CardAlternatives.astro";
import MotionControls from "../components/pricing-explorations/MotionControls.astro";
import MotionEffects from "../components/pricing-explorations/MotionEffects.astro";
import {
  pricingMotionStyle,
  productionPricingMotion,
  type PricingMotionStudy,
} from "../data/pricing-motion";

interface Props {
  exploration?: { id: string; name: string };
  motionStudy?: PricingMotionStudy;
}

const { exploration, motionStudy } = Astro.props;
const activeMotion =
  motionStudy ?? (!exploration ? productionPricingMotion : undefined);
const productionMotion = activeMotion?.id === "production";

const planIcons = {
  "open-source": "code",
  cloud: "cloud",
  "done-for-you": "handshake",
} as const;

const comparisonIcons: Partial<Record<string, IconName>> = {
  Included: "check-circle-fill",
  "Your team": "wrench",
  "Your infrastructure": "wrench",
  You: "wrench",
  "You configure": "wrench",
  Probo: "check-circle-fill",
  "Hosted by Probo": "check-circle-fill",
  "One-click setup": "check-circle-fill",
  "Ready to use": "check-circle-fill",
  "Hosted endpoint": "check-circle-fill",
};

const badgeClass =
  "border-border-low bg-level-0 text-tertiary-foreground w-max rounded-lg border px-2 py-0.5 text-sm font-medium whitespace-nowrap";
const planBadgeClass = `${badgeClass} absolute -top-px left-1/2 z-10 -translate-x-1/2 -translate-y-1/2`;

const description =
  "Compare Probo plans: self-host the open-source platform for free, choose managed hosting, or work with a dedicated compliance officer.";
const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "Probo compliance platform",
  description,
  url: "https://www.probo.com/pricing",
  brand: { "@type": "Brand", name: "Probo" },
  offers: plans.map((plan) => ({
    "@type": "Offer",
    name: plan.name,
    url:
      plan.id === "open-source" ? githubUrl : "https://www.probo.com/contact",
    description: plan.summary,
    ...(plan.id === "open-source" ? { price: 0 } : {}),
  })),
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<Layout
  title={exploration
    ? `Pricing · ${exploration.name}`
    : motionStudy
      ? `Pricing · ${motionStudy.name}`
      : "Pricing"}
  description={description}
  noIndex={Boolean(exploration || motionStudy)}
  hasMarkdown={!exploration && !motionStudy}
>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <main
    id={motionStudy ? "motion-context" : undefined}
    class="pricing-page"
    data-pricing-page
    data-pricing-entrance={productionMotion || undefined}
    data-pricing-exploration={exploration?.id}
    data-motion-stage={activeMotion ? "" : undefined}
    data-motion-variant={activeMotion?.id}
    data-motion-kind={activeMotion?.kind}
    style={activeMotion ? pricingMotionStyle(activeMotion) : undefined}
  >
    {motionStudy && <MotionControls study={motionStudy} />}
    <slot name="exploration-stage" />
    <section
      class="pricing-hero container py-16 text-center"
      aria-labelledby="pricing-heading"
    >
      <p
        class:list={[
          badgeClass,
          "mx-auto mb-6",
          !productionMotion && "motion-safe:animate-perspective-in",
        ]}
        data-pricing-intro={productionMotion ? "label" : undefined}
        style={productionMotion ? undefined : "animation-delay: 100ms"}
      >
        Pricing
      </p>
      <h1
        id="pricing-heading"
        class:list={[
          "mx-auto mb-6 max-w-[562px] text-[2.75rem] leading-none font-semibold tracking-[-1.4px] text-balance sm:text-5xl sm:tracking-[-1.6px]",
          !productionMotion && "motion-safe:animate-perspective-in",
        ]}
        data-pricing-intro={productionMotion ? "title" : undefined}
        style={productionMotion ? undefined : "animation-delay: 150ms"}
      >
        Choose your Probo plan.
      </h1>
      <p
        class:list={[
          "text-muted-foreground mx-auto max-w-[468px] text-base",
          !productionMotion && "motion-safe:animate-perspective-in",
        ]}
        data-pricing-intro={productionMotion ? "description" : undefined}
        style={productionMotion ? undefined : "animation-delay: 350ms"}
      >
        Self-host Probo, use our cloud, or let a dedicated compliance officer
        run your program.
      </p>
    </section>

    <section id="plans" class="container" aria-label="Probo plans">
      <slot name="plans-before" />
      <div
        class="plan-grid border-border-solid bg-level-0 mx-auto grid max-w-[520px] rounded-3xl border lg:max-w-none lg:grid-cols-3"
        data-pricing-intro={productionMotion ? "plans" : undefined}
      >
        {
          plans.map((plan) => (
            <article
              id={`plan-${plan.id}`}
              class:list={[
                "plan-card border-border-solid relative isolate grid min-w-0 px-6 py-8 lg:px-8 lg:py-10 xl:px-10",
                plan.id === "open-source" && "text-muted-foreground",
              ]}
              aria-labelledby={`plan-title-${plan.id}`}
              tabindex="-1"
              data-pricing-reveal={
                motionStudy || productionMotion ? undefined : "plan"
              }
              data-motion-watch={
                activeMotion && plan.id === "done-for-you" ? "" : undefined
              }
              data-recommendation-reason={
                exploration?.id === "014"
                  ? plan.finderPrompt.replace(/^We /, "You ")
                  : undefined
              }
            >
              {exploration?.id === "007" && (
                <svg class="recommendation-trace" aria-hidden="true">
                  <rect
                    x="1"
                    y="1"
                    width="100%"
                    height="100%"
                    rx="16"
                    pathLength="1"
                  />
                </svg>
              )}
              {exploration?.id === "011" && (
                <svg
                  class="recommendation-seal"
                  viewBox="0 0 48 48"
                  aria-hidden="true"
                >
                  <circle cx="24" cy="24" r="24" fill="#e6ff03" />
                  <path d="M14 24 L21 31 L34 17" pathLength="1" />
                </svg>
              )}
              {plan.id === "done-for-you" && (
                <>
                  <div
                    class="plan-artwork rounded-b-3xl lg:rounded-bl-none"
                    aria-hidden="true"
                  >
                    <div class="plan-halo-motion motion-halo">
                      <img src="/pricing/managed-halo.svg" alt="" />
                    </div>
                  </div>
                  <span
                    class:list={[planBadgeClass, "plan-popular motion-badge"]}
                  >
                    Most popular
                  </span>
                </>
              )}
              <span
                class:list={[planBadgeClass, "plan-recommended"]}
                role="note"
                aria-label={
                  exploration?.id === "028" || exploration?.id === "031"
                    ? `Recommended: ${plan.name}`
                    : exploration?.id === "029"
                      ? `Recommended for you. ${plan.finderPrompt.replace(/^We /, "You ")}`
                      : "Recommended for you"
                }
                data-choice-reason={
                  exploration?.id === "029"
                    ? plan.finderPrompt.replace(/^We /, "You ")
                    : undefined
                }
              >
                {["031", "034", "035", "036"].includes(
                  exploration?.id ?? "",
                ) && <Icon name="check-bold" size={18} />}
              </span>
              <div class="flex flex-col gap-3.5">
                {(exploration?.id === "022" || exploration?.id === "023") && (
                  <CardReselect current={plan.id} placement="header" />
                )}
                {exploration?.id === "037" ? (
                  <div class="plan-reason-head">
                    <span class="plan-reason-icon">
                      <Icon name={planIcons[plan.id]} size={32} />
                    </span>
                  </div>
                ) : (
                  <Icon name={planIcons[plan.id]} size={32} />
                )}
                <h2 id={`plan-title-${plan.id}`} class="text-h4 font-semibold">
                  {plan.name}
                </h2>
                <p class="text-muted-foreground text-base text-pretty">
                  {plan.tagline}
                </p>
                {exploration?.id === "019" && (
                  <aside
                    class="plan-fit-reason"
                    role="note"
                    aria-label="Why this plan fits"
                  >
                    <Icon name="check" size={18} />
                    <p>{plan.finderPrompt.replace(/^We /, "You ")}</p>
                  </aside>
                )}
              </div>
              <Button
                href={plan.href}
                size="lg"
                variant={plan.id === "open-source" ? "secondary" : "primary"}
                class:list={[
                  "plan-cta mt-8 w-full",
                  plan.id === "done-for-you" && "plan-cta--managed",
                ]}
              >
                {plan.id === "open-source" && (
                  <Icon name="github-logo" size={19} />
                )}
                {plan.cta}
                {plan.id !== "open-source" && (
                  <Icon
                    name="arrow-right"
                    size={19}
                    class="pricing-cta-arrow"
                  />
                )}
              </Button>
              {exploration?.id === "040" && (
                <>
                  <span class="plan-explicit-fit" role="note">
                    <Icon name="check-bold" size={18} />
                    Recommended for you
                  </span>
                  <button
                    class="plan-paired-change"
                    type="button"
                    data-open-answer
                    aria-haspopup="dialog"
                    aria-controls="answer-choices"
                    aria-label="Change answer"
                  >
                    Change
                  </button>
                </>
              )}
              {exploration?.id === "039" && (
                <div class="plan-answer-track">
                  <div
                    class="plan-sticky-answer"
                    role="group"
                    aria-label="Recommended for you"
                  >
                    <span class="sticky-answer-reason">
                      <Icon name="check-bold" size={16} />
                      <span>{plan.finderPrompt.replace(/^We /, "You ")}</span>
                    </span>
                    <button
                      type="button"
                      data-open-answer
                      aria-haspopup="dialog"
                      aria-controls="answer-choices"
                      aria-label="Change answer"
                    >
                      Change
                    </button>
                  </div>
                </div>
              )}
              {exploration?.id === "038" && (
                <div
                  class="plan-answer-tab"
                  role="group"
                  aria-label="Recommended for you"
                >
                  <span class="answer-tab-reason">
                    <Icon name="check-bold" size={16} />
                    <span>{plan.finderPrompt.replace(/^We /, "You ")}</span>
                  </span>
                  <button
                    type="button"
                    data-open-answer
                    aria-haspopup="dialog"
                    aria-controls="answer-choices"
                    aria-label="Change answer"
                  >
                    Change
                  </button>
                </div>
              )}
              {exploration?.id === "037" && (
                <a
                  class="plan-reason-return"
                  href="#pricing-chooser"
                  data-change-answer
                  data-astro-reload
                  title="Change answer"
                  aria-label={`Change answer. ${plan.finderPrompt}`}
                >
                  <span>{plan.finderPrompt.replace(/^We /, "You ")}</span>
                  <Icon name="arrow-right" size={16} />
                </a>
              )}
              {exploration?.id === "034" && (
                <CardReselect current={plan.id} placement="action" />
              )}
              {exploration?.id === "035" && (
                <CardReselect current={plan.id} placement="action-menu" />
              )}
              {exploration?.id === "036" && (
                <button
                  class="plan-answer-dialog"
                  type="button"
                  data-open-answer
                  aria-haspopup="dialog"
                  aria-controls="answer-choices"
                >
                  Change answer <Icon name="arrow-right" size={16} />
                </button>
              )}
              {exploration?.id === "033" && (
                <a
                  class="plan-change-answer"
                  href="#pricing-chooser"
                  data-change-answer
                  data-astro-reload
                >
                  Change answer <Icon name="caret-down" size={16} />
                </a>
              )}
              {exploration?.id === "030" && (
                <aside
                  class="plan-action-reason"
                  role="note"
                  aria-label="Your choice"
                >
                  <p>{plan.finderPrompt.replace(/^We /, "You ")}</p>
                </aside>
              )}
              {exploration?.id === "024" && (
                <CardAlternatives current={plan.id} />
              )}
              {["025", "026", "027"].includes(exploration?.id ?? "") && (
                <a
                  class="plan-focus-link"
                  href={`#plan-${plan.id}`}
                  data-choose-plan
                  data-astro-reload
                  aria-controls={`plan-includes-${plan.id} plan-features-${plan.id}`}
                  aria-label={`View all features in ${plan.name}`}
                >
                  View full plan <Icon name="arrow-right" size={17} />
                </a>
              )}
              {(exploration?.id === "026" || exploration?.id === "027") && (
                <button
                  type="button"
                  class="plan-comparison-toggle"
                  data-focus-toggle
                >
                  <span class="when-focused">Compare all plans</span>
                  <span class="when-comparing">Focus on this plan</span>
                  <Icon name="arrow-right" size={17} />
                </button>
              )}
              {exploration?.id === "026" || exploration?.id === "027" ? (
                <div class="plan-details">
                  <p
                    id={`plan-includes-${plan.id}`}
                    class="text-lg font-medium"
                  >
                    {plan.includesLabel}
                  </p>
                  <ul
                    id={`plan-features-${plan.id}`}
                    class="mt-4 grid content-start gap-3 text-base"
                  >
                    {plan.features.map((feature) => (
                      <li class="flex items-start gap-2.5">
                        <Icon name="check" size={18} class="mt-px shrink-0" />
                        <span class="text-pretty">{feature}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ) : (
                <>
                  <p
                    id={
                      exploration?.id === "025"
                        ? `plan-includes-${plan.id}`
                        : undefined
                    }
                    class="mt-8 text-lg font-medium"
                  >
                    {plan.includesLabel}
                  </p>
                  <ul
                    id={
                      exploration?.id === "025"
                        ? `plan-features-${plan.id}`
                        : undefined
                    }
                    class="mt-4 grid content-start gap-3 text-base"
                  >
                    {plan.features.map((feature) => (
                      <li class="flex items-start gap-2.5">
                        <Icon name="check" size={18} class="mt-px shrink-0" />
                        <span class="text-pretty">{feature}</span>
                      </li>
                    ))}
                  </ul>
                </>
              )}
              {["025", "026", "027"].includes(exploration?.id ?? "") && (
                <CardAlternatives current={plan.id} />
              )}
              {exploration?.id === "021" && <CardReselect current={plan.id} />}
            </article>
          ))
        }
      </div>
    </section>

    <div
      class="pricing-proof"
      aria-label="Teams using Probo"
      data-pricing-reveal={productionMotion ? undefined : ""}
      data-pricing-intro={productionMotion ? "logos" : undefined}
    >
      <p>Trusted by leading teams</p>
      <Logos constrained />
    </div>

    <section
      id="compare-plans"
      class="pricing-comparison container"
      aria-labelledby="comparison-heading"
      data-pricing-reveal
    >
      <p class="comparison-scroll-hint">
        <Icon name="arrow-right" size={16} /> Scroll to compare all three plans
      </p>
      <div class="comparison-shell">
        <div class="comparison-sticky">
          <div
            class="comparison-scroll comparison-head-scroll"
            data-comparison-head
          >
            <table class="comparison-table comparison-head" role="presentation">
              <colgroup
                ><col class="feature-column" /><col /><col /><col /></colgroup
              >
              <thead>
                <tr>
                  <th class="comparison-heading-cell">
                    <h2 id="comparison-heading" class="pricing-section-title">
                      Compare<br />plans
                    </h2>
                    <div
                      class="comparison-navigation"
                      aria-label="Compare plans"
                    >
                      <button
                        type="button"
                        data-comparison-previous
                        aria-label="Previous plan"
                        disabled
                      >
                        <Icon name="caret-right" size={18} />
                      </button>
                      <button
                        type="button"
                        data-comparison-next
                        aria-label="Next plan"
                      >
                        <Icon name="caret-right" size={18} />
                      </button>
                    </div>
                  </th>
                  {
                    plans.map((plan) => (
                      <th class="comparison-plan">
                        <span
                          class:list={[
                            "comparison-plan-name",
                            plan.id === "open-source" &&
                              "text-muted-foreground",
                          ]}
                        >
                          <Icon name={planIcons[plan.id]} size={20} />
                          {plan.name}
                        </span>
                        <Button
                          href={plan.href}
                          variant={
                            plan.id === "open-source" ? "secondary" : "primary"
                          }
                          class:list={[
                            "plan-cta comparison-cta gap-1.5 px-2 whitespace-nowrap",
                            plan.id === "done-for-you" && "plan-cta--managed",
                          ]}
                        >
                          {plan.id === "open-source" && (
                            <Icon name="github-logo" size={16} />
                          )}
                          {plan.cta}
                          {plan.id !== "open-source" && (
                            <Icon
                              name="arrow-right"
                              size={16}
                              class="pricing-cta-arrow"
                            />
                          )}
                        </Button>
                      </th>
                    ))
                  }
                </tr>
              </thead>
            </table>
          </div>
        </div>
        <div
          class="comparison-scroll comparison-body-scroll"
          data-comparison-body
          role="region"
          aria-label="Plan comparison, scroll horizontally to see every plan"
          tabindex="0"
        >
          <div
            class="comparison-row-highlight"
            data-comparison-highlight
            aria-hidden="true"
          >
          </div>
          <table class="comparison-table" aria-label="Probo plan comparison">
            <colgroup
              ><col class="feature-column" /><col /><col /><col /></colgroup
            >
            <thead class="comparison-accessible-head"
              ><tr
                ><th scope="col"><span class="sr-only">Feature</span></th>{
                  plans.map((plan) => (
                    <th scope="col">
                      <span class="sr-only">{plan.name}</span>
                    </th>
                  ))
                }</tr
              ></thead
            >
            {
              comparison.map((group, groupIndex) => (
                <>
                  <tbody class="comparison-group-heading">
                    <tr>
                      <th colspan="4" scope="colgroup">
                        <h3>{group.name}</h3>
                      </th>
                    </tr>
                  </tbody>
                  <tbody
                    id={`comparison-group-${groupIndex}`}
                    class="comparison-data"
                  >
                    {group.rows.map((row, rowIndex) => (
                      <tr>
                        <th scope="row" class="comparison-feature">
                          {row.detail ? (
                            <>
                              <button
                                class="feature-detail-trigger"
                                type="button"
                                data-pricing-tooltip
                                aria-expanded="false"
                                aria-controls={`feature-detail-${groupIndex}-${rowIndex}`}
                                aria-describedby={`feature-detail-${groupIndex}-${rowIndex}`}
                              >
                                {row.label.slice(
                                  0,
                                  row.label.lastIndexOf(" ") + 1,
                                )}
                                <span class="feature-detail-ending">
                                  {row.label.slice(
                                    row.label.lastIndexOf(" ") + 1,
                                  )}
                                  <span class="feature-info-hit">
                                    <Icon
                                      name="info"
                                      size={14}
                                      class="feature-info"
                                    />
                                  </span>
                                </span>
                              </button>
                              <span
                                class="feature-detail"
                                id={`feature-detail-${groupIndex}-${rowIndex}`}
                                role="tooltip"
                                popover="manual"
                              >
                                {row.detail}
                              </span>
                            </>
                          ) : (
                            row.label
                          )}
                        </th>
                        {row.values.map((value, columnIndex) => {
                          const icon =
                            typeof value === "string"
                              ? comparisonIcons[value]
                              : undefined;
                          const iconDetail =
                            typeof value === "string"
                              ? row.cellDetails?.[value]
                              : undefined;
                          const detailId = `cell-detail-${groupIndex}-${rowIndex}-${columnIndex}`;
                          return (
                            <td>
                              {columnIndex === 0 && row.ossSetupContinuation ? (
                                <>
                                  <button
                                    type="button"
                                    class="comparison-icon-trigger comparison-setup-continuation"
                                    data-pricing-tooltip
                                    aria-label={`Included with your own setup. ${iconDetail}`}
                                    aria-expanded="false"
                                    aria-controls={detailId}
                                  >
                                    <Icon name="wrench" size={22} />
                                  </button>
                                  <span
                                    class="feature-detail feature-detail--compact"
                                    id={detailId}
                                    role="tooltip"
                                    popover="manual"
                                  >
                                    Included with your own setup. {iconDetail}
                                  </span>
                                </>
                              ) : typeof value === "boolean" ? (
                                <span
                                  class:list={[
                                    "comparison-status",
                                    !value && "comparison-status--excluded",
                                  ]}
                                >
                                  <Icon
                                    name={
                                      value
                                        ? "check-circle-fill"
                                        : "x-circle-fill"
                                    }
                                    size={22}
                                  />
                                  <span class="sr-only">
                                    {value ? "Included" : "Not included"}
                                  </span>
                                </span>
                              ) : icon && iconDetail ? (
                                <>
                                  <button
                                    type="button"
                                    class:list={[
                                      "comparison-icon-trigger",
                                      icon === "wrench" &&
                                        "comparison-icon-trigger--self-hosted",
                                      icon === "check-circle-fill" &&
                                        "comparison-icon-trigger--included",
                                    ]}
                                    data-pricing-tooltip
                                    aria-label={`${icon === "wrench" ? "Included with your own setup." : "Included."} ${iconDetail}`}
                                    aria-expanded="false"
                                    aria-controls={detailId}
                                  >
                                    <Icon name={icon} size={22} />
                                  </button>
                                  <span
                                    class="feature-detail feature-detail--compact"
                                    id={detailId}
                                    role="tooltip"
                                    popover="manual"
                                  >
                                    {iconDetail}
                                  </span>
                                </>
                              ) : (
                                <span
                                  class:list={[
                                    "comparison-value",
                                    value === "Paid extra" &&
                                      "comparison-extra",
                                  ]}
                                >
                                  {value}
                                </span>
                              )}
                            </td>
                          );
                        })}
                      </tr>
                    ))}
                  </tbody>
                </>
              ))
            }
          </table>
        </div>
      </div>
    </section>

    <section
      class="pricing-faq container"
      aria-labelledby="faq-heading"
      data-pricing-reveal
    >
      <h2 id="faq-heading" class="pricing-section-title">
        Questions, answered
      </h2>
      <Faq faqs={faqs} id="pricing" />
    </section>

    <slot name="exploration-guide">
      <PricingChooser />
    </slot>
  </main>
  {productionMotion && <MotionEffects />}
</Layout>

<script>
  import "../scripts/pricing";
</script>

<style>
  :global(html:has([data-pricing-page])) {
    overflow-x: clip;
  }
  .pricing-page {
    --pricing-lime: #e6ff03;
    --pricing-included: oklch(59.6% 0.145 163.225);
    --pricing-row-hover: color-mix(
      in srgb,
      var(--color-subtle) 75%,
      var(--color-level-0)
    );
    --pricing-header-height: 64px;
