  {
    icon: "ph-monitor",
    title: "Continuous posture for every device",
    description:
      "Track nine security checks across every laptop and server you enroll, from disk encryption to malware protection.",
  },
  {
    icon: "ph-user-plus",
    title: "Self-service enrollment",
    description:
      "Let employees install the agent and enroll their own laptop in a few clicks, with no IT ticket required.",
  },
  {
    icon: "ph-stack",
    title: "The same nine checks everywhere",
    description:
      "Run identical checks on macOS, Windows, Linux, and FreeBSD, so posture data means the same thing across your fleet.",
  },
  {
    icon: "ph-eye",
    title: "Not a MDM",
    description:
      "Keep the agent purely observational, since it can never push commands, wipe, or lock a device.",
  },
  {
    icon: "ph-file-text",
    title: "Evidence ready for your auditor",
    description:
      "Give auditors a per-device history of every check, with timestamps and correlation IDs for each report.",
  },
];
