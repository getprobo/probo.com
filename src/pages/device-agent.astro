    illustration: "capability-device-agent-api",
    title: "Device Agent API",
    description:
      "Handle enroll, heartbeat, posture, and unenroll requests over agent-initiated HTTPS only.",
  },
  {
    illustration: "capability-agent-cli",
    title: "Agent CLI",
    description:
      "Run install, status, collect, and update from the command line on servers.",
  },
];
const trustedLogos = [
  {
    src: "/clients/trace_for_good.svg",
    alt: "Trace for Good",
    class: "trusted-logo--trace",
    width: 1023,
    height: 154,
  },
  {
    src: "/clients/jimo.svg",
