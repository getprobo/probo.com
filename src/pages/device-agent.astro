  {
    title: "Hand your auditor a paper trail",
    lottie: "/lottie/access-review/3.json",
    foregroundParts: [
      {
        asset: "workflow-report-history-list.svg",
        x: 19,
        y: 367,
        width: 403,
        height: 297,
      },
      {
        asset: "workflow-report-history-report.svg",
        x: 166,
        y: 34,
        width: 402,
        height: 452,
