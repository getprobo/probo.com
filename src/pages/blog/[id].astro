---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import BlogCard from "../../components/blog/BlogCard.astro";
import AuthorAvatar from "../../components/blog/AuthorAvatar.astro";
import BlogToc from "../../components/blog/BlogToc.astro";
import BlogEnhancements from "../../components/blog/BlogEnhancements.astro";
import {
  blogDate,
  categoryHref,
  newestFirst,
  readingMinutes,
} from "../../lib/blog";
import "../../styles/journal.css";
import WrittenBy from "../../components/block/WrittenBy.astro";
import { getCanonicalUrl } from "../../lib/i18n.ts";

interface Props {
  post: CollectionEntry<"blog">;
  related: CollectionEntry<"blog">[];
}
export async function getStaticPaths() {
  const posts = (await getCollection("blog")).sort(newestFirst);
  return posts.map((post) => ({
    params: { id: post.id },
    props: {
      post,
      related: [
        ...posts.filter(
          (other) =>
            other.id !== post.id && other.data.category === post.data.category,
        ),
        ...posts.filter(
          (other) =>
            other.id !== post.id && other.data.category !== post.data.category,
        ),
      ].slice(0, 2),
    },
  }));
}
const { post, related } = Astro.props;
const { Content, headings } = await render(post);
const headingDepth = Math.min(...headings.map((heading) => heading.depth));
const toc = headings.filter((heading) => heading.depth === headingDepth);
const hasFaq = headings.some((heading) =>
  /frequently asked|faq/i.test(heading.text),
);
if (!hasFaq && post.data.faqs?.length) {
  toc.push({
    depth: 2,
    slug: "frequently-asked-questions",
    text: "Frequently asked questions",
  });
}
const showToc = post.data.showToc && toc.length > 2;
const cover = post.data.coverImage ?? post.data.titleImage;
const canonical = getCanonicalUrl(Astro.url);
const articleImage =
  (post.data.ogImage ?? cover)
    ? `https://www.probo.com${post.data.ogImage ?? cover}`
    : "https://www.probo.com/og.png";

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.excerpt,
  image: articleImage,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.dateModified ?? post.data.date).toISOString(),
  author: {
    "@type": "Person",
    name: post.data.author.name,
  },
  publisher: {
    "@type": "Organization",
    name: "Probo",
    logo: {
      "@type": "ImageObject",
      url: "https://www.probo.com/probo-logo.svg",
    },
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": getCanonicalUrl(Astro.url),
  },
};

const site = Astro.site ?? new URL("https://www.probo.com");
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: new URL("/", site).toString(),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Blog",
      item: new URL("/blog", site).toString(),
    },
    {
      "@type": "ListItem",
      position: 3,
      name: post.data.title,
    },
  ],
};

// FAQ Schema (only if post has faqs in frontmatter)
const faqSchema = post.data.faqs
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: post.data.faqs.map(
        (faq: { question: string; answer: string }) => ({
          "@type": "Question",
          name: faq.question,
          acceptedAnswer: {
            "@type": "Answer",
            text: faq.answer,
          },
        }),
      ),
    }
  : null;
---

<Layout
  journal
  noFrameworks
  title={post.data.title}
  description={post.data.excerpt}
  ogImage={post.data.ogImage ?? cover}
  ogType="article"
>
  <meta
    slot="head"
    property="article:published_time"
    content={post.data.date.toISOString()}
  />
  <meta
    slot="head"
    property="article:modified_time"
    content={(post.data.dateModified ?? post.data.date).toISOString()}
  />
  <meta slot="head" property="article:author" content={post.data.author.name} />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  />
  {
    faqSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )
  }
  <main class="journal-container journal-article">
    <nav class="journal-breadcrumb" aria-label="Breadcrumb">
      <a
        href="/blog"
        class="journal-back"
        aria-label="Back to The Compliance Journal"
        ><img src="/blog/icons/back.svg" width="16" height="16" alt="" /><img
          src="/blog/journal-logo-minimal.svg"
          class="journal-breadcrumb-logo"
          width="230"
          height="73"
          alt=""
        /></a
      >
      <span aria-hidden="true">/</span>
      <a href={categoryHref(post.data.category)} class="journal-category"
        >{post.data.category}</a
      >
    </nav>
    <header class="journal-hero">
      <h1>{post.data.title}</h1>
      <p class="journal-deck">{post.data.excerpt}</p>
      <p class="journal-metadata items-center">
        <span class="inline-flex items-center gap-2">
          <AuthorAvatar
            author={post.data.author.name}
            size="medium"
            loading="eager"
          />
          {post.data.author.name}
        </span><span aria-hidden="true">·</span><time
          datetime={post.data.date.toISOString()}
          >{blogDate.format(post.data.date)}</time
        ><span aria-hidden="true">·</span><span
          >{readingMinutes(post.body)} min read</span
        >
      </p>
    </header>
    {
      (post.data.showCover || cover) && (
        <div class="journal-cover" aria-hidden={!cover ? "true" : undefined}>
          {cover && (
            <img
              src={cover}
              alt={post.data.coverImageAlt ?? post.data.titleImageAlt}
              width="1080"
              height="608"
              loading="eager"
              decoding="async"
            />
          )}
        </div>
      )
    }
    <div class="journal-reading-layout">
      {showToc && <BlogToc headings={toc} />}
      <div class="journal-reading-column">
        <article class="journal-prose" data-article-body>
          <Content />
          {
            !hasFaq && post.data.faqs && (
              <section aria-labelledby="frequently-asked-questions">
                <h2 id="frequently-asked-questions">
                  Frequently asked questions
                </h2>
                {post.data.faqs.map((faq) => (
                  <div class="journal-faq">
                    <h3>{faq.question}</h3>
                    <p>{faq.answer}</p>
                  </div>
                ))}
              </section>
            )
          }
        </article>
        <WrittenBy author={post.data.author.name} variant="journal" />
        <div class="journal-share" aria-label="Share this article">
          <p class="journal-share-label">Share this article</p>
          <button type="button" data-copy-link={canonical}
            ><img
              src="/blog/icons/link.svg"
              alt=""
              width="16"
              height="16"
            /><span>Copy link</span></button
          >
          <a
            href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonical)}`}
            target="_blank"
            rel="noopener noreferrer"
            ><img
              src="/blog/icons/linkedin.svg"
              alt=""
              width="16"
              height="16"
            />LinkedIn</a
          >
          <p class="sr-only" aria-live="polite" data-copy-status></p>
        </div>
      </div>
    </div>
    <section class="journal-related" aria-labelledby="keep-reading">
      <h2 id="keep-reading">Keep reading</h2>
      <div class="journal-grid">
        {related.map((other) => <BlogCard post={other} />)}
      </div>
    </section>
  </main>
  <BlogEnhancements />
</Layout>
