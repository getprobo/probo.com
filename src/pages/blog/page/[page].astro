---
import Layout from "../../../layouts/Layout.astro";
import BlogIndex from "../../../components/BlogIndex.astro";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import type { Page } from "astro";
import { pageSize } from "../../../content.config.ts";

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const allPosts = (await getCollection("blog")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );
  return paginate(allPosts, { pageSize });
}

type Props = {
  page: Page<CollectionEntry<"blog">>;
};

const { page } = Astro.props;
---

<Layout
  title={`Blog, page ${page.currentPage}`}
  description="More articles about compliance, security certifications, SOC 2, ISO 27001, and building trust from the Probo blog."
>
  <BlogIndex
    posts={page.data}
    currentPage={page.currentPage}
    lastPage={page.lastPage}
  />
</Layout>
