---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import FrameworkBadge from "../components/FrameworkBadge.svelte";

const frameworks = [
  {
    id: "soc2",
    label: "SOC 2",
    title: "SOC 2",
    description:
      "Learn everything about SOC 2 compliance: requirements, costs, timeline, and Type 1 vs Type 2 differences. Your complete guide to achieving SOC 2 certification.",
    features: [
      "Understanding SOC 2",
      "Requirements to get compliant",
      "Cost and timeline",
    ],
    href: "/hub/soc2",
    accentColor: "from-emerald-400 to-teal-500",
    badges: ["SOC2_TYPE1", "SOC2_TYPE2"],
  },
  {
    id: "iso27001",
    label: "ISO 27001",
    title: "ISO 27001",
    description:
      "Learn what ISO 27001 is, why it matters for your business, and how to achieve certification. Complete 2026 guide covering requirements, costs, and timelines.",
    features: [
      "Understanding ISO 27001",
      "Requirements to get compliant",
      "Cost and timeline",
    ],
    href: "/hub/iso27001",
    accentColor: "from-blue-400 to-indigo-500",
    badges: ["ISO27001"],
  },
  {
    id: "nis2",
    label: "NIS2",
    title: "NIS2",
    description:
      "Everything you need to know about NIS2 compliance in 2026: requirements, costs, deadlines, and how to prepare your organization. Expert guide for tech teams.",
    features: [
      "Understanding NIS2",
      "Requirements and Article 21",
      "Cost and timeline",
    ],
    href: "/hub/nis2-compliance",
    accentColor: "from-purple-400 to-violet-500",
    badges: ["NIS2"],
  },
];

const tools = [
  {
    id: "compliance-recommender",
    title: "Compliance Framework Recommender",
    description:
      "Find the right security and compliance frameworks for your business. Get a free personalized report based on your industry, business model, and target customers.",
    href: "/hub/compliance-recommender",
    accentColor: "from-yellow-400 to-lime-500",
    tag: "Free Tool",
  },
];

const articles = [
  {
    id: "probo-vs-fractional-ciso",
    title: "Probo vs Hiring a Fractional CISO",
    description:
      "Fractional CISO vs Probo: leadership and buyer narrative vs compliance execution. Role boundaries, sequencing, year-one TCO, and when to add each.",
    href: "/hub/probo-vs-fractional-ciso",
    accentColor: "from-slate-400 to-emerald-500",
    tag: "Comparison",
  },
  {
    id: "iso-27001-after-soc-2-the-30-percent-shortcut",
    title: "ISO 27001 for Companies That Already Have SOC 2: The 30% Shortcut",
    description:
      "You are roughly 70% of the way to ISO 27001 if SOC 2 Type 2 is done. Map Annex A overlap, the reformat layer, and the 8% net-new — plus sequencing and realistic marginal cost.",
    href: "/hub/iso-27001-after-soc-2-the-30-percent-shortcut",
    accentColor: "from-blue-400 to-emerald-500",
    tag: "Guide",
  },
  {
    id: "which-compliance-framework",
    title: "Which Compliance Framework Do You Need?",
    description:
      "Not sure if you need SOC 2, GDPR, HIPAA, or PCI DSS? Use our guide to identify the right compliance frameworks based on your business type, customers, and data.",
    href: "/hub/which-compliance-framework",
    accentColor: "from-yellow-400 to-amber-500",
    tag: "Guide",
  },
  {
    id: "vanta-alternatives-2026",
    title:
      "Vanta Alternatives in 2026: 7 Platforms Compared Honestly (Including a Free One)",
    description:
      "Honest comparison of 7 Vanta alternatives for compliance automation. Probo is the only open-source, free-tier option with a dedicated compliance officer included.",
    href: "/hub/vanta-alternatives-2026",
    accentColor: "from-teal-400 to-cyan-500",
    tag: "Comparison",
  },
  {
    id: "nis2-tech-teams",
    title: "NIS2 for Tech Teams: What Actually Changes in 2026",
    description:
      "A practical NIS2 guide for CTOs and developers. Learn the 10 security measures you must implement, incident response requirements, and automation strategies.",
    href: "/hub/nis2-tech-teams",
    accentColor: "from-purple-400 to-violet-500",
    tag: "Guide",
  },
  {
    id: "nis2-compliance-checklist-tech-companies-2026",
    title: "NIS2 Compliance Checklist for Tech Companies (2026 Edition)",
    description:
      "Practical step-by-step NIS2 checklist: governance, technical controls, supply chain, 24–72 hour notifications, registration — and what you can skip until you're in scope.",
    href: "/hub/nis2-compliance-checklist-tech-companies-2026",
    accentColor: "from-purple-400 to-fuchsia-500",
    tag: "Checklist",
  },
  {
    id: "ai-coding-tools-soc2-compliance",
    title: "Using AI Coding Tools While Staying SOC 2 Compliant",
    description:
      "Can you use Claude, Copilot, or Cursor and stay SOC 2 compliant? Here's the practical checklist for startups using AI coding assistants in 2026.",
    href: "/hub/ai-coding-tools-soc2-compliance",
    accentColor: "from-indigo-400 to-purple-500",
    tag: "Guide",
  },
  {
    id: "top-compliance-automation-tools-2026",
    title: "Top 5 Compliance Automation Tools in 2026",
    description:
      "Compare the top 5 compliance automation tools for 2026. Discover why open source Probo ranks #1 and how its hands-on service eliminates the DIY compliance burden.",
    href: "/hub/top-compliance-automation-tools-2026",
    accentColor: "from-lime-400 to-green-500",
    tag: "Comparison",
  },
  {
    id: "soc2-type1-vs-type2",
    title: "SOC 2 Type 1 vs Type 2: Which Certification Do You Need?",
    description:
      "SOC 2 Type 1 vs Type 2 explained: Type 1 is point-in-time (3-6 months, $15K-$40K), Type 2 requires 6-12 month observation ($30K-$100K). Learn which fits your stage and when to upgrade.",
    href: "/hub/soc2-type1-vs-type2",
    accentColor: "from-emerald-400 to-teal-500",
    tag: "Guide",
  },
  {
    id: "evaluate-soc2-report-quality",
    title: "How to Evaluate SOC 2 Report Quality",
    description:
      "Learn 6 expert checks to evaluate SOC 2 report quality. Verify auditor legitimacy, test procedures, and sample sizes before relying on vendor assessments.",
    href: "/hub/evaluate-soc2-report-quality",
    accentColor: "from-emerald-400 to-teal-500",
    tag: "Guide",
  },
  {
    id: "iso27001-certification-cost",
    title: "ISO 27001 certification cost: what founders actually pay in 2026",
    description:
      "The real number ranges from $15,000 to over $80,000. Here is exactly what drives the difference, and how to avoid paying for things you don't need.",
    href: "/hub/iso27001-certification-cost",
    accentColor: "from-blue-400 to-indigo-500",
    tag: "Guide",
  },
  {
    id: "what-is-compliance-software",
    title: "What is a Compliance Software?",
    description:
      "Discover what defines GRC software in 2026 and why Probo is the platform of choice for companies that want to move fast with qualitative compliance report and process.",
    href: "/hub/what-is-compliance-software",
    accentColor: "from-emerald-400 to-cyan-500",
    tag: "Guide",
  },
  {
    id: "top-grc-tools-2026",
    title: "Top 5 GRC Tools in 2026",
    description:
      "A practical guide for modern Risk & Compliance teams. We compare Probo, Vanta, Drata, Hyperproof, and OneTrust based on risk management, governance, and compliance capabilities.",
    href: "/hub/top-grc-tools-2026",
    accentColor: "from-violet-400 to-purple-500",
    tag: "Comparison",
  },
  {
    id: "third-party-risk-management",
    title: "What Is Third-Party Risk Management (TPRM)?",
    description:
      "Learn what TPRM is, why it matters for compliance frameworks like ISO 27001 and SOC 2, and best practices for managing vendor and supplier risks throughout the relationship lifecycle.",
    href: "/hub/third-party-risk-management",
    accentColor: "from-amber-400 to-orange-500",
    tag: "Guide",
  },
  {
    id: "cloud-security-best-practices",
    title: "Cloud Security Best Practices for Audit-Ready Teams",
    description:
      "Learn cloud security best practices to prevent misconfigurations, cut credential risk, and generate audit-ready evidence for SOC 2 and ISO 27001.",
    href: "/hub/cloud-security-best-practices",
    accentColor: "from-sky-400 to-blue-500",
    tag: "Guide",
  },
  {
    id: "top-compliance-officer-services-2026",
    title: "Top 5 Compliance Officer Services in 2026",
    description:
      "For founders who don't want to become compliance experts. Compare the best compliance officer services for SOC 2 in 2026 — real teams, not just software.",
    href: "/hub/top-compliance-officer-services-2026",
    accentColor: "from-teal-400 to-green-500",
    tag: "Comparison",
  },
];

const mapHubEntry = (entry: {
  id: string;
  data: {
    title: string;
    description: string;
    accentColor: string;
    tag: string;
  };
}) => ({
  id: entry.id,
  title: entry.data.title,
  description: entry.data.description,
  href: `/hub/${entry.id}`,
  accentColor: entry.data.accentColor,
  tag: entry.data.tag,
});

const hubEntries = (await getCollection("hub", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const toolRecommendations = hubEntries
  .filter((entry) => entry.data.section === "tool-recommendation")
  .map(mapHubEntry);

const hubArticles = hubEntries
  .filter((entry) => entry.data.section !== "tool-recommendation")
  .map(mapHubEntry);

const allArticles = [...hubArticles, ...articles];

const articleTags = [...new Set(allArticles.map((a) => a.tag))].sort(
  (a, b) =>
    allArticles.filter((x) => x.tag === b).length -
    allArticles.filter((x) => x.tag === a).length,
);

const sections = [
  { id: "guides", label: "Framework guides", count: frameworks.length },
  { id: "tools", label: "Free tools", count: tools.length },
  { id: "articles", label: "Articles", count: allArticles.length },
  {
    id: "tool-recommendations",
    label: "Tool recommendations",
    count: toolRecommendations.length,
  },
].filter((section) => section.count > 0);

const listSections = [
  {
    id: "articles",
    title: "Articles & comparisons",
    subtitle:
      "In-depth analysis and comparisons to help you make informed decisions.",
    items: allArticles,
    filters: articleTags,
  },
  {
    id: "tool-recommendations",
    title: "Tool recommendations",
    subtitle:
      "Practical buying guides for the tools startups actually evaluate.",
    items: toolRecommendations,
    filters: [] as string[],
  },
].filter((section) => section.items.length > 0);
---

<Layout
  title="Compliance Hub: SOC 2, ISO 27001, NIS2 & GRC Guides"
  description="Your central resource for compliance knowledge: in-depth guides on SOC 2, ISO 27001, NIS2, and the tools that help you get certified faster."
>
  <main class="container my-10 sm:my-16">
    <!-- Hero -->
    <header class="animate-slide-in mb-8 max-w-[720px] sm:mb-10">
      <p
        class="text-muted-foreground mb-4 text-xs font-medium tracking-[0.12em] uppercase"
      >
        Resource center
      </p>
      <h1 class="text-h2 sm:text-h1 mb-4 font-medium tracking-[-1px]">
        Compliance Hub
      </h1>
      <p class="text-muted-foreground text-lg font-medium sm:text-xl">
        Guides, comparisons and free tools for SOC 2, ISO 27001, NIS2 and the
        rest of your compliance stack.
      </p>
    </header>

    <!-- Section nav -->
    <nav
      aria-label="Hub sections"
      class="animate-slide-in animation-delay-100 mb-12 flex flex-wrap gap-2 sm:mb-16"
    >
      {
        sections.map((section) => (
          <a
            href={`#${section.id}`}
            class="border-border-low bg-level-1 text-foreground hover:border-border-mid inline-flex h-9 items-center gap-2 rounded-full border px-4 text-sm font-medium transition-colors"
          >
            {section.label}
            <span class="text-muted-foreground text-xs tabular-nums">
              {section.count}
            </span>
          </a>
        ))
      }
    </nav>

    <!-- Framework guides -->
    <section
      id="guides"
      class="animate-slide-in animation-delay-200 scroll-mt-28"
    >
      <div class="mb-6 sm:mb-8">
        <h2
          class="text-h4 mb-2 font-medium tracking-[-0.8px] sm:text-[32px] sm:leading-[42px]"
        >
          Framework guides
        </h2>
        <p class="text-muted-foreground">
          Start your compliance journey with our comprehensive guides.
        </p>
      </div>

      <div
        class="grid grid-cols-1 gap-4 sm:gap-6 md:grid-cols-2 lg:grid-cols-3"
      >
        {
          frameworks.map((framework) => (
            <a
              href={framework.href}
              class="group bg-level-1 border-border-low hover:border-border-mid relative flex flex-col overflow-hidden rounded-3xl border p-6 transition-colors sm:p-7"
            >
              <div class="relative mb-6 flex items-center justify-between">
                <h3 class="text-foreground text-[26px] leading-[1.15] font-semibold tracking-[-0.5px]">
                  {framework.title}
                </h3>
                <div class="flex -space-x-2">
                  {framework.badges.map((badge) => (
                    <div class="bg-level-1 border-border-low flex size-11 items-center justify-center overflow-hidden rounded-full border">
                      <FrameworkBadge
                        name={badge}
                        class="size-7"
                        client:visible
                      />
                    </div>
                  ))}
                </div>
              </div>

              <p class="text-muted-foreground relative mb-6 leading-relaxed">
                {framework.description}
              </p>

              <ul class="relative mb-8 space-y-2">
                {framework.features.map((feature) => (
                  <li class="text-tertiary-foreground flex items-start gap-2.5 text-sm">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="#10b981"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="mt-0.5 shrink-0"
                    >
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>

              <span class="bg-primary group-hover:bg-primary/85 text-invert relative mt-auto inline-flex items-center gap-2 self-start rounded-full px-5 py-2.5 text-sm font-medium transition-all group-hover:gap-3">
                Read the guide
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </svg>
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Free tools -->
    <section id="tools" class="mt-14 scroll-mt-28 sm:mt-20">
      {
        tools.map((tool) => (
          <a
            href={tool.href}
            class="group text-invert relative block overflow-hidden rounded-3xl bg-[#141e12] p-6 sm:p-10"
          >
            <div class="pointer-events-none absolute -right-10 -bottom-24 h-80 w-80 rounded-full bg-[#e6ff03] opacity-20 blur-3xl transition-opacity group-hover:opacity-30" />
            <div class="relative flex flex-col gap-6 sm:flex-row sm:items-center">
              <div class="max-w-[680px] flex-1">
                <span class="mb-4 inline-block rounded-full bg-[#e6ff03] px-3 py-1 text-xs font-medium text-[#141e12]">
                  {tool.tag}
                </span>
                <h2 class="text-invert mb-3 text-[24px] leading-[1.15] font-semibold tracking-[-0.5px] sm:text-[30px]">
                  {tool.title}
                </h2>
                <p class="text-invert/70 leading-relaxed">{tool.description}</p>
              </div>
              <span class="inline-flex shrink-0 items-center gap-2 self-start rounded-full bg-[#e6ff03] px-5 py-2.5 text-sm font-medium text-[#141e12] transition-all group-hover:gap-3 sm:self-center">
                Get my report
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </svg>
              </span>
            </div>
          </a>
        ))
      }
    </section>

    <!-- Article lists -->
    {
      listSections.map((section) => (
        <section
          id={section.id}
          class="mt-14 scroll-mt-28 sm:mt-20"
          data-hub-section
        >
          <div class="mb-6 flex flex-col gap-4 sm:mb-8 lg:flex-row lg:items-end lg:justify-between">
            <div>
              <h2 class="text-h4 mb-2 font-medium tracking-[-0.8px] sm:text-[32px] sm:leading-[42px]">
                {section.title}
              </h2>
              <p class="text-muted-foreground">{section.subtitle}</p>
            </div>
            {section.filters.length > 1 && (
              <div
                class="flex flex-wrap gap-2"
                role="group"
                aria-label="Filter by type"
              >
                {["All", ...section.filters].map((filter, index) => (
                  <button
                    type="button"
                    data-hub-filter={filter}
                    aria-pressed={index === 0 ? "true" : "false"}
                    class="border-border-low bg-level-1 text-tertiary-foreground hover:border-border-mid aria-pressed:bg-primary aria-pressed:border-primary aria-pressed:text-invert h-8 rounded-full border px-3 text-sm font-medium transition-colors"
                  >
                    {filter}
                  </button>
                ))}
              </div>
            )}
          </div>

          <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
            {section.items.map((article) => (
              <a
                href={article.href}
                data-hub-tag={article.tag}
                class="group bg-level-1 border-border-low hover:border-border-mid relative flex flex-col overflow-hidden rounded-2xl border p-5 transition-colors sm:p-6"
              >
                <span class="relative mb-4 self-start rounded-full bg-[#f0f7e4] px-2.5 py-1 text-xs font-medium text-[#5d770d]">
                  {article.tag}
                </span>
                <h3 class="text-foreground relative mb-2 text-lg leading-snug font-semibold tracking-[-0.2px] transition-colors group-hover:text-[#5d770d]">
                  {article.title}
                </h3>
                <p class="text-muted-foreground relative mb-5 line-clamp-3 text-sm leading-relaxed">
                  {article.description}
                </p>
                <span class="text-foreground relative mt-auto inline-flex items-center gap-1.5 text-sm font-medium transition-all group-hover:gap-2.5">
                  Read
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M5 12h14" />
                    <path d="m12 5 7 7-7 7" />
                  </svg>
                </span>
              </a>
            ))}
          </div>
        </section>
      ))
    }

    <!-- Coming soon -->
    <section class="mt-14 sm:mt-20">
      <div
        class="flex flex-col gap-4 rounded-3xl bg-gradient-to-br from-[#e4f7c7] to-[#d0e8b3] p-6 sm:flex-row sm:items-center sm:gap-6 sm:p-8"
      >
        <div
          class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-[#141e12]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#e4f7c7"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"
            ></path>
          </svg>
        </div>
        <div>
          <h2 class="mb-1 text-lg font-semibold text-[#141e12] sm:text-xl">
            More guides coming soon
          </h2>
          <p class="text-[#141e12]/70">
            We're constantly expanding our compliance knowledge center. Stay
            tuned for guides on GDPR, HIPAA, and more frameworks.
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  function initHubFilters() {
    document
      .querySelectorAll<HTMLElement>("[data-hub-section]")
      .forEach((section) => {
        const buttons =
          section.querySelectorAll<HTMLButtonElement>("[data-hub-filter]");
        const cards = section.querySelectorAll<HTMLElement>("[data-hub-tag]");
        buttons.forEach((button) => {
          button.addEventListener("click", () => {
            const filter = button.dataset.hubFilter;
            buttons.forEach((b) =>
              b.setAttribute("aria-pressed", String(b === button)),
            );
            cards.forEach((card) => {
              card.hidden = filter !== "All" && card.dataset.hubTag !== filter;
            });
          });
        });
      });
  }
  document.addEventListener("astro:page-load", initHubFilters);
</script>
