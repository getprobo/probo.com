---
import Layout from "../../layouts/Layout.astro";
import FrameworkBadge from "../../components/FrameworkBadge.svelte";
import Icon from "../../components/Icon.astro";
import { Image } from "astro:assets";
import ProboLogo from "../../assets/probo-logo.svg";
import ProboLogoOnly from "../../assets/probo-logo-only.svg";
import ProboWhiteLogo from "../../assets/probo_white_logo.svg";
import CompliancePortalExample from "../../assets/compliance-portal-example.png";

const steps = [
  {
    id: "compliance-portal",
    title: "Check your compliance portal",
    text: "Your report, shared under NDA in one click.",
  },
  {
    id: "portal-update",
    title: "Send a portal update",
    text: "Notify customers and prospects by email.",
  },
  {
    id: "guidelines",
    title: "Use the right wording",
    text: "What you can and can't claim.",
  },
  {
    id: "linkedin-post",
    title: "Announce it on LinkedIn",
    text: "A ready-to-post draft and visual.",
  },
  {
    id: "blog-article",
    title: "Write a blog article",
    text: "A page that gives the report context.",
  },
  {
    id: "assets",
    title: "Add the badge to your website",
    text: "Badges, AICPA logo rules and placement.",
  },
  {
    id: "business-growth",
    title: "Brief sales and customers",
    text: "Turn the report into deals and renewals.",
  },
  {
    id: "keep-valid",
    title: "Keep it current",
    text: "Annual Type II reports and bridge letters.",
  },
] as const;

const toc = [
  { id: "compliance-portal", label: "Compliance portal" },
  { id: "portal-update", label: "Portal update" },
  {
    id: "guidelines",
    label: "Communication guidelines",
    children: [
      { id: "achievement", label: "Achievement" },
      { id: "value-for-customers", label: "Value for customers" },
      { id: "access-to-report", label: "Access to the report" },
    ],
  },
  { id: "linkedin-post", label: "LinkedIn post" },
  { id: "blog-article", label: "Blog article" },
  {
    id: "assets",
    label: "Website assets",
    children: [
      { id: "compliance-badges", label: "Badges & logo" },
      { id: "aicpa-soc-logo", label: "AICPA SOC logo" },
      { id: "website-placement", label: "Placement" },
    ],
  },
  { id: "business-growth", label: "Business growth" },
  { id: "keep-valid", label: "Keep it current" },
];

const guidelines = [
  {
    id: "achievement",
    title: "Achievement",
    say: [
      "We successfully completed a SOC 2 Type I / Type II audit.",
      "Our SOC 2 Type II report, issued by [CPA firm], covers [period].",
      "Our SOC 2 report was conducted by an independent third-party auditor.",
      "This audit confirms that our controls related to security, availability, processing integrity, confidentiality, and/or privacy meet the standards defined by the AICPA.",
    ],
    avoid: [
      {
        quote: "We are SOC 2 certified.",
        why: "SOC 2 is not a certification, it is an attestation report.",
      },
      {
        quote: "We cover all Trust Services Criteria.",
        why: "Only mention the criteria included in your audit.",
      },
      {
        quote: "We are SOC 2 audited by Probo.",
        why: "Probo prepares you for the audit. The report is issued by an independent CPA firm, so name them instead.",
      },
    ],
  },
  {
    id: "value-for-customers",
    title: "Value for customers",
    say: [
      "Customers can rely on our strong security processes and operational maturity.",
      "The SOC 2 report helps customers evaluate how we protect their data.",
      "This milestone reflects our continued investment in security and compliance.",
    ],
    avoid: [
      {
        quote: "We passed SOC 2, so your data is 100% safe.",
        why: "SOC 2 validates controls, it does not guarantee absolute security.",
      },
      {
        quote: "We are SOC 2 compliant forever.",
        why: "A SOC 2 Type II report covers a past period. Controls must keep operating and be audited again every year.",
      },
    ],
  },
  {
    id: "access-to-report",
    title: "Access to the report",
    say: [
      "Our SOC 2 report is available to customers and prospects under NDA.",
      "Request our SOC 2 report from our compliance portal.",
    ],
    avoid: [
      {
        quote: "Publishing the full report on your website.",
        why: "A SOC 2 report is a restricted-use document. Share it under NDA only.",
      },
      {
        quote: "Sharing details of exceptions or remediations publicly.",
        why: "Discuss exceptions one to one with the customer who asks, with the report in hand.",
      },
    ],
  },
];

const soc2Badges = [
  { label: "SOC 2 Type I", badge: "SOC2_TYPE1" },
  { label: "SOC 2 Type II", badge: "SOC2_TYPE2" },
];

const placements = [
  "Homepage, next to your customer logos",
  "Footer",
  "Security / Trust page",
  "Pricing or Enterprise page",
  "Signup pages",
];

const teamQuestions = [
  "What does SOC 2 actually mean?",
  "Is this Type I or Type II?",
  "Can you share the report?",
  "How does this protect my data?",
];

const reportCycle = [
  {
    when: "Type I",
    title: "Point in time",
    text: "Confirms your controls are designed correctly on a given date. A good first step, but most enterprise buyers ask for Type II.",
  },
  {
    when: "Type II",
    title: "Observation period",
    text: "Tests that your controls operated effectively over 3 to 12 months. Your first Type II starts right after Type I.",
  },
  {
    when: "Every year",
    title: "New Type II report",
    text: "Each report covers the previous period. Buyers expect a report whose period ended within the last 12 months.",
  },
];

const operatingRoutine = [
  "Access reviews",
  "Risk assessment review",
  "Policy reviews and employee signatures",
  "Security awareness training",
  "Vendor reviews",
  "Evidence collected for every control",
];

const customerChannels = [
  "Email",
  "Customer newsletter",
  "In-app notifications",
];
---

<Layout
  title="SOC 2 - What's Next"
  description="SOC 2 communication kit: how to share your SOC 2 report with customers and prospects, what you can and can't say, and how to turn it into growth."
  noFrameworks={true}
>
  <!-- Hero -->
  <section
    class="container grid max-w-[1180px] grid-cols-1 items-center gap-12 pt-16 pb-16 sm:pt-24 lg:grid-cols-[minmax(0,1fr)_400px] lg:gap-16"
  >
    <div>
      <p
        class="text-muted-foreground mb-5 flex items-center gap-2 text-sm font-medium"
      >
        <Icon name="seal-check" size={16} class="text-success" />
        SOC 2 communication kit
      </p>
      <h1
        class="sm:text-h2 mb-6 max-w-[620px] text-[2.5rem] leading-none font-semibold tracking-[-1.4px] text-balance"
      >
        Turn your SOC 2 report into a trust asset
      </h1>
      <p class="text-muted-foreground mb-8 max-w-[560px] text-lg">
        Congratulations on completing your SOC 2 audit! This is a major
        milestone worth celebrating. Now is the time to share it with your
        customers, prospects, and stakeholders.
      </p>
      <div class="flex flex-wrap gap-3">
        <a
          href="#compliance-portal"
          class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex items-center gap-2 rounded-md px-4 py-2 text-sm transition-colors"
        >
          Start with step 1
          <Icon name="arrow-right" size={14} />
        </a>
        <a
          href="#compliance-badges"
          class="border-border-low bg-level-1 hover:bg-subtle inline-flex items-center gap-2 rounded-md border px-4 py-2 text-sm transition-colors"
        >
          <Icon name="download-simple" size={14} />
          Get the badge
        </a>
      </div>
    </div>

    <div class="hero-card relative">
      <div
        class="bg-level-1 border-border-low relative rounded-2xl border p-6 shadow-sm"
      >
        <div class="mb-6 flex items-start justify-between">
          <div
            class="bg-subtle flex size-16 items-center justify-center rounded-xl"
          >
            <FrameworkBadge
              name="SOC2_TYPE2"
              class="block size-11 mix-blend-multiply"
              client:visible
            />
          </div>
          <span
            class="bg-active text-success inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium"
          >
            <Icon name="check" size={12} />
            Report issued
          </span>
        </div>
        <p class="mb-1 text-lg font-medium">SOC 2 Type II</p>
        <p class="text-muted-foreground mb-6 text-sm">
          AICPA Trust Services Criteria
        </p>
        <dl
          class="border-border-low divide-border-low divide-y border-t text-sm"
        >
          <div class="flex justify-between gap-4 py-3">
            <dt class="text-muted-foreground">Issued by</dt>
            <dd>Your CPA firm</dd>
          </div>
          <div class="flex justify-between gap-4 py-3">
            <dt class="text-muted-foreground">Shared</dt>
            <dd>Under NDA</dd>
          </div>
          <div class="flex justify-between gap-4 pt-3">
            <dt class="text-muted-foreground">Renewed</dt>
            <dd>Every year</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Next steps overview -->
  <section class="container max-w-[1180px] pb-16 sm:pb-24">
    <h2 class="text-muted-foreground mb-4 text-sm font-medium">
      Your next steps
    </h2>
    <ol class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((step, i) => (
          <li>
            <a
              href={`#${step.id}`}
              class="bg-level-1 border-border-low hover:border-border-mid group flex h-full items-start gap-4 rounded-xl border p-5 transition-colors"
            >
              <span class="bg-foreground text-primary-foreground flex size-7 shrink-0 items-center justify-center rounded-full text-xs font-medium">
                {i + 1}
              </span>
              <span class="flex-1">
                <span class="block font-medium">{step.title}</span>
                <span class="text-muted-foreground block text-sm">
                  {step.text}
                </span>
              </span>
              <Icon
                name="arrow-right"
                size={16}
                class="text-muted-foreground mt-1 transition-transform group-hover:translate-x-0.5"
              />
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <div
    class="container grid max-w-[1180px] grid-cols-1 gap-16 pb-24 lg:grid-cols-[200px_minmax(0,1fr)]"
  >
    <!-- Table of contents -->
    <aside class="hidden lg:block">
      <nav class="sticky top-28 space-y-3 text-sm" aria-label="On this page">
        <p class="text-muted-foreground text-xs font-medium">On this page</p>
        <ul class="space-y-2">
          {
            toc.map((item) => (
              <li>
                <a
                  href={`#${item.id}`}
                  class="toc-link text-muted-foreground hover:text-foreground transition-colors"
                >
                  {item.label}
                </a>
                {item.children && (
                  <ul class="border-border-low mt-2 ml-1 space-y-2 border-l pl-3">
                    {item.children.map((child) => (
                      <li>
                        <a
                          href={`#${child.id}`}
                          class="toc-link text-muted-foreground hover:text-foreground transition-colors"
                        >
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ul>
      </nav>
    </aside>

    <main class="max-w-[780px] min-w-0 space-y-24">
      <!-- 1. Compliance portal -->
      <section id="compliance-portal" data-section>
        <p class="text-muted-foreground mb-2 text-sm font-medium">Step 1</p>
        <h2 class="text-h3 mb-4 font-semibold">Check your compliance portal</h2>
        <p class="text-muted-foreground mb-8 text-lg">
          Your compliance portal is the first place prospects and security
          reviewers will look. The Probo team makes sure your SOC 2 report is
          added to it, behind an NDA, so prospects can request it without an
          email thread.
        </p>
        <div
          class="bg-level-1 border-border-low overflow-hidden rounded-2xl border"
        >
          <div class="bg-subtle border-border-low border-b p-4 sm:p-6">
            <Image
              src={CompliancePortalExample}
              alt="Example of a Probo compliance portal"
              class="border-border-low w-full rounded-lg border"
            />
          </div>
          <div
            class="flex flex-col items-start justify-between gap-4 p-5 sm:flex-row sm:items-center"
          >
            <p class="text-muted-foreground">
              Use your portal link in sales emails, security questionnaires and
              your website footer.
            </p>
            <a
              href="https://compliance.probo.com/overview"
              target="_blank"
              rel="noopener noreferrer"
              class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex shrink-0 items-center gap-2 rounded-md px-4 py-2 text-sm transition-colors"
            >
              See an example
              <Icon name="arrow-right" size={14} />
            </a>
          </div>
        </div>
      </section>

      <!-- 2. Portal update -->
      <section id="portal-update" data-section>
        <p class="text-muted-foreground mb-2 text-sm font-medium">Step 2</p>
        <h2 class="text-h3 mb-4 font-semibold">Send a portal update</h2>
        <p class="text-muted-foreground mb-8 text-lg">
          Your compliance portal can email an update to everyone subscribed to
          it. It is the most direct way to tell customers and prospects about
          your SOC 2 report, and the update stays visible in the portal's news
          feed.
        </p>

        <ol class="mb-6 grid grid-cols-1 gap-4 md:grid-cols-3">
          <li class="bg-level-1 border-border-low rounded-xl border p-5">
            <span
              class="bg-foreground text-primary-foreground mb-4 flex size-7 items-center justify-center rounded-full text-xs font-medium"
              >1</span
            >
            <p class="mb-2 font-medium">Add your subscribers first</p>
            <p class="text-muted-foreground text-sm">
              Add your customers' security contacts and the prospects currently
              in a security review. Do it in <strong>Updates</strong> →
              <strong>Subscribers</strong>, or ask your AI assistant to add them
              in bulk through the <a
                href="/docs/developers/api/mcp/tools/catalog/compliance-portal"
                class="underline">Probo MCP</a
              >.
            </p>
          </li>
          <li class="bg-level-1 border-border-low rounded-xl border p-5">
            <span
              class="bg-foreground text-primary-foreground mb-4 flex size-7 items-center justify-center rounded-full text-xs font-medium"
              >2</span
            >
            <p class="mb-2 font-medium">Wait for confirmations</p>
            <p class="text-muted-foreground text-sm">
              Each subscriber receives an email to confirm their subscription.
              Only confirmed subscribers receive updates, so give them a few
              days before you send.
            </p>
          </li>
          <li class="bg-level-1 border-border-low rounded-xl border p-5">
            <span
              class="bg-foreground text-primary-foreground mb-4 flex size-7 items-center justify-center rounded-full text-xs font-medium"
              >3</span
            >
            <p class="mb-2 font-medium">Create and send the update</p>
            <p class="text-muted-foreground text-sm">
              In <strong>Updates</strong>, select <strong>Add update</strong>,
              paste the template below, review it, then select
              <strong>Send</strong>. A sent update can't be edited.
            </p>
          </li>
        </ol>

        <p class="text-muted-foreground mb-6 text-sm">
          Only add people you have an appropriate basis to contact, such as
          existing customers and prospects you are in touch with. <a
            href="/docs/product/compliance-portal/updates-and-mailing-list"
            class="underline">Read the updates documentation</a
          >.
        </p>

        <div class="bg-level-1 border-border-low rounded-2xl border">
          <div
            class="border-border-low flex items-center justify-between border-b px-5 py-3"
          >
            <span class="flex items-center gap-2 text-sm font-medium">
              <Icon name="megaphone" size={18} class="text-muted-foreground" />
              Portal update
            </span>
            <button
              class="copy-btn border-border-low hover:bg-subtle inline-flex items-center gap-1.5 rounded-md border px-2.5 py-1 text-sm transition-colors"
              data-target="update-content"
              type="button"
            >
              <Icon name="copy" size={14} />
              <span class="copy-label">Copy</span>
            </button>
          </div>
          <div id="update-content" class="space-y-4 p-5 sm:p-6">
            <p class="font-medium">Our SOC 2 Type II report is now available</p>
            <p class="text-muted-foreground">
              We're pleased to share that [Company Name] has completed its SOC 2
              Type II audit, the AICPA standard for how service providers
              protect customer data.
            </p>
            <p class="text-muted-foreground">
              The report was issued by [CPA firm] and covers the [Security,
              Availability, Confidentiality] Trust Services Criteria over the
              period [start date] to [end date].
            </p>
            <p class="text-muted-foreground">
              You can request the full report from this compliance portal. If
              you have a security review or questionnaire in progress with us,
              you can now reference it directly.
            </p>
            <p class="text-muted-foreground">
              For any question, reply to this email and our security team will
              get back to you.
            </p>
          </div>
        </div>
      </section>

      <!-- 3. Communication guidelines -->
      <section id="guidelines" data-section>
        <p class="text-muted-foreground mb-2 text-sm font-medium">Step 3</p>
        <h2 class="text-h3 mb-4 font-semibold">Use the right wording</h2>
        <p class="text-muted-foreground mb-8 text-lg">
          Accurate claims build more trust than big ones. Security reviewers
          read your report and will check what you say against it.
        </p>

        <div
          class="mb-10 rounded-r-lg border-l-[3px] border-[#ef4444] bg-[#fef2f2] p-4"
        >
          <p class="font-medium text-[#7f1d1d]">Never say "SOC 2 certified"</p>
          <p class="mt-1 text-sm text-[#991b1b]">
            SOC 2 is an attestation report issued by a CPA firm, not a
            certification. Say "SOC 2 Type II audited" or "we have a SOC 2 Type
            II report" instead.
          </p>
        </div>

        <div class="space-y-10">
          {
            guidelines.map((group) => (
              <div id={group.id} data-section>
                <h3 class="text-h5 mb-4 font-medium">{group.title}</h3>
                <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                  <div class="bg-level-1 border-border-low rounded-xl border p-5">
                    <p class="text-success mb-4 flex items-center gap-2 text-sm font-medium">
                      <span class="bg-active flex size-6 items-center justify-center rounded-full">
                        <Icon name="check" size={14} />
                      </span>
                      What you can say
                    </p>
                    <ul class="space-y-3">
                      {group.say.map((quote) => (
                        <li class="text-foreground">"{quote}"</li>
                      ))}
                    </ul>
                  </div>
                  <div class="bg-level-1 border-border-low rounded-xl border p-5">
                    <p class="mb-4 flex items-center gap-2 text-sm font-medium text-[#b91c1c]">
                      <span class="flex size-6 items-center justify-center rounded-full bg-[#fef2f2]">
                        <Icon name="x" size={14} />
                      </span>
                      What to avoid
                    </p>
                    <ul class="space-y-4">
                      {group.avoid.map((item) => (
                        <li>
                          <p class="text-muted-foreground line-through decoration-[#fca5a5]">
                            "{item.quote}"
                          </p>
                          <p class="mt-1 text-sm">{item.why}</p>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- 4. LinkedIn post -->
      <section id="linkedin-post" data-section>
        <p class="text-muted-foreground mb-2 text-sm font-medium">Step 4</p>
        <h2 class="text-h3 mb-4 font-semibold">Announce it on LinkedIn</h2>
        <p class="text-muted-foreground mb-8 text-lg">
          Start with a post on your company page to inform customers and
          prospects. Tag Probo and we will be glad to share it. Here is an
          example you can use.
        </p>

        <div class="bg-level-1 border-border-low rounded-2xl border">
          <div
            class="border-border-low flex items-center justify-between border-b px-5 py-3"
          >
            <span class="flex items-center gap-2 text-sm font-medium">
              <Icon name="linkedin-logo" size={18} class="text-[#0A66C2]" />
              LinkedIn post
            </span>
            <button
              class="copy-btn border-border-low hover:bg-subtle inline-flex items-center gap-1.5 rounded-md border px-2.5 py-1 text-sm transition-colors"
              data-target="linkedin-content"
              type="button"
            >
              <Icon name="copy" size={14} />
              <span class="copy-label">Copy</span>
            </button>
          </div>
          <div id="linkedin-content" class="space-y-4 p-5 sm:p-6">
            <p class="font-medium">
              Big announcement: [Company Name] has completed its SOC 2 Type II
              audit! 🔒
            </p>
            <p class="text-muted-foreground">
              I'm excited to share that [Company Name] has received its SOC 2
              Type II report, an important step in our commitment to the highest
              standards of security, reliability, and trust for our customers.
            </p>
            <p class="text-muted-foreground">
              A big thank you to <strong>@Probo</strong>, whose platform and
              team made the entire SOC 2 journey significantly smoother.
            </p>
            <div>
              <p class="text-muted-foreground mb-2">
                What this means for our customers:
              </p>
              <ul class="text-muted-foreground list-inside list-disc space-y-1">
                <li>Increased trust and transparency</li>
                <li>Stronger data protection</li>
                <li>Faster security reviews</li>
              </ul>
            </div>
            <p class="text-muted-foreground">
              Proud of what the team has accomplished, and excited for what this
              unlocks next.
            </p>
          </div>
        </div>

        <div
          class="bg-level-1 border-border-low mt-6 grid grid-cols-1 items-center gap-6 rounded-2xl border p-5 sm:grid-cols-[minmax(0,1fr)_auto] sm:p-6"
        >
          <img
            src="/linkedin-template-soc2.png"
            alt="LinkedIn post template for SOC 2 announcement"
            class="border-border-low w-full rounded-lg border"
            loading="lazy"
          />
          <div class="sm:w-48">
            <p class="mb-1 font-medium">LinkedIn visual</p>
            <p class="text-muted-foreground mb-4 text-sm">
              Download and customize this template to support your post.
            </p>
            <a
              href="/linkedin-template-soc2.png"
              download="linkedin-template-soc2.png"
              class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex items-center gap-2 rounded-md px-4 py-2 text-sm transition-colors"
            >
              <Icon name="download-simple" size={16} />
              Download PNG
            </a>
          </div>
        </div>
      </section>

      <!-- 5. Blog article -->
      <section id="blog-article" data-section>
        <p class="text-muted-foreground mb-2 text-sm font-medium">Step 5</p>
        <h2 class="text-h3 mb-4 font-semibold">Write a blog article</h2>
        <p class="text-muted-foreground mb-8 text-lg">
          Create a page about your SOC 2 report to give context to your
          customers and prospects. You can also link the SOC 2 badge on your
          website to this page.
        </p>

        <div class="bg-level-1 border-border-low rounded-2xl border">
          <div
            class="border-border-low flex items-center justify-between border-b px-5 py-3"
          >
            <span class="flex items-center gap-2 text-sm font-medium">
              <Icon name="article" size={18} class="text-muted-foreground" />
              Blog article
            </span>
            <button
              class="copy-btn border-border-low hover:bg-subtle inline-flex items-center gap-1.5 rounded-md border px-2.5 py-1 text-sm transition-colors"
              data-target="blog-content"
              type="button"
            >
              <Icon name="copy" size={14} />
              <span class="copy-label">Copy</span>
            </button>
          </div>
          <div id="blog-content" class="space-y-4 p-5 sm:p-6">
            <h3 class="text-h4 font-semibold">
