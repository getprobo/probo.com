    "check:assets": "node tools/optimize-assets.mjs --check",
    "format": "node tools/format-changed.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
