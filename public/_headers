# Security headers - applied to every response
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://t.probo.com https://tally.so; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://www.google.com; connect-src 'self' https://*.probo.com https://api.github.com https://api.openstatus.dev; frame-src https://tally.so https://www.youtube.com https://lists.probo.com https://n8n-preview-service.internal.n8n.cloud; form-action 'self' https://lists.probo.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000

# HTML files - always revalidate to get fresh chunk references
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Root path and directories
/
  Cache-Control: public, max-age=0, must-revalidate

# Static assets with content hashes - cache forever (immutable)
/_astro/*.js
  Cache-Control: public, max-age=31536000, immutable

/_astro/*.css
  Cache-Control: public, max-age=31536000, immutable

/_astro/*.woff
  Cache-Control: public, max-age=31536000, immutable

/_astro/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/_astro/*.webp
  Cache-Control: public, max-age=31536000, immutable

/_astro/*.png
  Cache-Control: public, max-age=31536000, immutable

/_astro/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/_astro/*.jpeg
  Cache-Control: public, max-age=31536000, immutable

/_astro/*.svg
  Cache-Control: public, max-age=31536000, immutable

# Vendored third-party scripts - version-pinned in the filename
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Stable media collections - cache for one month
/clients/*
  Cache-Control: public, max-age=2592000

/navigation/*
  Cache-Control: public, max-age=2592000

/frameworks/*
  Cache-Control: public, max-age=2592000

/stories/*
  Cache-Control: public, max-age=2592000

/videos/*
  Cache-Control: public, max-age=2592000

/changelog/*
  Cache-Control: public, max-age=2592000

# Images and other static assets in /public - cache for 1 week (no immutable, no content hash)
/*.webp
  Cache-Control: public, max-age=604800

/*.png
  Cache-Control: public, max-age=604800

/*.jpg
  Cache-Control: public, max-age=604800

/*.jpeg
  Cache-Control: public, max-age=604800

/*.svg
  Cache-Control: public, max-age=604800

/*.ico
  Cache-Control: public, max-age=604800

# Manifest and other root files
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400, must-revalidate

/ip-ranges.json
  Cache-Control: public, max-age=3600, must-revalidate

/*.json
  Cache-Control: public, max-age=3600

/*.xml
  Cache-Control: public, max-age=3600
